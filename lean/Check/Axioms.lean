import RationalQuivers

/-!
# Axiom check for the claimed declarations

GENERATED by `export-public.sh` from `correspondence/LABEL-DECL.tsv`; do not edit.

For every labelled statement of the manuscript that has a Lean claimant, this file checks that

* the claimant exists in the environment of `RationalQuivers`, and
* every axiom in its dependency closure is one of `propext`, `Classical.choice`, `Quot.sound`.

A violation (an unknown name, `sorryAx`, `Lean.ofReduceBool` from `native_decide`, or any other axiom)
is an elaboration error, so `lake build Check` fails. On success each line logs the axioms used.
-/

open Lean Elab Command

/-- `#check_std_axioms n` fails unless the declaration `n` exists and depends on no axiom outside
`propext`, `Classical.choice`, `Quot.sound`. -/
elab "#check_std_axioms " id:ident : command => do
  let n := id.getId
  unless (← getEnv).contains n do
    throwError "unknown declaration {n}"
  let axs ← collectAxioms n
  let allowed := [``propext, ``Classical.choice, ``Quot.sound]
  let bad := axs.filter (fun a => !allowed.contains a)
  unless bad.isEmpty do
    throwError "{n} depends on non-standard axioms {bad.toList}"
  let sorted := (axs.map toString).qsort (· < ·)
  logInfo m!"{n}: {sorted.toList}"

