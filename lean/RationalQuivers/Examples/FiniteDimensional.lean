import RationalQuivers.Examples.Basic

/-!
# §6.1 — the finite-dimensional representations `F_ℓ`

Formalizes §6.1 of `latex/rational_quivers.tex` (census `RQ2-6.01`).

## Main definitions / results
* `RationalQuivers.Examples.F` — the object `F_ℓ ∈ HC_{ℓ²}(𝔤,K)_ℚ`, `ℓ ≥ 1`: the `ℓ`-dimensional
  irreducible representation of `SL₂`, as a term of `HC ℓ ℚ ImagUnit.qi`.
* `RationalQuivers.Examples.F_casimir` — `C` acts by `λ = ℓ²`.
* `RationalQuivers.Examples.F_irreducible` — `F_ℓ` is `ℓ`-dimensional and irreducible.
* `RationalQuivers.Examples.F_weightSpaces` — the `K`-type claims.
* `RationalQuivers.Examples.F_quiverRep_eq` — the displayed `ℚ`-rational Gelfand-quiver diagram.
* `RationalQuivers.Examples.F_speciesRep_eq` — the displayed étale `ℚ`-species representation.

## Implementation notes

`F_ℓ` is `Examples/Basic.lean`'s weight-line module at

* support `S = {n : |n| ≤ ℓ - 1, n ≡ ℓ - 1 (mod 2)}` — the paper's "the non-trivial `K`-types are
  one-dimensional and occur at weights `±(ℓ-1)`", read as the whole `𝔰𝔩₂`-string;
* raising scalar `x(n) = (ℓ - n - 1)/2`, which vanishes exactly at `n = ℓ - 1` (so `X` kills the
  highest weight vector) and whose mirror `x(-n) = (ℓ + n - 1)/2` vanishes exactly at `n = 1 - ℓ`
  (so `Y` kills the lowest one) — the two walls `§6.1` names.

The normalization is not free: `Basic.lean`'s `WtCas` forces `x(n-2)·x(-n) = (ℓ² - (n-1)²)/4`, and
the `§6.1` walls force the two vanishings; `x(n) = (ℓ - n - 1)/2` is the (unique up to the
`c`-compatibility `y(n) = x(-n)`) rational solution.

**What is carried by the type rather than by a theorem.**  Clause `RQ2-6.01-C2` ("`F_ℓ` is defined
over `ℚ`") is the *type* `HC ℓ ℚ ImagUnit.qi` (`def:HClambdaE`), whose `form`/`baseChange`/`galCompat` fields carry
the `ℚ`-form and the descent datum (`HC/Category.lean`); there is no weaker object of that type
without a `ℚ`-form, so `C2` cannot be dropped by any later edit.  Clause `RQ2-6.01-H1`'s `ℓ ≥ 1` is
the explicit argument `hℓ` (`CONVENTIONS.md` §3: a paper hypothesis is an explicit argument).
-/

namespace RationalQuivers.Examples

open RationalQuivers.HC RationalQuivers.Gelfand CategoryTheory
open RationalQuivers.Gelfand.RationalStructure (gelfandQ vtxQ edgeQ RepNilQ)
open RationalQuivers.Gelfand.Cyclic (cyclicQ vtxC edgeC RepNilCycQ)

/-! ## The datum -/

/-- The weights of `F_ℓ`: `|n| ≤ ℓ - 1` with `n ≡ ℓ - 1 (mod 2)`.  @census none (helper) -/
abbrev suppF (ℓ : ℕ) (n : ℤ) : Prop :=
  -((ℓ : ℤ) - 1) ≤ n ∧ n ≤ (ℓ : ℤ) - 1 ∧ (n - ((ℓ : ℤ) - 1)) % 2 = 0

/-- The raising scalar of `F_ℓ`: `X · e_n = ((ℓ - n - 1)/2) · e_{n+2}`.  @census none (helper) -/
def scalF (ℓ : ℕ) (n : ℤ) : ℚ := ((ℓ : ℚ) - (n : ℚ) - 1) / 2

theorem scalF_apply (ℓ : ℕ) (n : ℤ) : scalF ℓ n = ((ℓ : ℚ) - (n : ℚ) - 1) / 2 := rfl

/-- `XY` on `M_n` is the scalar `(ℓ² - (n-1)²)/4` — including at the lower wall, where the
composite is deleted and the scalar is `0`.  @census none (helper) -/
theorem scalF_XY (ℓ : ℕ) (n : ℤ) (hn : suppF ℓ n) :
    (if suppF ℓ (n - 2) then scalF ℓ (n - 2) * scalF ℓ (-n) else 0)
      = ((ℓ : ℚ) ^ 2 - ((n : ℚ) - 1) ^ 2) / 4 := by
  by_cases h : suppF ℓ (n - 2)
  · rw [if_pos h, scalF_apply, scalF_apply]
    push_cast
    ring
  · rw [if_neg h]
    obtain ⟨h1, h2, h3⟩ := hn
    have hval : n = 1 - (ℓ : ℤ) := by
      simp only [suppF, not_and, not_le] at h
      omega
    have hq : (n : ℚ) = 1 - (ℓ : ℚ) := by exact_mod_cast congrArg (fun z : ℤ => (z : ℚ)) hval
    rw [hq]; ring

/-- `YX` on `M_n` is the scalar `(ℓ² - (n+1)²)/4` — including at the upper wall.
@census none (helper) -/
theorem scalF_YX (ℓ : ℕ) (n : ℤ) (hn : suppF ℓ n) :
    (if suppF ℓ (n + 2) then scalF ℓ (-(n + 2)) * scalF ℓ n else 0)
      = ((ℓ : ℚ) ^ 2 - ((n : ℚ) + 1) ^ 2) / 4 := by
  by_cases h : suppF ℓ (n + 2)
  · rw [if_pos h, scalF_apply, scalF_apply]
    push_cast
    ring
  · rw [if_neg h]
    obtain ⟨h1, h2, h3⟩ := hn
    have hval : n = (ℓ : ℤ) - 1 := by
      simp only [suppF, not_and, not_le] at h
      omega
    have hq : (n : ℚ) = (ℓ : ℚ) - 1 := by exact_mod_cast congrArg (fun z : ℤ => (z : ℚ)) hval
    rw [hq]; ring

theorem F_sl2 (ℓ : ℕ) : WtSl2 (suppF ℓ) (scalF ℓ) := by
  intro n hn
  rw [scalF_XY ℓ n hn, scalF_YX ℓ n hn]
  ring

theorem F_cas (ℓ : ℕ) : WtCas ℓ (suppF ℓ) (scalF ℓ) := by
  intro n hn
  rw [scalF_XY ℓ n hn]
  ring

theorem F_symm (ℓ : ℕ) : WtSymm (suppF ℓ) := by
  rintro n ⟨h1, h2, h3⟩
  exact ⟨by omega, by omega, by omega⟩

theorem F_par (ℓ : ℕ) : WtPar ℓ (suppF ℓ) := fun _ h => h.2.2

/-! ## Finite generation: `F_ℓ` is generated by its highest weight vector -/

/-- **From the highest weight vector, every basis vector is reachable** inside a `(𝔤,K)`-stable
submodule: `Y` descends the whole string, and its scalar `x(-n) = (ℓ+n-1)/2` vanishes only at the
lower wall.  This is `F_fg`'s argument, named so that `F_irreducible` can reuse it.
@census none (helper) -/
theorem F_top_of_highest (ℓ : ℕ) {N : Submodule (Qi : Type) (WtCar (suppF ℓ))}
    (hop : (wtWeight (suppF ℓ) (scalF ℓ) (F_sl2 ℓ)).OpStable N)
    (hb : suppF ℓ ((ℓ : ℤ) - 1))
    (hgen : Finsupp.single (⟨(ℓ : ℤ) - 1, hb⟩ : WtIdx (suppF ℓ)) (1 : (Qi : Type)) ∈ N)
    (i : WtIdx (suppF ℓ)) : Finsupp.single i (1 : (Qi : Type)) ∈ N := by
  obtain ⟨h1, h2, h3⟩ := i.2
  set k : ℕ := ((((ℓ : ℤ) - 1) - (i : ℤ)) / 2).toNat with hkdef
  have hkval : ((ℓ : ℤ) - 1) - 2 * (k : ℤ) = (i : ℤ) := by
    simp only [hkdef]; omega
  have hkle : (k : ℤ) ≤ (ℓ : ℤ) - 1 := by simp only [hkdef]; omega
  have hS : ∀ j : ℕ, j ≤ k → suppF ℓ (((ℓ : ℤ) - 1) - 2 * (j : ℤ)) := by
    intro j hj
    have hjk : (j : ℤ) ≤ (k : ℤ) := by exact_mod_cast hj
    exact ⟨by omega, by omega, by omega⟩
  have hx : ∀ j : ℕ, j < k → scalF ℓ (-(((ℓ : ℤ) - 1) - 2 * (j : ℤ))) ≠ 0 := by
    intro j hj
    have hjk : (j : ℤ) < (k : ℤ) := by exact_mod_cast hj
    have hjq : (j : ℚ) < (ℓ : ℚ) - 1 := by
      have : (j : ℤ) < (ℓ : ℤ) - 1 := by omega
      exact_mod_cast this
    simp only [scalF_apply]
    push_cast
    intro hcon
    have : (ℓ : ℚ) - 1 - (j : ℚ) = 0 := by linarith [hcon]
    linarith
  have hmem := wtChainDown (F_sl2 ℓ) hop ((ℓ : ℤ) - 1) hb hgen k hx hS
  have hidx : (⟨((ℓ : ℤ) - 1) - 2 * (k : ℤ), hS k le_rfl⟩ : WtIdx (suppF ℓ)) = i :=
    Subtype.ext hkval
  rwa [hidx] at hmem

theorem F_fg (ℓ : ℕ) (hℓ : 1 ≤ ℓ) : (wtWeight (suppF ℓ) (scalF ℓ) (F_sl2 ℓ)).IsFG := by
  have hb : suppF ℓ ((ℓ : ℤ) - 1) := ⟨by omega, by omega, by omega⟩
  refine wtIsFG (F_sl2 ℓ) (wtGen (⟨(ℓ : ℤ) - 1, hb⟩ : WtIdx (suppF ℓ))) ?_
  intro N hN hop hhom i
  exact F_top_of_highest ℓ hop hb (wtGen_subset hN) i

/-- **`F_ℓ` has exactly `ℓ` weights**: `n = (ℓ-1) - 2k` for `k < ℓ`.  @census none (helper) -/
def suppFEquiv (ℓ : ℕ) : WtIdx (suppF ℓ) ≃ Fin ℓ where
  toFun i := ⟨(((ℓ : ℤ) - 1 - (i : ℤ)) / 2).toNat, by obtain ⟨h1, h2, h3⟩ := i.2; omega⟩
  invFun k := ⟨(ℓ : ℤ) - 1 - 2 * ((k : ℕ) : ℤ), by
    have hk := k.isLt
    exact ⟨by omega, by omega, by omega⟩⟩
  left_inv i := by
    obtain ⟨n, h1, h2, h3⟩ := i
    apply Subtype.ext
    simp only
    omega
  right_inv k := by
    have hk := k.isLt
    apply Fin.ext
    simp only
    omega

/-! ## The object -/

/-- **`F_ℓ`** (`§6.1`): the irreducible `ℓ`-dimensional representation of `SL₂`, as an object of
the concrete `HC_{ℓ²}(𝔤,K)_ℚ` (`HC ℓ ℚ ImagUnit.qi`, ruling `R-S8-6` for the v1 presentation).

Its `ℚ[√-1]`-form is `⨁_{|n| ≤ ℓ-1, n ≡ ℓ-1 (2)} ℚ[√-1]·e_n` with `H·e_n = n·e_n`,
`X·e_n = ((ℓ-n-1)/2)·e_{n+2}` and `Y·e_n = ((ℓ+n-1)/2)·e_{n-2}`; its `ℚ`-form is the fixed
space of the conjugation `c·(a·e_n) = c(a)·e_{-n}`, supplied by Galois descent (`RQ-1.13`).

@census    RQ2-6.01
@source    ex:finitedimensional
@clauses   RQ2-6.01-H1, RQ2-6.01-C2
@imports   none
@divergence JUSTIFIED_REFORMULATION (presentation: `HC_λ(𝔤,K)_ℚ` is `HC ℓ ℚ ImagUnit.qi`
(`def:HClambdaE`, `EX-HC`; v2 line, WP-12/T5a), the object built through the `R-V2-3` bridge `HCEObj.toHC`
from the weight-line datum; 𝔼_ℚ is the native `E_E ℚ ImagUnit.qi ℓ` of `thm:EEequivalence`/`thm:cyclicEEequivalence`, re-indexed along `gelfandOfSign = gelfandOfCardTwo` (`EQNat`, `ECycNat`); the engine composite `EQFun`/`ECycFun` is isomorphic to it with identity components (`EQFun_iso_native`, `ECycFun_iso_native`, via `Compat.engineNative(Z)`), and the computations unfold to the engine's data by `rfl`; mathematical content unchanged).  `RQ2-6.01`'s two clauses discharged here are carried **structurally**, not by a
proposition: `H1`'s `ℓ ≥ 1` is the explicit argument `hℓ` (`CONVENTIONS.md` §3), and `C2`'s
"defined over `ℚ`" is the type `HC ℓ ℚ ImagUnit.qi` itself, whose `galCompat` field
is the `ℚ`-form together with its descent datum — there is no term of that type without one.  The
remaining nine clauses are discharged by the `@census none` theorems of this module, which
`rqaudit clauses` credits as same-module helpers of this claimant. -/
noncomputable def F (ℓ : ℕ) (hℓ : 1 ≤ ℓ) : HC ℓ ℚ ImagUnit.qi :=
  wtHC ℓ (suppF ℓ) (scalF ℓ) (F_sl2 ℓ) (F_cas ℓ) (F_symm ℓ) (F_par ℓ) (F_fg ℓ hℓ)

@[simp] theorem F_carrier (ℓ : ℕ) (hℓ : 1 ≤ ℓ) : (F ℓ hℓ).carrier = WtCar (suppF ℓ) := rfl

/-- `c` acts on `F_ℓ` as the coordinatewise conjugation.  @census none (helper) -/
theorem F_galAct (ℓ : ℕ) (hℓ : 1 ≤ ℓ) (w : WtCar (suppF ℓ)) :
    (F ℓ hℓ).galAct galConj w = wtConj (F_symm ℓ) w :=
  wtHC_galAct_galConj ℓ _ _ _ _ _ w

@[simp] theorem F_comp (ℓ : ℕ) (hℓ : 1 ≤ ℓ) (n : ℤ) :
    (F ℓ hℓ).weight.comp n = wtComp (suppF ℓ) n := rfl

/-! ## The statements of `RQ2-6.01` -/

/-- **`RQ2-6.01-C1`** — the Casimir `C` acts on `F_ℓ` as multiplication by `λ = ℓ²`.

Stated in the sharp form the construction supplies: `C` **is** the scalar `ℓ²`, not merely
`C - ℓ²` nilpotent (which is all `HasGeneralizedInfinitesimalCharacter`, `RQ-3.02`, asks).

@census    none (auxiliary; discharges census clause `RQ2-6.01-C1`)
@source    ex:finitedimensional
@clauses   RQ2-6.01-C1
@imports   none
@divergence none -/
theorem F_casimir (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    (F ℓ hℓ).weight.casimir
      = (algebraMap ℚ (Qi : Type) ((ℓ : ℚ) ^ 2))
        • (1 : Module.End (Qi : Type) (F ℓ hℓ).carrier) :=
  wtCasimir_eq ℓ (F_sl2 ℓ) (F_cas ℓ)

/-- **`RQ2-6.01-H1`, the identifying half** — `F_ℓ` is `ℓ`-dimensional over `ℚ[√-1]` and
**irreducible**: its only `(𝔤,K)`-submodules (`WeightData.OpStable` + `WeightData.IsHomog`, S7's
reading of a `(𝔤,K)`-submodule over the split torus, `HC/Graded.lean`) are `⊥` and `⊤`, and
these are distinct.

@census    none (auxiliary; discharges the identifying content of clause `RQ2-6.01-H1`)
@source    ex:finitedimensional
@clauses   RQ2-6.01-H1
@imports   none
@divergence JUSTIFIED_REFORMULATION (the group is not in the tree, disclosed).  The source says
"`F_ℓ` is the irreducible `ℓ`-dimensional representation of `SL₂`"; no stage of this project
formalizes `SL₂` as an algebraic group or its representation category, and S7's `HC_λ(𝔤,K)`
(census `RQ-3.11`) is the `(𝔤,K)`-module category throughout.  "Irreducible representation of
`SL₂`" is therefore rendered as "irreducible `(𝔤,K)`-module", which is the sense in which every
later clause of `RQ2-6.01` uses it (the `K`-type decomposition, `M(±) = 0`, the quiver diagram),
together with the dimension count that pins *which* irreducible it is. -/
theorem F_irreducible (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    Module.finrank (Qi : Type) (F ℓ hℓ).carrier = ℓ ∧
    (⊥ : Submodule (Qi : Type) (F ℓ hℓ).carrier) ≠ ⊤ ∧
    ∀ N : Submodule (Qi : Type) (F ℓ hℓ).carrier,
      (F ℓ hℓ).weight.OpStable N → (F ℓ hℓ).weight.IsHomog N →
        N = ⊥ ∨ N = ⊤ := by
  have hℓz : (1 : ℤ) ≤ (ℓ : ℤ) := by exact_mod_cast hℓ
  have hb : suppF ℓ ((ℓ : ℤ) - 1) := ⟨by omega, by omega, by omega⟩
  refine ⟨wtFinrank_of_equiv (suppFEquiv ℓ), wtBot_ne_top ⟨(ℓ : ℤ) - 1, hb⟩, ?_⟩
  intro N hop hhom
  by_cases hN : N = ⊥
  · exact Or.inl hN
  refine Or.inr ?_
  obtain ⟨i, hi⟩ := wtExists_single_mem (F_sl2 ℓ) hhom hN
  -- climb from `e_i` to the highest weight vector, then descend to every basis vector
  obtain ⟨n, h1, h2, h3⟩ := i
  set k : ℕ := (((ℓ : ℤ) - 1 - n) / 2).toNat with hkdef
  have hkval : n + 2 * (k : ℤ) = (ℓ : ℤ) - 1 := by simp only [hkdef]; omega
  have hS : ∀ j : ℕ, j ≤ k → suppF ℓ (n + 2 * (j : ℤ)) := by
    intro j hj
    have hjk : (j : ℤ) ≤ (k : ℤ) := by exact_mod_cast hj
    exact ⟨by omega, by omega, by omega⟩
  have hx : ∀ j : ℕ, j < k → scalF ℓ (n + 2 * (j : ℤ)) ≠ 0 := by
    intro j hj
    have hjk : (j : ℤ) < (k : ℤ) := by exact_mod_cast hj
    have hlt : n + 2 * (j : ℤ) < (ℓ : ℤ) - 1 := by omega
    have hq : ((n : ℚ) + 2 * (j : ℚ)) < (ℓ : ℚ) - 1 := by exact_mod_cast hlt
    simp only [scalF_apply]
    push_cast
    intro hcon
    have : (ℓ : ℚ) - ((n : ℚ) + 2 * (j : ℚ)) - 1 = 0 := by linarith [hcon]
    linarith
  have htop := wtChainUp (F_sl2 ℓ) hop n ⟨h1, h2, h3⟩ hi k hx hS
  have hidx : (⟨n + 2 * (k : ℤ), hS k le_rfl⟩ : WtIdx (suppF ℓ)) = ⟨(ℓ : ℤ) - 1, hb⟩ :=
    Subtype.ext hkval
  rw [hidx] at htop
  exact wtTop_of_single N (F_top_of_highest ℓ hop hb htop)

/-- **`RQ2-6.01-C3`, `RQ2-6.01-C4`, `RQ2-6.01-C6`** — the `K`-types of `F_ℓ`.

The extreme `K`-types `χ_{±(ℓ-1)}` are one-dimensional (`C3`, partial: see the divergence field);
`F_ℓ[χ_{±(ℓ+1)}] = 0` (`C4`); and `M_{-(ℓ-1)}`, `M_{ℓ-1}` are the lowest and highest weight spaces respectively (`C6`),
stated as: `Y` annihilates `M_{-(ℓ-1)}` and `X` annihilates `M_{ℓ-1}`, and no weight lies outside
`[-(ℓ-1), ℓ-1]`.

@census    none (auxiliary; discharges clauses `RQ2-6.01-C3`, `RQ2-6.01-C4`, `RQ2-6.01-C6`)
@source    ex:finitedimensional
@clauses   RQ2-6.01-C3, RQ2-6.01-C4, RQ2-6.01-C6
@imports   none
@divergence JUSTIFIED_REFORMULATION on `RQ2-6.01-C6` (the weight sign convention, disclosed —
finding `V-S9G2-4`); WEAKENED_OR_PARTIAL on `RQ2-6.01-C3` (**added 2026-10-03**, docstring-only
`R-PROC-4` amendment of frozen S9, coordinator ruling `R-FR-9`, final-release WP-16b, stale item
R11, `MISMATCH-TRIAGE.md` row #4). The amended source (census r18, FA-32) says that **every**
`K`-type `χ_{-(ℓ-1)}, χ_{-(ℓ-3)}, …, χ_{ℓ-1}` of `F_ℓ` is one-dimensional. This theorem states
`finrank = 1` only at `±(ℓ-1)`, which is weaker for `ℓ ≥ 3`. Until this amendment the docstring
paraphrased the withdrawn text, "the non-trivial `K`-types … occur at `±(ℓ-1)`", which is **false**
for `ℓ ≥ 3`. The faithful witness is `RationalQuivers.Examples.F_kTypes_all`
(`Examples/ReleaseAddenda.lean`, final-release WP-16a): every `n` with `suppF ℓ n` has
`finrank = 1`. This theorem keeps its `C3` citation because `rqaudit clauses` binds a clause only to
a claimant of its row or a same-module helper of one, and the WP-16a witness lives in another module.
On `C6`:  `census-v1.8`'s `RQ2-6.01-C6` reads "`M_{-(ℓ-1)}` and `M_{ℓ-1}` are the
highest and lowest weight spaces respectively", transcribing §6.1 as printed.  The two conjuncts
below state instead that **`X` annihilates `M_{ℓ-1}`** and **`Y` annihilates `M_{-(ℓ-1)}`** — the
opposite labelling, and the one forced by §5.1 (`X : M_{-(ℓ+1)} → M_{-(ℓ-1)}`, so `X` raises the
index `n`) together with §3.3's `[H,X] = 2X`.

This is **not** a decision taken here: it is exactly the open item booked by the census adjudicator
at revision r11 as **`AN-44`** (*"Possible global sign-convention wrinkle at `RQ2-6.01-C6`"* —
whether `H` acts on `M[χ_n]` by `+n` or `−n`), **raised and not adjudicated**, awaiting the author
together with `AN-34`.  The statement below is convention-independent in operator form: it names
`X` and `Y` and which weight space each kills, which both readings agree on; only the words
"highest"/"lowest" differ between them.  Resolving the convention is the author's, and nothing here
presumes an outcome. -/
theorem F_weightSpaces (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    Module.finrank ImagUnit.qi.L ((F ℓ hℓ).weight.comp ((ℓ : ℤ) - 1)) = 1 ∧
    Module.finrank ImagUnit.qi.L ((F ℓ hℓ).weight.comp (-((ℓ : ℤ) - 1))) = 1 ∧
    (F ℓ hℓ).weight.comp ((ℓ : ℤ) + 1) = ⊥ ∧
    (F ℓ hℓ).weight.comp (-((ℓ : ℤ) + 1)) = ⊥ ∧
    (∀ n : ℤ, ((ℓ : ℤ) - 1 < n ∨ n < -((ℓ : ℤ) - 1)) → (F ℓ hℓ).weight.comp n = ⊥) ∧
    (∀ v : (F ℓ hℓ).carrier, v ∈ (F ℓ hℓ).weight.comp ((ℓ : ℤ) - 1) →
      (F ℓ hℓ).weight.X v = 0) ∧
    (∀ v : (F ℓ hℓ).carrier, v ∈ (F ℓ hℓ).weight.comp (-((ℓ : ℤ) - 1)) →
      (F ℓ hℓ).weight.Y v = 0) := by
  have hℓz : (1 : ℤ) ≤ (ℓ : ℤ) := by exact_mod_cast hℓ
  have hhi : suppF ℓ ((ℓ : ℤ) - 1) := ⟨by omega, by omega, by omega⟩
  have hlo : suppF ℓ (-((ℓ : ℤ) - 1)) := ⟨by omega, by omega, by omega⟩
  refine ⟨wtComp_finrank hhi, wtComp_finrank hlo, ?_, ?_, ?_, ?_, ?_⟩
  · refine wtComp_eq_bot (S := suppF ℓ) ?_
    rintro ⟨h1, h2, h3⟩; omega
  · refine wtComp_eq_bot (S := suppF ℓ) ?_
    rintro ⟨h1, h2, h3⟩; omega
  · intro n hn
    refine wtComp_eq_bot (S := suppF ℓ) ?_
    rintro ⟨h1, h2, h3⟩
    rcases hn with hn | hn <;> omega
  · intro v hv
    rw [F_comp] at hv
    obtain ⟨a, rfl⟩ := exists_single_of_mem_wtComp (S := suppF ℓ) hhi hv
    show wtX (suppF ℓ) (scalF ℓ) _ = 0
    refine wtX_single_eq_zero (S := suppF ℓ) (x := scalF ℓ) ?_ a
    show ¬ suppF ℓ ((ℓ : ℤ) - 1 + 2)
    rintro ⟨h1, h2, h3⟩; omega
  · intro v hv
    rw [F_comp] at hv
    obtain ⟨a, rfl⟩ := exists_single_of_mem_wtComp (S := suppF ℓ) hlo hv
    show wtY (suppF ℓ) (scalF ℓ) _ = 0
    refine wtY_single_eq_zero (S := suppF ℓ) (x := scalF ℓ) ?_ a
    show ¬ suppF ℓ (-((ℓ : ℤ) - 1) - 2)
    rintro ⟨h1, h2, h3⟩; omega

/-- **`RQ2-6.01-C5`, `C7`, `C8`, `C9`** — the displayed `ℚ`-rational Gelfand-quiver diagram of
`§6.1`:

```
      0  ⇄  ℚ[√-1]  ⇄  0
      ↓ 0     ↓ c      ↓ 0
      0  ⇄  ℚ[√-1]  ⇄  0
```

i.e. of `𝔼_ℚ(F_ℓ)` (the native `E_E ℚ ImagUnit.qi ℓ`, re-indexed to `Γ_ℚ`; isomorphic, with identity components, to the engine functor `E_QFunctor`):
`M(−) = M(+) = 0` and hence every `φ_{a_±}`, `φ_{b_±}` is zero (`C5`); `M(⋆)` is a
one-dimensional `ℚ[√-1]`-space; the vertical map `φ_⋆` is complex conjugation `c` — stated
basis-freely as "some non-zero vector of `M(⋆)` is `φ_⋆`-fixed", which for a one-dimensional space
with a `c`-semilinear involution is exactly the statement that `φ_⋆` **is** `c` in a suitable basis
(`C9`).  `C7` (`Y⋆ ∘ X⋆ = 1`, so unipotent stabilization is trivial) and `C8`'s `φ_± = 0` are the
`M(±) = 0` conjuncts together with the identity `Y⋆X⋆ = 𝟏` on `M(⋆)`.

The equality of the vertical map is stated in the disjoint union `⊔_v M(v)` (S2's `Rep.tot`), the
project's standing device for avoiding a transport along `c · ⋆ = ⋆` inside a statement
(`Quiver/Rep/Basic.lean`, "the dependent-type crux").

@census    none (auxiliary; discharges census clauses `RQ2-6.01-C5`, `C7`, `C8`, `C9`)
@source    ex:finitedimensional
@clauses   RQ2-6.01-C5, RQ2-6.01-C7, RQ2-6.01-C8, RQ2-6.01-C9
@imports   none
@divergence JUSTIFIED_REFORMULATION (the vertical arrow's `c`-label, disclosed).  The display
labels the vertical arrow at `⋆` with `c`, which presupposes the identification `M(⋆) ≅ ℚ[√-1]`
the display itself makes and the source never pins; the `∃ b ≠ 0` conjunct is stated instead.

**What that conjunct does and does not carry** (finding `V-S9G2-2`): it pins the display's
*isomorphism class*, and no more — it is derivable from the adjacent `finrank = 1` conjunct
together with S2's `Rep` axioms alone (`φ_⋆` is an `≃+`, `c`-semilinear and involutive, so
Hilbert 90 supplies a fixed vector), with no reference to any operator of §6.  `RQ2-6.01-C8`'s
`φ_⋆ = c ∘ X⋆` is carried instead by the **last** conjunct, `Y⋆ ∘ X⋆ = 𝟏` on `M(⋆)` — clause
`RQ2-6.01-C7`'s own operators — through S8's definition `φ_{v,c} = c ∘ φ^{(∞)}_v`; and `C8`'s
`φ_± = 0` is the two `M(±) = 0` conjuncts.  Stated in the disjoint union `⊔_v M(v)` (S2's
`Rep.tot`) to keep a transport along `c · ⋆ = ⋆` out of the statement. -/
theorem F_quiverRep_eq (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    (∀ m : (EQObj hℓ (F ℓ hℓ)).toRep.M (vtxQ SqrtNegOneExt.qi.card_gal 0), m = 0) ∧
    (∀ m : (EQObj hℓ (F ℓ hℓ)).toRep.M (vtxQ SqrtNegOneExt.qi.card_gal 2), m = 0) ∧
    Module.finrank (Qi : Type)
      ((EQObj hℓ (F ℓ hℓ)).toRep.M (vtxQ SqrtNegOneExt.qi.card_gal 1)) = 1 ∧
    (∀ e : GQ.E, (EQObj hℓ (F ℓ hℓ)).toRep.φEdge e = 0) ∧
    (∃ b : (EQObj hℓ (F ℓ hℓ)).toRep.M (vtxQ SqrtNegOneExt.qi.card_gal 1), b ≠ 0 ∧
      (EQObj hℓ (F ℓ hℓ)).toRep.tot _
          ((EQObj hℓ (F ℓ hℓ)).toRep.φ galConj (vtxQ SqrtNegOneExt.qi.card_gal 1) b)
        = (EQObj hℓ (F ℓ hℓ)).toRep.tot (vtxQ SqrtNegOneExt.qi.card_gal 1) b) ∧
    (∀ v : (F ℓ hℓ).carrier, v ∈ (F ℓ hℓ).weight.comp (-((ℓ : ℤ) - 1)) →
      Split.yStar (qiSetupOf (F ℓ hℓ)) (Split.xStar (qiSetupOf (F ℓ hℓ)) v) = v) := by
  have hℓz : (1 : ℤ) ≤ (ℓ : ℤ) := by exact_mod_cast hℓ
  have hSs : suppF ℓ (-((ℓ : ℤ) - 1)) := ⟨by omega, by omega, by omega⟩
  -- `M(±) = 0`: the two `K`-types at `±(ℓ+1)` lie outside `F_ℓ`'s string
  have hNm : ¬ suppF ℓ (-((ℓ : ℤ) + 1)) := by rintro ⟨h1, h2, h3⟩; omega
  have hNp : ¬ suppF ℓ ((ℓ : ℤ) + 1) := by rintro ⟨h1, h2, h3⟩; omega
  have hz0 : ∀ m : (EQObj hℓ (F ℓ hℓ)).toRep.M (vtxQ SqrtNegOneExt.qi.card_gal 0), m = 0 :=
    fun m => Subtype.ext (eq_zero_of_mem_wtComp_not_mem (S := suppF ℓ) hNm m.2)
  have hz2 : ∀ m : (EQObj hℓ (F ℓ hℓ)).toRep.M (vtxQ SqrtNegOneExt.qi.card_gal 2), m = 0 :=
    fun m => Subtype.ext (eq_zero_of_mem_wtComp_not_mem (S := suppF ℓ) hNp m.2)
  have hcas : (qiSetupOf (F ℓ hℓ)).weight.casimir
      = (algebraMap ℚ (Qi : Type) ((ℓ : ℚ) ^ 2)) • 1 := wtCasimir_eq ℓ (F_sl2 ℓ) (F_cas ℓ)
  refine ⟨hz0, hz2, wtComp_finrank hSs, ?_, ?_, ?_⟩
  · -- every displayed horizontal map is zero, because one of its two ends is `0`
    have hcases : ∀ e : Fin 4, (EQObj hℓ (F ℓ hℓ)).toRep.φEdge e = 0 := by
      intro e
      fin_cases e
      · -- `φ_{a_-} = X` out of `M(−) = 0`
        refine LinearMap.ext fun m => Subtype.ext ?_
        show (F ℓ hℓ).weight.X m.1 = 0
        rw [eq_zero_of_mem_wtComp_not_mem (S := suppF ℓ) hNm m.2]
        exact LinearMap.map_zero _
      · exact LinearMap.ext fun _ => hz0 _
      · -- `φ_{a_+} = X⋆⁻¹ ∘ Y` out of `M(+) = 0`
        refine LinearMap.ext fun m => Subtype.ext ?_
        show ((qiSetupOf (F ℓ hℓ)).starInverses hℓ).xStarInv
          ((F ℓ hℓ).weight.Y m.1) = 0
        have hY : (F ℓ hℓ).weight.Y (0 : WtCar (suppF ℓ)) = 0 := LinearMap.map_zero _
        rw [eq_zero_of_mem_wtComp_not_mem (S := suppF ℓ) hNp m.2, hY]
        exact LinearMap.map_zero _
      · exact LinearMap.ext fun _ => hz2 _
    exact fun e => hcases e
  · -- a non-zero `φ_⋆`-fixed vector: Hilbert 90 at the `c`-fixed vertex `⋆`
    have hfix : galConj • vtxQ SqrtNegOneExt.qi.card_gal 1 = vtxQ SqrtNegOneExt.qi.card_gal 1 := by
      rw [gelfandQ_smul_vertex]; rfl
    have hinvc : (galConj : (Qi : Type) ≃ₐ[ℚ] (Qi : Type))⁻¹ = galConj :=
      inv_eq_of_mul_eq_one_right galConj_mul_self
    set R := (EQObj hℓ (F ℓ hℓ)).toRep with hR
    have hne : (⟨Finsupp.single (⟨-((ℓ : ℤ) - 1), hSs⟩ : WtIdx (suppF ℓ)) (1 : (Qi : Type)),
        by exact single_mem_wtComp (⟨-((ℓ : ℤ) - 1), hSs⟩ : WtIdx (suppF ℓ)) 1⟩ :
          R.M (vtxQ SqrtNegOneExt.qi.card_gal 1)) ≠ 0 := by exact wtComp_elt_ne_zero hSs
    obtain ⟨b, hb0, hbfix⟩ := exists_fixed_ne_zero (V := R.M (vtxQ SqrtNegOneExt.qi.card_gal 1)) hne (R.φ' galConj hfix)
      (fun a m => R.φ'_smul galConj hfix a m)
      (fun m => by
        have h := R.φ'_inv galConj hfix (by rw [hinvc]; exact hfix) m
        rwa [R.φ'_congr hinvc (by rw [hinvc]; exact hfix) hfix] at h)
    exact ⟨b, hb0, (R.sigma_mk_eq_iff hfix _ b).mpr hbfix⟩
  · -- `Y⋆X⋆ = 𝟏` on `M(⋆)` (`RQ2-6.01-C7`), through `T₋ = 𝟏` at a scalar Casimir
    exact fun v hv => (Split.yStar_xStar_apply (Q := (qiSetupOf (F ℓ hℓ))) hℓ v hv).trans
      (tMinus_eq_one_of_casimir_scalar (qiSetupOf (F ℓ hℓ)) hℓ hcas v)

/-- **`RQ2-6.01-C10`** — the displayed étale `ℚ`-species representation of `§6.1`:
`W_{⋆} = M(⋆)^{G_⋆} = ℚ`, `W_{±} = M(+)^{G_+} = 0`, and every structure map `f_{ij}` is zero.

Stated of S5's own functor `F = FFunctor Γ_ℚ` (census `RQ-2.26`) applied to `𝔼_ℚ(F_ℓ)`, i.e. of
the composite the corollary `RQ-5.06` pins.

@census    none (auxiliary; discharges clause `RQ2-6.01-C10`)
@source    ex:finitedimensional
@clauses   RQ2-6.01-C10
@imports   none
@divergence none -/
theorem F_speciesRep_eq (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    (∀ w : ((RationalQuiver.FFunctor GQ).obj
      (EQObj hℓ (F ℓ hℓ))).W pmNode, w = 0) ∧
    Module.finrank ℚ (((RationalQuiver.FFunctor GQ).obj
      (EQObj hℓ (F ℓ hℓ))).W starNode) = 1 ∧
    (∀ i j : GQ.toSpecies.I,
      ((RationalQuiver.FFunctor GQ).obj
        (EQObj hℓ (F ℓ hℓ))).f i j = 0) := by
  obtain ⟨hz0, hz2, hfr, -, -, -⟩ := F_quiverRep_eq ℓ hℓ
  have hpm : Subsingleton ((EQObj hℓ (F ℓ hℓ)).toRep.M (GQ.vertexRep pmNode)) := by
    rcases vertexRep_pmNode with h | h <;> rw [h]
    · exact ⟨fun a b => (hz0 a).trans (hz0 b).symm⟩
    · exact ⟨fun a b => (hz2 a).trans (hz2 b).symm⟩
  have hWpm := subsingleton_W_of_subsingleton (EQObj hℓ (F ℓ hℓ)) pmNode hpm
  refine ⟨fun w => hWpm.elim w 0, ?_, ?_⟩
  · rw [finrank_W_star]; exact hfr
  · intro i j
    rcases node_cases j with rfl | rfl
    · rcases node_cases i with rfl | rfl
      · exact f_zero_of_edges _ _ _ (M_diag_subsingleton starNode)
      · exact f_zero_of_source _ _ _ hWpm
    · exact f_zero_of_target _ _ _ hWpm

end RationalQuivers.Examples
