import RationalQuivers.Gelfand.BaseChange.Mixed

/-!
# Base change non-split → non-split, HC side (WP-15, T1 case (2))

*Provenance.*  Relocated in stage T4 (WP-11) from `GF/BaseChangeNNHC.lean` (v1 `RationalQuivers.Gelfand.GF`) by `workflow/v2/stages/T4/VALIDATION/scripts/relocate_bc.py`: whole file, declarations moved from `GF.x` to `Gelfand.BaseChange.x` (renames in the T4 `DECL-ALLOWLIST.tsv`), references qualified, the imports of v1's `GF/Main`/`GF/Species` cut; statements and proofs otherwise unchanged.  The native statement on `HC ℓ E D`/`𝔼_E` (`prop:basechange`, `RQ2-5.14`) is in `Gelfand/BaseChange/Native.lean`.

`√-1 ∉ E''` (hence `√-1 ∉ E`), `E → E''`, and an algebra map `ι : E(√-1) → E''(√-1)` compatible
with both base fields (`Algebra D.carrier D''.carrier`, scalar towers through `E`).

* `ConjCompat D D''` — `ι ∘ c = c'' ∘ ι`; **proved** for `√-1 ∉ E''` and a square root `s` of
  `-1` in `D'` (`conjCompat_of_noSqrtNegOne`): both are `E`-algebra maps `E(√-1) → E''(√-1)` sending
  `s ↦ -ι(s)`, and `E(√-1) = E(s)` is generated by `s` (`algHom_ext_sqrt`).  Since the v2
  amendment T4-a1 the root `s` is an explicit argument, the structure `SqrtNegOneExt` being
  root-free.  It is a genuine hypothesis: without it the statement fails (for `D' = E(√-3)` inside
  `E''`, `ι` lands in `E''` and `c'' ∘ ι = ι ≠ ι ∘ c`).
* `HCEObj.bcNN` / `hcBaseChangeNN` — the functor `HC_λ(𝔤,K)_E ⥤ HC_λ(𝔤,K)_{E''}`:
  `M_{E''} = E'' ⊗_E M_E`, `M_{E''(√-1)} = E''(√-1) ⊗_{E(√-1)} M_{E(√-1)}` with `W.baseChange`, the
  comparison `E''(√-1) ⊗_{E''} M_{E''} ≅ M_{E''(√-1)}` from `cancelBaseChange` twice and the given
  `E(√-1) ⊗_E M_E ≅ M_{E(√-1)}`, and the conjugation `c''(b ⊗ m) = c''(b) ⊗ c(m)` (`conjBC`).
  This is the `nn` shape that S10's `E_E_equivalence` `@divergence` (4) left unbuilt; it is
  **constructed** here.
-/

namespace RationalQuivers.Gelfand.BaseChange

open RationalQuivers.HC RationalQuivers.Gelfand CategoryTheory
open scoped TensorProduct

/-! ## `ι ∘ c = c'' ∘ ι` -/

section Compat

variable {E : Type} [Field E] [CharZero E]

/-- An `E`-algebra map out of `E(√-1)` (`√-1 ∉ E`) is determined by its value at a square root
`s` of `-1` (an explicit argument since the v2 amendment T4-a1).
@census none (helper; WP-15) -/
theorem algHom_ext_sqrt [NoSqrtNegOne E] (D : SqrtNegOneExt E) (s : D.carrier) (hs : s * s = -1)
    {R : Type} [Ring R] [Algebra E R]
    {f g : D.carrier →ₐ[E] R} (h : f s = g s) : f = g := by
  have hli : LinearIndependent E ![(1 : D.carrier), s] := by
    rw [LinearIndependent.pair_iff]
    intro u t hst
    by_cases ht : t = 0
    · subst ht
      simp only [zero_smul, add_zero] at hst
      exact ⟨(smul_eq_zero.mp hst).resolve_right one_ne_zero, rfl⟩
    · exfalso
      have hu : s = algebraMap E D.carrier (-(u / t)) := by
        rw [Algebra.smul_def, Algebra.smul_def, mul_one] at hst
        have ht' : algebraMap E D.carrier t ≠ 0 := by
          rwa [ne_eq, map_eq_zero_iff _ (algebraMap E D.carrier).injective]
        rw [map_neg, map_div₀]
        field_simp
        linear_combination hst
      apply NoSqrtNegOne.no_sqrt (-(u / t))
      apply (algebraMap E D.carrier).injective
      rw [map_mul, ← hu, hs, map_neg, map_one]
  have hspan : Submodule.span E (Set.range ![(1 : D.carrier), s]) = ⊤ := by
    apply hli.span_eq_top_of_card_eq_finrank
    rw [Fintype.card_fin, ← IsGalois.card_aut_eq_finrank E D.carrier, D.card_gal]
  have hlin : f.toLinearMap = g.toLinearMap := by
    refine LinearMap.ext_on_range hspan (fun i => ?_)
    fin_cases i
    · simp
    · simpa using h
  exact AlgHom.ext fun x => congrArg (fun φ : D.carrier →ₗ[E] R => φ x) hlin

omit [CharZero E] in
/-- `√-1 ∉ E''` and `E → E''` give `√-1 ∉ E`.  @census none (helper; WP-15) -/
theorem noSqrtNegOne_of_algebra (E'' : Type) [Field E''] [Algebra E E''] [NoSqrtNegOne E''] :
    NoSqrtNegOne E :=
  ⟨fun b hb => NoSqrtNegOne.no_sqrt (algebraMap E E'' b) (by rw [← map_mul, hb, map_neg, map_one])⟩

variable (D : SqrtNegOneExt E) {E'' : Type} [Field E''] [CharZero E''] (D'' : SqrtNegOneExt E'')
variable [Algebra D.carrier D''.carrier]

/-- **The compatibility of `ι : E(√-1) → E''(√-1)` with the two conjugations**, `ι ∘ c = c'' ∘ ι`.
The datum the `nn` base change needs; proved below for `√-1 ∉ E''`.
@census none (helper; WP-15) -/
def ConjCompat : Prop :=
  ∀ a : D.carrier, algebraMap D.carrier D''.carrier (D.conj a)
    = D''.conj (algebraMap D.carrier D''.carrier a)

variable [Algebra E E''] [Algebra E D''.carrier] [IsScalarTower E E'' D''.carrier]
  [IsScalarTower E D.carrier D''.carrier]

/-- **`ι ∘ c = c'' ∘ ι` for `√-1 ∉ E''`**, given a square root `s` of `-1` in `D'` — no
compatibility hypothesis is needed beyond the algebra maps.  The root is an explicit argument since
the v2 amendment T4-a1, and it is a real hypothesis (module docstring).
@census none (helper; WP-15) -/
theorem conjCompat_of_noSqrtNegOne [NoSqrtNegOne E''] (s : D.carrier) (hs : s * s = -1) :
    ConjCompat D D'' := by
  haveI : NoSqrtNegOne E := noSqrtNegOne_of_algebra E''
  set t : D''.carrier := algebraMap D.carrier D''.carrier s
  have ht : t * t = -1 := by rw [← map_mul, hs, map_neg, map_one]
  have hc'' : D''.conj t = -t := conj_sqrt_of_noSqrtNegOne D'' t ht
  let f : D.carrier →ₐ[E] D''.carrier :=
    (IsScalarTower.toAlgHom E D.carrier D''.carrier).comp D.conj.toAlgHom
  let g : D.carrier →ₐ[E] D''.carrier :=
    ((D''.conj.toAlgHom).restrictScalars E).comp (IsScalarTower.toAlgHom E D.carrier D''.carrier)
  have hfg : f = g := by
    apply algHom_ext_sqrt D s hs
    show algebraMap D.carrier D''.carrier (D.conj s) = D''.conj t
    rw [conj_sqrt_of_noSqrtNegOne D s hs, map_neg, hc'']
  intro a
  exact congrArg (fun φ : D.carrier →ₐ[E] D''.carrier => φ a) hfg

end Compat

/-! ## The conjugation `c'' ⊗ c` on `E''(√-1) ⊗_{E(√-1)} M` -/

section ConjBC

variable {E : Type} [Field E] [CharZero E] {D : SqrtNegOneExt E}
variable {E'' : Type} [Field E''] [CharZero E''] {D'' : SqrtNegOneExt E''}
variable [Algebra D.carrier D''.carrier]
variable {Mi : Type} [AddCommGroup Mi] [Module D.carrier Mi]

/-- The additive map `b ⊗ m ↦ c''(b) ⊗ c(m)`, for an additive `c`-semilinear `c : Mi → Mi`.
@census none (helper; WP-15) -/
noncomputable def conjBCHom (hι : ConjCompat D D'') (c : Mi →+ Mi)
    (hc : ∀ (a : D.carrier) (v : Mi), c (a • v) = D.conj a • c v) :
    D''.carrier ⊗[D.carrier] Mi →+ D''.carrier ⊗[D.carrier] Mi :=
  TensorProduct.liftAddHom
    (AddMonoidHom.mk' (fun b => AddMonoidHom.mk' (fun m => D''.conj b ⊗ₜ[D.carrier] c m)
      (fun m m' => by rw [map_add, TensorProduct.tmul_add]))
      (fun b b' => by ext m; simp [map_add, TensorProduct.add_tmul]))
    (fun a b m => by
      show D''.conj (a • b) ⊗ₜ[D.carrier] c m = D''.conj b ⊗ₜ[D.carrier] c (a • m)
      rw [hc, Algebra.smul_def, map_mul, ← hι, ← Algebra.smul_def, TensorProduct.smul_tmul])

@[simp] theorem conjBCHom_tmul (hι : ConjCompat D D'') (c : Mi →+ Mi)
    (hc : ∀ (a : D.carrier) (v : Mi), c (a • v) = D.conj a • c v) (b : D''.carrier) (m : Mi) :
    conjBCHom hι c hc (b ⊗ₜ[D.carrier] m) = D''.conj b ⊗ₜ[D.carrier] c m := rfl

theorem conjBCHom_smul (hι : ConjCompat D D'') (c : Mi →+ Mi)
    (hc : ∀ (a : D.carrier) (v : Mi), c (a • v) = D.conj a • c v) (a : D''.carrier)
    (x : D''.carrier ⊗[D.carrier] Mi) :
    conjBCHom hι c hc (a • x) = D''.conj a • conjBCHom hι c hc x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul b m => rw [TensorProduct.smul_tmul', conjBCHom_tmul, conjBCHom_tmul, smul_eq_mul, map_mul,
      TensorProduct.smul_tmul', smul_eq_mul]
  | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add]

theorem conjBCHom_invol (hι : ConjCompat D D'') (c : Mi →+ Mi)
    (hc : ∀ (a : D.carrier) (v : Mi), c (a • v) = D.conj a • c v) (hinv : ∀ v, c (c v) = v)
    (x : D''.carrier ⊗[D.carrier] Mi) : conjBCHom hι c hc (conjBCHom hι c hc x) = x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul b m => rw [conjBCHom_tmul, conjBCHom_tmul, SqrtNegOneExt.conj_conj, hinv]
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-- `c'' ⊗ c` as an additive involution.  @census none (helper; WP-15) -/
noncomputable def conjBC (hι : ConjCompat D D'') (c : Mi ≃+ Mi)
    (hc : ∀ (a : D.carrier) (v : Mi), c (a • v) = D.conj a • c v) (hinv : Function.Involutive c) :
    D''.carrier ⊗[D.carrier] Mi ≃+ D''.carrier ⊗[D.carrier] Mi where
  toFun := conjBCHom hι c.toAddMonoidHom hc
  invFun := conjBCHom hι c.toAddMonoidHom hc
  left_inv x := conjBCHom_invol hι c.toAddMonoidHom hc hinv x
  right_inv x := conjBCHom_invol hι c.toAddMonoidHom hc hinv x
  map_add' x y := map_add _ x y

@[simp] theorem conjBC_tmul (hι : ConjCompat D D'') (c : Mi ≃+ Mi)
    (hc : ∀ (a : D.carrier) (v : Mi), c (a • v) = D.conj a • c v) (hinv : Function.Involutive c)
    (b : D''.carrier) (m : Mi) :
    conjBC hι c hc hinv (b ⊗ₜ[D.carrier] m) = D''.conj b ⊗ₜ[D.carrier] c m := rfl

end ConjBC

/-! ## `HC_λ(𝔤,K)_E ⥤ HC_λ(𝔤,K)_{E''}`, non-split → non-split -/

section HCNN

variable {ℓ : ℕ}
variable {E : Type} [Field E] [CharZero E] (D : SqrtNegOneExt E)
variable {E'' : Type} [Field E''] [CharZero E''] (D'' : SqrtNegOneExt E'')
variable [Algebra E E''] [Algebra D.carrier D''.carrier] [Algebra E D''.carrier]
  [IsScalarTower E E'' D''.carrier] [IsScalarTower E D.carrier D''.carrier]

variable {D D''} in
/-- The comparison `E''(√-1) ⊗_{E''} (E'' ⊗_E M_E) ≅ E''(√-1) ⊗_{E(√-1)} M_{E(√-1)}`.
@census none (helper; WP-15) -/
noncomputable def bcNNEquiv {Mq Mi : Type} [AddCommGroup Mq] [Module E Mq] [AddCommGroup Mi]
    [Module D.carrier Mi] (e : D.carrier ⊗[E] Mq ≃ₗ[D.carrier] Mi) :
    D''.carrier ⊗[E''] (E'' ⊗[E] Mq) ≃ₗ[D''.carrier] D''.carrier ⊗[D.carrier] Mi :=
  (TensorProduct.AlgebraTensorModule.cancelBaseChange E E'' D''.carrier D''.carrier Mq) ≪≫ₗ
    (TensorProduct.AlgebraTensorModule.cancelBaseChange E D.carrier D''.carrier D''.carrier Mq).symm
    ≪≫ₗ e.baseChange D.carrier D''.carrier _ _

theorem bcNNEquiv_tmul_tmul {Mq Mi : Type} [AddCommGroup Mq] [Module E Mq] [AddCommGroup Mi]
    [Module D.carrier Mi] (e : D.carrier ⊗[E] Mq ≃ₗ[D.carrier] Mi) (b : D''.carrier) (a : E'')
    (q : Mq) :
    bcNNEquiv (D := D) (D'' := D'') e (b ⊗ₜ[E''] (a ⊗ₜ[E] q))
      = (a • b) ⊗ₜ[D.carrier] e ((1 : D.carrier) ⊗ₜ[E] q) := rfl

variable {D D''}

/-- The `nn` base change of the standing setup.  @census none (helper; WP-15) -/
noncomputable def bcNNSetup (hι : ConjCompat D D'') (A : HCEObj ℓ E D) :
    RationalSetupOver ℓ E'' D'' (E'' ⊗[E] A.form) (D''.carrier ⊗[D.carrier] A.carrier) :=
    { baseChange := bcNNEquiv A.setup.baseChange
      weight := A.setup.weight.baseChange
      gic := (A.toObjOver.baseChange (E'' := D''.carrier)).gic
      conj := conjBC hι A.setup.conj A.setup.conj_smul A.setup.conj_involutive
      conj_smul := fun a x => conjBCHom_smul hι A.setup.conj.toAddMonoidHom A.setup.conj_smul a x
      conj_involutive := fun x => conjBCHom_invol hι A.setup.conj.toAddMonoidHom A.setup.conj_smul
        (fun v => A.setup.conj_involutive v) x
      conj_baseChange := fun v => by
        induction v using TensorProduct.induction_on with
        | zero => simp
        | tmul a q =>
          rw [bcNNEquiv_tmul_tmul, conjBC_tmul, A.setup.conj_baseChange, Algebra.smul_def, mul_one,
            AlgEquiv.commutes]
        | add x y hx hy => rw [TensorProduct.tmul_add, map_add, map_add, hx, hy]
      conj_comp := fun n x hx => by
        obtain ⟨y, rfl⟩ := hx
        induction y using TensorProduct.induction_on with
        | zero => simp
        | tmul b m =>
          rw [LinearMap.baseChange_tmul]
          exact Submodule.tmul_mem_baseChange_of_mem _ (A.setup.conj_comp n _ m.2)
        | add x y hx hy => simp only [map_add]; exact Submodule.add_mem _ hx hy
      conj_X := fun x => by
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul b m =>
          show conjBC hι _ _ _ (LinearMap.baseChange _ _ (b ⊗ₜ m))
            = LinearMap.baseChange _ _ (conjBC hι _ _ _ (b ⊗ₜ m))
          rw [LinearMap.baseChange_tmul, conjBC_tmul, conjBC_tmul, LinearMap.baseChange_tmul,
            A.setup.conj_X]
        | add x y hx hy => simp only [map_add, hx, hy]
      conj_Y := fun x => by
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul b m =>
          show conjBC hι _ _ _ (LinearMap.baseChange _ _ (b ⊗ₜ m))
            = LinearMap.baseChange _ _ (conjBC hι _ _ _ (b ⊗ₜ m))
          rw [LinearMap.baseChange_tmul, conjBC_tmul, conjBC_tmul, LinearMap.baseChange_tmul,
            A.setup.conj_Y]
        | add x y hx hy => simp only [map_add, hx, hy]
      conj_H := fun x => by
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul b m =>
          show conjBC hι _ _ _ (LinearMap.baseChange _ _ (b ⊗ₜ m))
            = -LinearMap.baseChange _ _ (conjBC hι _ _ _ (b ⊗ₜ m))
          rw [LinearMap.baseChange_tmul, conjBC_tmul, conjBC_tmul, LinearMap.baseChange_tmul,
            A.setup.conj_H, TensorProduct.tmul_neg]
        | add x y hx hy => simp only [map_add, hx, hy, neg_add] }

theorem bcNNSetup_weight (hι : ConjCompat D D'') (A : HCEObj ℓ E D) :
    (bcNNSetup hι A).weight = A.setup.weight.baseChange (E'' := D''.carrier) := rfl

/-- **The `nn` base change of an object** `M_E ↦ M_{E''}`.  @census none (helper; WP-15) -/
@[reducible] noncomputable def _root_.RationalQuivers.Gelfand.HCEObj.bcNN (hι : ConjCompat D D'')
    (A : HCEObj ℓ E D) : HCEObj ℓ E'' D'' where
  form := E'' ⊗[E] A.form
  carrier := D''.carrier ⊗[D.carrier] A.carrier
  setup := bcNNSetup hι A
  admissible n := by
    rw [bcNNSetup_weight]
    exact (A.toObjOver.baseChange (E'' := D''.carrier)).admissible n
  centralCharacter n hn := by
    rw [bcNNSetup_weight]
    exact parity_baseChange (E'' := D''.carrier) A.toObjOver_parity n hn
  fg := by
    rw [bcNNSetup_weight]
    exact (A.toObjOver.baseChange (E'' := D''.carrier)).fg

omit [Algebra E E''] [Algebra E D''.carrier] [IsScalarTower E E'' D''.carrier]
  [IsScalarTower E D.carrier D''.carrier] in
/-- Base change preserves an intertwining relation.  @census none (helper; WP-15) -/
theorem baseChange_comm {M N : Type} [AddCommGroup M] [Module D.carrier M] [AddCommGroup N]
    [Module D.carrier N] (f : M →ₗ[D.carrier] N) (S : Module.End D.carrier M)
    (T : Module.End D.carrier N) (h : ∀ v, f (S v) = T (f v)) (v : D''.carrier ⊗[D.carrier] M) :
    LinearMap.baseChange D''.carrier f (LinearMap.baseChange D''.carrier S v)
      = LinearMap.baseChange D''.carrier T (LinearMap.baseChange D''.carrier f v) := by
  have h1 : f ∘ₗ S = T ∘ₗ f := LinearMap.ext h
  have h2 := congrArg (LinearMap.baseChange D''.carrier) h1
  rw [LinearMap.baseChange_comp, LinearMap.baseChange_comp] at h2
  exact congrArg (fun g : (D''.carrier ⊗[D.carrier] M) →ₗ[D''.carrier] (D''.carrier ⊗[D.carrier] N)
    => g v) h2

omit [Algebra E E''] [Algebra E D''.carrier] [IsScalarTower E E'' D''.carrier]
  [IsScalarTower E D.carrier D''.carrier] in
/-- Base change preserves "`f` maps `p` into `q`".  @census none (helper; WP-15) -/
theorem baseChange_mem {M N : Type} [AddCommGroup M] [Module D.carrier M] [AddCommGroup N]
    [Module D.carrier N] (f : M →ₗ[D.carrier] N) (p : Submodule D.carrier M)
    (q : Submodule D.carrier N) (h : ∀ v ∈ p, f v ∈ q) (x : D''.carrier ⊗[D.carrier] M)
    (hx : x ∈ p.baseChange D''.carrier) :
    LinearMap.baseChange D''.carrier f x ∈ q.baseChange D''.carrier := by
  obtain ⟨y, rfl⟩ := hx
  induction y using TensorProduct.induction_on with
  | zero => simp
  | tmul b m =>
    rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul]
    exact Submodule.tmul_mem_baseChange_of_mem _ (h _ m.2)
  | add x y hx hy => simp only [map_add]; exact Submodule.add_mem _ hx hy

/-- The `nn` base change of a morphism.  @census none (helper; WP-15) -/
noncomputable def _root_.RationalQuivers.Gelfand.HCEHom.bcNN (hι : ConjCompat D D'') {A B : HCEObj ℓ E D} (f : A ⟶ B) :
    HCEObj.bcNN hι A ⟶ HCEObj.bcNN hι B where
  toLinearMap := LinearMap.baseChange D''.carrier f.toLinearMap
  map_H := baseChange_comm (D'' := D'') _ _ _ f.map_H
  map_X := baseChange_comm (D'' := D'') _ _ _ f.map_X
  map_Y := baseChange_comm (D'' := D'') _ _ _ f.map_Y
  map_comp n x hx := baseChange_mem (D'' := D'') f.toLinearMap _ _ (f.map_comp n) x hx
  map_conj x := by
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul b m =>
      show LinearMap.baseChange _ _
          (conjBC hι A.setup.conj A.setup.conj_smul A.setup.conj_involutive (b ⊗ₜ m))
        = conjBC hι B.setup.conj B.setup.conj_smul B.setup.conj_involutive
          (LinearMap.baseChange _ _ (b ⊗ₜ m))
      rw [conjBC_tmul, LinearMap.baseChange_tmul, LinearMap.baseChange_tmul, conjBC_tmul,
        f.map_conj]
    | add x y hx hy => simp only [map_add, hx, hy]

variable (ℓ E D E'' D'') in
/-- **The `nn` base-change functor** `HC_λ(𝔤,K)_E ⥤ HC_λ(𝔤,K)_{E''}`, `√-1 ∉ E''`, constructed.
@census none (helper; WP-15; the `nn` shape of `RQ-5.08-C4`) -/
noncomputable def hcBaseChangeNN (hι : ConjCompat D D'') : HCEObj ℓ E D ⥤ HCEObj ℓ E'' D'' where
  obj A := HCEObj.bcNN hι A
  map f := HCEHom.bcNN hι f
  map_id A := by
    apply HCEHom.hom_ext
    show LinearMap.baseChange D''.carrier LinearMap.id = LinearMap.id
    rw [LinearMap.baseChange_id]
  map_comp f g := by
    apply HCEHom.hom_ext
    show LinearMap.baseChange D''.carrier (g.toLinearMap ∘ₗ f.toLinearMap) = _
    rw [LinearMap.baseChange_comp]
    rfl

/-- The `nn` base change, read over `E''(√-1)`, **is** the split base change along
`ι : E(√-1) → E''(√-1)` of the object read over `E(√-1)`.  @census none (helper; WP-15) -/
theorem bcNN_toF (hι : ConjCompat D D'') (A : HCEObj ℓ E D) :
    (HCEObj.bcNN hι A).toF = A.toF.bcF D''.carrier := rfl

end HCNN

end RationalQuivers.Gelfand.BaseChange
