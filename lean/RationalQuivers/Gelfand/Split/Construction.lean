/-! ## Finite generation of a graded `𝔰𝔩₂`-module -/

/-- The `(𝔤,K)`-submodule generated by `S` in a `WeightData E M`: the smallest submodule containing
`S` that is stable under `H, X, Y` (`WeightData.OpStable`) and under the projections onto the
components (`WeightData.IsHomog`, which is `K`-stability once `K` acts on `M_n` by the character
`χ_n`).  The split-torus counterpart of `HC.gkSpan`.  @census none (helper) -/
def gkSpanGraded {E : Type*} [Field E] {M : Type*} [AddCommGroup M] [Module E M]
    (W : WeightData E M) (S : Set M) : Submodule E M :=
  sInf {N | S ⊆ (N : Set M) ∧ W.OpStable N ∧ W.IsHomog N}

/-- `M` is **finitely generated** as a `(𝔤,K)`-module (clause `RQ-3.11-C1`, read over the split
torus): some finite set generates it.  @census none (helper) -/
def _root_.RationalQuivers.HC.WeightData.IsFG {E : Type*} [Field E] {M : Type*} [AddCommGroup M]
    [Module E M] (W : WeightData E M) : Prop :=
  ∃ S : Finset M, gkSpanGraded W (↑S : Set M) = ⊤

theorem gkSpanGraded_eq_top {E : Type*} [Field E] {M : Type*} [AddCommGroup M] [Module E M]
    (W : WeightData E M) {S : Set M}
    (h : ∀ N : Submodule E M, S ⊆ (N : Set M) → W.OpStable N → W.IsHomog N → N = ⊤) :
    gkSpanGraded W S = ⊤ :=
  le_antisymm le_top (le_sInf fun _ hN => (h _ hN.1 hN.2.1 hN.2.2) ▸ le_rfl)

/-- `[Y, X^{k+1}] = −(k+1)·X^k·(H + k)`, evaluated on a weight vector:
`Y X^{k+1} v = X^{k+1} Y v − (k+1)(n+k)·X^k v` for `v ∈ M_n`.  At `n = −k` the coefficient
vanishes, which is the whole of the Gelfand relation `X Y = X^{-(ℓ-1)} Y X^{ℓ}` on `M_{-(ℓ-1)}`
(`Split.E_F_relation`).  Generic in the field.  @census none (helper) -/
theorem _root_.RationalQuivers.HC.WeightData.Y_pow_X_succ_apply {E : Type*} [Field E] {M : Type*}
    [AddCommGroup M] [Module E M] (W : WeightData E M) (k : ℕ) (n : ℤ) (v : M)
    (hv : v ∈ W.comp n) :
    W.Y ((W.X ^ (k + 1)) v)
      = (W.X ^ (k + 1)) (W.Y v) - (((k + 1 : ℕ) : E) * ((n : E) + (k : E))) • (W.X ^ k) v := by
  induction k with
  | zero =>
    have h := congrArg (fun f : Module.End E M => f v) W.lie_X_Y
    simp only [LinearMap.sub_apply, Module.End.mul_apply] at h
    rw [W.H_apply n v hv] at h
    simp only [pow_one, pow_zero, Module.End.one_apply, Nat.cast_zero, add_zero, zero_add,
      Nat.cast_one, one_mul]
    rw [← h]; abel
  | succ k ih =>
    have hw : (W.X ^ (k + 1)) v ∈ W.comp (n + 2 * ((k + 1 : ℕ) : ℤ)) := W.pow_X_mem (k + 1) n v hv
    have hYX : W.Y (W.X ((W.X ^ (k + 1)) v))
        = W.X (W.Y ((W.X ^ (k + 1)) v))
          - ((n + 2 * ((k + 1 : ℕ) : ℤ) : ℤ) : E) • (W.X ^ (k + 1)) v := by
      have h := congrArg (fun f : Module.End E M => f ((W.X ^ (k + 1)) v)) W.lie_X_Y
      simp only [LinearMap.sub_apply, Module.End.mul_apply] at h
      rw [W.H_apply _ _ hw] at h
      rw [← h]; abel
    rw [pow_succ' (a := W.X) (k + 1), Module.End.mul_apply, hYX, ih, map_sub, map_smul,
      ← Module.End.mul_apply (f := W.X) (g := W.X ^ (k + 1)), ← pow_succ',
      ← Module.End.mul_apply (f := W.X) (g := W.X ^ k), ← pow_succ']
    have hc : ((((k + 1) + 1 : ℕ) : E) * ((n : E) + ((k + 1 : ℕ) : E)))
        = (((k + 1 : ℕ) : E) * ((n : E) + (k : E))) + ((n + 2 * ((k + 1 : ℕ) : ℤ) : ℤ) : E) := by
      push_cast; ring
    rw [hc, add_smul]; abel

/-! ### The split Gelfand quiver `Γ_E` over a field that is its own base, with its relation

`RQ-5.01`'s target is "the Gelfand quiver over `ℚ[√-1]`", i.e. the `E`-rational Gelfand quiver for
`E = ℚ[√-1]` — the quiver `ex:gelfand` with the **trivial** `Gal(E/E)`-action.  `RQ-5.05`'s target
is the genuinely `ℚ`-rational one, `RationalQuiver.gelfandOfCardTwo ℚ ℚ[√-1]`, where the action is
the non-trivial involution; the two are related by base change (`RQ-1.11`).

**The relation is part of the target** (repair round): `ex:gelfand` is a quiver *with* the relation
`a₋b₋ = a₊b₊` (census `RQ-1.19`, `RQ-2.16`), and a "representation of the Gelfand quiver"
satisfies it — this is what clause `RQ-5.01-C7` establishes for `𝔼_{ℚ[√-1]}(M)`.  The tree's
`Rep`/`RepNil` know nothing of relations, and S5's `gelfandNilTwist` is a **nilpotent** rational
representation violating it, so an equivalence onto `Rep^nil` of the bare quiver would be false;
the target of `RQ-5.02`/`RQ-5.05`/`RQ-5.07`'s Gelfand rows is therefore the full subcategory
`RepNilRel` of nilpotent representations **satisfying the relation**. -/

section SplitQuiver

variable (E : Type) [Field E]

/-- The trivial permutation action is smooth: every stabilizer is the whole group.

@census none (helper) -/
theorem isSmooth_one {G X : Type} [Group G] [TopologicalSpace G] :
    IsSmooth (1 : G →* Equiv.Perm X) := fun x => by
  simp

/-- The **split** `E`-rational Gelfand quiver: `ex:gelfand` with the trivial Galois action.  This is
"the Gelfand quiver over `E`" of census clause `RQ-5.01-C8` and `RQ-5.02-C2`.

@census    none (auxiliary; the target quiver of `RQ-5.01-C8` / `RQ-5.02-C2`)
@source    ex:gelfand
@imports   none
@divergence none -/
def gelfandSplit : RationalQuiver E E :=
  RationalQuiver.ofAction E E RQuiver.gelfand 1 1
    (fun _ _ => rfl) (fun _ _ => rfl) isSmooth_one isSmooth_one

@[simp] theorem gelfandSplit_toRQuiver : (gelfandSplit E).toRQuiver = RQuiver.gelfand := rfl

/-- The vertex `−` of `ex:gelfand` (`RQuiver.gelfand`'s vertex `0`). -/
def vtxMinus : (gelfandSplit E).V := (0 : Fin 3)

/-- The vertex `⋆` of `ex:gelfand` (`RQuiver.gelfand`'s vertex `1`). -/
def vtxStar : (gelfandSplit E).V := (1 : Fin 3)

/-- The vertex `+` of `ex:gelfand` (`RQuiver.gelfand`'s vertex `2`). -/
def vtxPlus : (gelfandSplit E).V := (2 : Fin 3)

/-- The Galois group of `E/E` acts trivially on `E`: `σ a = a`.  @census none (helper) -/
theorem galSelf_apply (σ : Gal(E/E)) (a : E) : σ a = a := by
  simpa using σ.commutes a

/-- **The relation `a₋b₋ = a₊b₊` holds in a representation of the split Gelfand quiver**
(`ex:gelfand`'s relation, `RQuiver.gelfandRelation`, read in `M`).  @census none (helper) -/
def SatisfiesGelfandRelationSplit (M : RationalQuiver.Rep (gelfandSplit E)) : Prop :=
  M.pathMap (a := vtxStar E) (b := vtxStar E) RQuiver.pathMinus
    = M.pathMap (a := vtxStar E) (b := vtxStar E) RQuiver.pathPlus

/-- **`Rep^nil(Γ_E)` for the Gelfand quiver with its relation**: the full subcategory of
`Rep(Γ_E)` of finite-dimensional nilpotent representations satisfying `a₋b₋ = a₊b₊`.
@census none (auxiliary; the target category of `RQ-5.02-C2`) -/
def RepNilRelSplit : CategoryTheory.ObjectProperty (RationalQuiver.FDRep (gelfandSplit E)) :=
  fun M => M.toRep.IsNilpotent ∧ SatisfiesGelfandRelationSplit E M.toRep

end SplitQuiver

section CyclicSplit

variable (E : Type) [Field E]

/-- The **split** `E`-rational cyclic quiver, the `ℓ = 0` companion of `Gelfand.gelfandSplit`.

@census none (auxiliary; the `ℓ = 0` split target of `RQ-5.08-C2`) -/
def cyclicSplit (E : Type) [Field E] : RationalQuiver E E :=
  RationalQuiver.splitOf E RQuiver.cyclic

theorem cyclicSplit_eq (E : Type) [Field E] :
    cyclicSplit E = RationalQuiver.ofAction E E RQuiver.cyclic 1 1
      (fun _ _ => rfl) (fun _ _ => rfl) isSmooth_one isSmooth_one := rfl

end CyclicSplit

/-- The weight indices of the two vertices: `− ↦ -1`, `+ ↦ 1`.  @census none (helper) -/
def cycIdx : Fin 2 → ℤ := ![-1, 1]

section VtxIdx

variable {ℓ : ℕ}

/-- The weight indices of the three vertices of `ex:gelfand`: `− ↦ -(ℓ+1)`, `⋆ ↦ -(ℓ-1)`,
`+ ↦ ℓ+1` (census clause `RQ-5.01-C5`).  @census none (helper) -/
def vtxIdx (ℓ : ℕ) : Fin 3 → ℤ := ![-((ℓ : ℤ) + 1), -((ℓ : ℤ) - 1), (ℓ : ℤ) + 1]

@[simp] theorem vtxIdx_zero : vtxIdx ℓ 0 = -((ℓ : ℤ) + 1) := rfl
@[simp] theorem vtxIdx_one : vtxIdx ℓ 1 = -((ℓ : ℤ) - 1) := rfl
@[simp] theorem vtxIdx_two : vtxIdx ℓ 2 = (ℓ : ℤ) + 1 := rfl

/-- @census none (helper) -/
theorem sq_ne_sq_gt (j : ℤ) (h : (ℓ : ℤ) < j) : j ^ 2 ≠ (ℓ : ℤ) ^ 2 := by
  have h0 : (0 : ℤ) ≤ (ℓ : ℤ) := Int.natCast_nonneg ℓ
  nlinarith

/-- @census none (helper) -/
theorem sq_ne_sq_lt (j : ℤ) (h : j < -(ℓ : ℤ)) : j ^ 2 ≠ (ℓ : ℤ) ^ 2 := by
  have h0 : (0 : ℤ) ≤ (ℓ : ℤ) := Int.natCast_nonneg ℓ
  nlinarith

/-- @census none (helper) -/
theorem sq_ne_sq_abs (j : ℤ) (h1 : -(ℓ : ℤ) < j) (h2 : j < (ℓ : ℤ)) : j ^ 2 ≠ (ℓ : ℤ) ^ 2 := by
  nlinarith

end VtxIdx

/-- The Casimir preserves every weight component.  @census none (helper) -/
theorem casimir_mem_comp {E M : Type*} [Field E] [AddCommGroup M] [Module E M]
    (W : WeightData E M) (n : ℤ) (v : M) (hv : v ∈ W.comp n) : W.casimir v ∈ W.comp n := by
  have hXY : W.X (W.Y v) ∈ W.comp n := by
    have h1 := W.Y_mem n v hv
    have h2 := W.X_mem (n - 2) _ h1
    rwa [show (n - 2 + 2 : ℤ) = n by ring] at h2
  have hH : W.H v ∈ W.comp n := by
    rw [W.H_apply n v hv]; exact Submodule.smul_mem _ _ hv
  have hHH : W.H (W.H v) ∈ W.comp n := by
    rw [W.H_apply n _ hH]; exact Submodule.smul_mem _ _ hH
  rw [W.casimir_apply v]
  exact Submodule.add_mem _ (Submodule.add_mem _ (Submodule.sub_mem _ hHH
    (Submodule.smul_mem _ _ hH)) (Submodule.smul_mem _ _ hXY)) hv

/-- The homogeneous decomposition of an element of a single component is concentrated in that
degree.  @census none (helper) -/
theorem decompEquiv_of_mem {E : Type*} [Field E] {M : Type*} [AddCommGroup M] [Module E M]
    (W : WeightData E M) {n : ℤ} {v : M} (hv : v ∈ W.comp n) :
    W.decompEquiv v = DirectSum.of (fun k : ℤ => (W.comp k : Submodule E M)) n ⟨v, hv⟩ := by
  classical
  refine DFinsupp.ext fun k => ?_
  by_cases h : n = k
  · subst h
    rw [DirectSum.of_eq_same]
    exact Subtype.ext (W.proj_of_mem_same hv)
  · have hz : (DirectSum.of (fun k : ℤ => (W.comp k : Submodule E M)) n ⟨v, hv⟩) k = 0 :=
      DirectSum.of_eq_of_ne _ _ _ (Ne.symm h)
    rw [hz]
    exact Subtype.ext (W.proj_of_mem_ne hv h)

/-! #### Generic operator and loop-nilpotency helpers

`isNilpotent_comp_swap` and `isNilpotent_pathMap_loop` are generic (about linear maps and about
paths in any rational quiver, respectively).  Carried from v1's `Gelfand/Construction.lean` under
their v1 names (v2 WP-9). -/

section OperatorHelpers

variable {R A B : Type*} [Semiring R] [AddCommMonoid A] [Module R A] [AddCommMonoid B] [Module R B]

/-- `(gf)^{n+1} = g (fg)^n f`.  @census none (helper) -/
theorem comp_pow_swap (f : A →ₗ[R] B) (g : B →ₗ[R] A) (n : ℕ) :
    (g ∘ₗ f) ^ (n + 1) = g ∘ₗ (((f ∘ₗ g) ^ n) ∘ₗ f) := by
  induction n with
  | zero => ext x; simp
  | succ n ih => rw [pow_succ, ih, pow_succ]; ext x; simp

/-- `fg` nilpotent implies `gf` nilpotent, for maps between two different spaces.
@census none (helper) -/
theorem isNilpotent_comp_swap {f : A →ₗ[R] B} {g : B →ₗ[R] A} (h : IsNilpotent (f ∘ₗ g)) :
    IsNilpotent (g ∘ₗ f) := by
  obtain ⟨n, hn⟩ := h
  exact ⟨n + 1, by rw [comp_pow_swap, hn]; ext x; simp⟩

end OperatorHelpers

section LoopNilpotency

variable {K L : Type} [Field K] [Field L] [Algebra K L] {Γ : RationalQuiver K L}

/-- `pathMap` of a concatenation.  @census none (helper) -/
theorem pathMap_comp (M : RationalQuiver.Rep Γ) {a b c : Γ.V}
    (p : Quiver.Path a b) (q : Quiver.Path b c) :
    M.pathMap (p.comp q) = M.pathMap q ∘ₗ M.pathMap p := by
  induction q with
  | nil => simp
  | cons q g ih =>
      rw [Quiver.Path.comp_cons, RationalQuiver.Rep.pathMap_cons,
        RationalQuiver.Rep.pathMap_cons, ih, LinearMap.comp_assoc]

/-- The `k`-fold iterate of a loop.  @census none (helper) -/
def loopIter {a : Γ.V} (p : Quiver.Path a a) : ℕ → Quiver.Path a a
  | 0 => Quiver.Path.nil
  | (k + 1) => (loopIter p k).comp p

/-- @census none (helper) -/
theorem loopIter_length {a : Γ.V} (p : Quiver.Path a a) (k : ℕ) :
    (loopIter p k).length = k * p.length := by
  induction k with
  | zero => simp [loopIter]
  | succ k ih => simp [loopIter, Quiver.Path.length_comp, ih]; ring

/-- @census none (helper) -/
theorem pathMap_loopIter (M : RationalQuiver.Rep Γ) {a : Γ.V} (p : Quiver.Path a a) (k : ℕ) :
    M.pathMap (loopIter p k) = (M.pathMap p) ^ k := by
  induction k with
  | zero => simp only [loopIter, RationalQuiver.Rep.pathMap_nil, pow_zero]; rfl
  | succ k ih => rw [loopIter, pathMap_comp, ih, pow_succ']; rfl

/-- **Nilpotency at a loop.**  In a nilpotent representation the composite along any loop of
positive length is a nilpotent endomorphism: its `k`-th power is the composite along the `k`-fold
iterate, whose length grows without bound.  @census none (helper) -/
theorem isNilpotent_pathMap_loop (M : RationalQuiver.Rep Γ) (hM : M.IsNilpotent)
    {a : Γ.V} (p : Quiver.Path a a) (hp : 1 ≤ p.length) : IsNilpotent (M.pathMap p) := by
  obtain ⟨N, hN⟩ := hM
  refine ⟨N, ?_⟩
  rw [← pathMap_loopIter]
  exact hN a a (loopIter p N) (by rw [loopIter_length]; nlinarith)

end LoopNilpotency

/-! #### The graded-carrier lemma (carried)

Generic (a statement about the canonical injections of any direct sum of modules); carried from
v1's `Gelfand/Construction.lean` under its v1 name (v2 WP-9). -/

/-! #### The graded-carrier lemma

`WeightData.isInternal` asks for `DirectSum.IsInternal`, and mathlib's route to it
(`isInternal_submodule_iff_iSupIndep_and_iSup_eq_top`) is not the convenient one when the family
*is* the family of canonical summands.  `isInternal_range_lof` says directly that the ranges of the
`lof`s of a direct sum decompose it, by exhibiting the inverse of `coeLinearMap`; it is generic and
is the piece any construction of a graded module out of prescribed components needs. -/

section Internal
variable (R : Type) [CommRing R] (κ : Type) [DecidableEq κ] (W : κ → Type)
  [∀ i, AddCommGroup (W i)] [∀ i, Module R (W i)]

/-- @census none (helper; engine `E2`) -/
theorem lof_injective (i : κ) : Function.Injective (DirectSum.lof R κ W i) := by
  intro a b hab
  have := congrArg (fun x : DirectSum κ W => x i) hab
  simpa using this

/-- `⨁ Wᵢ → ⨁ range(lofᵢ)`, the inverse of `coeLinearMap`.  @census none (helper; engine `E2`) -/
noncomputable def sumToRanges :
    DirectSum κ W →ₗ[R] DirectSum κ (fun i => ↥(LinearMap.range (DirectSum.lof R κ W i))) :=
  DirectSum.toModule R κ _ (fun i =>
    (DirectSum.lof R κ (fun i => ↥(LinearMap.range (DirectSum.lof R κ W i))) i).comp
      (LinearEquiv.ofInjective (DirectSum.lof R κ W i) (lof_injective R κ W i)).toLinearMap)

/-- @census none (helper; engine `E2`) -/
theorem sumToRanges_lof (i : κ) (a : W i) :
    sumToRanges R κ W (DirectSum.lof R κ W i a)
      = DirectSum.lof R κ (fun i => ↥(LinearMap.range (DirectSum.lof R κ W i))) i
          ⟨DirectSum.lof R κ W i a, ⟨a, rfl⟩⟩ := by
  rw [sumToRanges, DirectSum.toModule_lof]; rfl

/-- @census none (helper; engine `E2`) -/
theorem coe_sumToRanges (x : DirectSum κ W) :
    DirectSum.coeLinearMap (fun i => LinearMap.range (DirectSum.lof R κ W i))
      (sumToRanges R κ W x) = x := by
  induction x using DirectSum.induction_on with
  | zero => simp
  | of i a =>
      show DirectSum.coeLinearMap _ (sumToRanges R κ W (DirectSum.lof R κ W i a)) = _
      rw [sumToRanges_lof]
      exact DirectSum.coeLinearMap_of _ i _
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-- @census none (helper; engine `E2`) -/
theorem sumToRanges_coe (y : DirectSum κ (fun i => ↥(LinearMap.range (DirectSum.lof R κ W i)))) :
    sumToRanges R κ W
      (DirectSum.coeLinearMap (fun i => LinearMap.range (DirectSum.lof R κ W i)) y) = y := by
  induction y using DirectSum.induction_on with
  | zero => simp
  | of i w =>
      obtain ⟨a, ha⟩ := w.2
      rw [DirectSum.coeLinearMap_of,
        show ((w : DirectSum κ W)) = DirectSum.lof R κ W i a from ha.symm, sumToRanges_lof]
      exact congrArg _ (Subtype.ext ha)
  | add x y hx hy => rw [map_add, map_add, hx, hy]

/-- **The graded-carrier lemma**: the ranges of the canonical injections of `⨁ᵢ Wᵢ` form an
internal direct-sum decomposition of it.  @census none (helper; engine `E2`) -/
theorem isInternal_range_lof :
    DirectSum.IsInternal (fun i => LinearMap.range (DirectSum.lof R κ W i)) := by
  have hco : ∀ z, DirectSum.coeAddMonoidHom (fun i => LinearMap.range (DirectSum.lof R κ W i)) z
      = DirectSum.coeLinearMap (fun i => LinearMap.range (DirectSum.lof R κ W i)) z := fun _ => rfl
  constructor
  · intro a b hab
    have h := congrArg (sumToRanges R κ W) hab
    rwa [hco, hco, sumToRanges_coe, sumToRanges_coe] at h
  · intro x
    exact ⟨sumToRanges R κ W x, coe_sumToRanges R κ W x⟩

end Internal

end RationalQuivers.Gelfand

namespace RationalQuivers.Gelfand.Split

open RationalQuivers.HC RationalQuivers.Gelfand CategoryTheory

/-! ## `HC_λ(𝔤,K)_F` for a split torus -/

/-- An object of `HC_λ(𝔤,K)_F` for a characteristic-zero field `F` over which `K` splits: S8's
`HCQiObj ℓ` with `ℚ[√-1]` replaced by `F`.  @census none (helper; WP-8c) -/
structure HCFObj (F : Type) [Field F] [CharZero F] (ℓ : ℕ) : Type 1 where
  /-- the underlying `F`-vector space -/
  carrier : Type
  [addCommGroup : AddCommGroup carrier]
  [module : Module F carrier]
  /-- `M = ⨁ M_n` with the triple acting -/
  weight : WeightData F carrier
  /-- `λ = ℓ²` -/
  gic : HasGeneralizedInfinitesimalCharacter weight ℓ
  /-- admissibility -/
  admissible : ∀ n : ℤ, FiniteDimensional F (weight.comp n)
  /-- the central character -/
  centralCharacter : ∀ n : ℤ, (n - ((ℓ : ℤ) - 1)) % 2 ≠ 0 → weight.comp n = ⊥
  /-- finite generation -/
  fg : weight.IsFG

attribute [instance] HCFObj.addCommGroup HCFObj.module

/-- A morphism of `HC_λ(𝔤,K)_F`.  @census none (helper; WP-8c) -/
structure HCFHom {F : Type} [Field F] [CharZero F] {ℓ : ℕ} (A B : HCFObj F ℓ) where
  toLinearMap : A.carrier →ₗ[F] B.carrier
  map_H : ∀ v, toLinearMap (A.weight.H v) = B.weight.H (toLinearMap v)
  map_X : ∀ v, toLinearMap (A.weight.X v) = B.weight.X (toLinearMap v)
  map_Y : ∀ v, toLinearMap (A.weight.Y v) = B.weight.Y (toLinearMap v)
  map_comp : ∀ (n : ℤ) (v : A.carrier), v ∈ A.weight.comp n →
    toLinearMap v ∈ B.weight.comp n

namespace HCFHom

variable {F : Type} [Field F] [CharZero F] {ℓ : ℕ} {A B : HCFObj F ℓ}

@[ext] theorem hom_ext {f g : HCFHom A B} (h : f.toLinearMap = g.toLinearMap) : f = g := by
  cases f; cases g; simp_all

end HCFHom

/-- **`HC_λ(𝔤,K)_F`** as a category.  @census none (helper; WP-8c) -/
abbrev HCF (F : Type) [Field F] [CharZero F] (ℓ : ℕ) : Type 1 := HCFObj F ℓ

noncomputable instance (F : Type) [Field F] [CharZero F] (ℓ : ℕ) : Category (HCF F ℓ) where
  Hom A B := HCFHom A B
  id A := ⟨LinearMap.id, fun _ => rfl, fun _ => rfl, fun _ => rfl, fun _ _ h => h⟩
  comp f g :=
    ⟨g.toLinearMap.comp f.toLinearMap,
      fun v => by simp [f.map_H, g.map_H],
      fun v => by simp [f.map_X, g.map_X],
      fun v => by simp [f.map_Y, g.map_Y],
      fun n v hv => g.map_comp n _ (f.map_comp n v hv)⟩
  id_comp _ := by apply HCFHom.hom_ext; rfl
  comp_id _ := by apply HCFHom.hom_ext; rfl
  assoc _ _ _ := by apply HCFHom.hom_ext; rfl

/-! ## `HCLambda ℓ F ≌ HCF F ℓ` (copy of S10's `hcLambdaQiEquiv`) -/

section Comparison

variable (F : Type) [Field F] [CharZero F]

/-- The comparison functor `HCLambda ℓ F ⥤ HCF F ℓ`.  @census none (helper; WP-8c) -/
noncomputable def hcLambdaToF (ℓ : ℕ) : HCLambda.{0} ℓ F ⥤ HCF F ℓ where
  obj A :=
    { carrier := A.obj.carrier
      weight := A.obj.weight
      gic := A.obj.gic
      admissible := A.obj.admissible
      centralCharacter := A.property
      fg := A.obj.fg }
  map f :=
    { toLinearMap := f.hom.toLinearMap
      map_H := f.hom.map_H
      map_X := f.hom.map_X
      map_Y := f.hom.map_Y
      map_comp := fun n v hv =>
        WeightData.map_comp_of_map_H _ _ f.hom.toLinearMap f.hom.map_H n v hv }
  map_id _ := by apply HCFHom.hom_ext; rfl
  map_comp _ _ := by apply HCFHom.hom_ext; rfl

theorem hcLambdaToF_faithful (ℓ : ℕ) : (hcLambdaToF F ℓ).Faithful := by
  constructor
  intro A B f g h
  apply CategoryTheory.ObjectProperty.hom_ext
  apply HCHomOver.hom_ext
  exact congrArg HCFHom.toLinearMap h

theorem hcLambdaToF_full (ℓ : ℕ) : (hcLambdaToF F ℓ).Full := by
  constructor
  intro A B u
  refine ⟨⟨{ toLinearMap := u.toLinearMap
             map_H := u.map_H
             map_X := u.map_X
             map_Y := u.map_Y }⟩, ?_⟩
  apply HCFHom.hom_ext
  rfl

/-- The object map back.  @census none (helper; WP-8c) -/
noncomputable def hcFToLambdaObj (ℓ : ℕ) (B : HCF F ℓ) : HCLambda.{0} ℓ F :=
  ⟨{ carrier := B.carrier
     weight := B.weight
     gic := B.gic
     fg := B.fg
     admissible := B.admissible }, B.centralCharacter⟩

theorem hcLambdaToF_essSurj (ℓ : ℕ) : (hcLambdaToF F ℓ).EssSurj := by
  constructor
  intro B
  exact ⟨hcFToLambdaObj F ℓ B, ⟨eqToIso rfl⟩⟩

/-- **`HCLambda ℓ F ≌ HCF F ℓ`**, functor `hcLambdaToF`.  @census none (helper; WP-8c) -/
noncomputable def hcLambdaFEquiv (ℓ : ℕ) : HCLambda.{0} ℓ F ≌ HCF F ℓ := by
  haveI := hcLambdaToF_full F ℓ
  haveI := hcLambdaToF_faithful F ℓ
  haveI := hcLambdaToF_essSurj F ℓ
  haveI : (hcLambdaToF F ℓ).IsEquivalence := { }
  exact (hcLambdaToF F ℓ).asEquivalence

end Comparison

/-! ## `HC/Normalization.lean`'s helpers over `F` -/

section Normalization

variable {F : Type} [Field F]

/-- `γ_⋆ = (ℓ-1)!` inside `F`.  @census none (helper; WP-8c) -/
noncomputable def gammaStarF (F : Type) [Field F] (ℓ : ℕ) : F := ((Nat.factorial (ℓ - 1) : ℕ) : F)

theorem gammaStarF_eq (ℓ : ℕ) : gammaStarF F ℓ = ((Nat.factorial (ℓ - 1) : ℕ) : F) := rfl

theorem gammaStarF_ne_zero [CharZero F] (ℓ : ℕ) : gammaStarF F ℓ ≠ 0 :=
  Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)

theorem four_pow_ne_zero [CharZero F] (m : ℕ) : ((4 : F) ^ m) ≠ 0 :=
  pow_ne_zero _ (by norm_num)

variable {Mi : Type} [AddCommGroup Mi] [Module F Mi]

theorem bijective_of_isUnit_end {N : Type} [AddCommGroup N] [Module F N]
    {g : Module.End F N} (hg : IsUnit g) : Function.Bijective g := by
  obtain ⟨u, rfl⟩ := hg
  constructor
  · intro a b hab
    have h := congrArg (fun w => (u.inv : Module.End F N) w) hab
    simpa only [← Module.End.mul_apply, u.inv_val, Module.End.one_apply] using h
  · intro b
    refine ⟨(u.inv : Module.End F N) b, ?_⟩
    have : ((u : Module.End F N) * u.inv) b = b := by rw [u.val_inv]; rfl
    simpa only [Module.End.mul_apply] using this

theorem bijOn_scalar_add_nilpotent (P : Submodule F Mi) (c : F) (hc : c ≠ 0)
    (nn : Module.End F Mi) (hnil : IsNilpotent nn) (hmaps : ∀ v ∈ P, nn v ∈ P)
    (f : Mi → Mi) (hf : ∀ v ∈ P, f v = c • v + nn v) :
    Set.BijOn f ↑P ↑P := by
  set A : Module.End F Mi := c • 1 + nn with hA
  have hAmaps : ∀ v ∈ P, A v ∈ P := by
    intro v hv
    show (c • (1 : Module.End F Mi) + nn) v ∈ P
    rw [LinearMap.add_apply, LinearMap.smul_apply, Module.End.one_apply]
    exact add_mem (Submodule.smul_mem _ _ hv) (hmaps v hv)
  have hnP : IsNilpotent (LinearMap.restrict nn hmaps) := Module.End.isNilpotent.restrict hmaps hnil
  have hres : LinearMap.restrict A hAmaps = c • 1 + LinearMap.restrict nn hmaps := by
    ext w
    show ((A w.1 : Mi)) = _
    simp [hA, LinearMap.restrict_apply]
  have hunit : IsUnit (LinearMap.restrict A hAmaps) := by
    rw [hres]
    have hfac : (c • (1 : Module.End F P) + LinearMap.restrict nn hmaps)
        = (c • (1 : Module.End F P)) * (1 + c⁻¹ • LinearMap.restrict nn hmaps) := by
      rw [mul_add, mul_one, smul_mul_assoc, one_mul, smul_smul, mul_inv_cancel₀ hc, one_smul]
    rw [hfac]
    exact (Unipotent.isUnit_smul_one_end hc).mul
      (Unipotent.isUnit_one_add_of_isNilpotent (hnP.smul c⁻¹))
  have hbij : Set.BijOn A ↑P ↑P := by
    have hb := bijective_of_isUnit_end hunit
    refine ⟨fun v hv => hAmaps v hv, ?_, ?_⟩
    · intro a ha b hb' hab
      have := hb.1 (a₁ := ⟨a, ha⟩) (a₂ := ⟨b, hb'⟩) (by apply Subtype.ext; simpa using hab)
      exact congrArg Subtype.val this
    · intro b hb'
      obtain ⟨a, ha⟩ := hb.2 ⟨b, hb'⟩
      exact ⟨a.1, a.2, congrArg Subtype.val ha⟩
  refine hbij.congr ?_
  intro v hv
  rw [hf v hv]
  show _ = (c • (1 : Module.End F Mi) + nn) v
  rw [LinearMap.add_apply, LinearMap.smul_apply, Module.End.one_apply]

end Normalization

open RationalQuivers.HC RationalQuivers.Gelfand



variable {F : Type} [Field F] [CharZero F]

variable {ℓ : ℕ} {Mi : Type} [AddCommGroup Mi] [Module F Mi]

/-! ### The datum the construction consumes -/

/-- The `ℚ[√-1]`-rational `(𝔤,K)`-module datum of §5.1: a weight decomposition with the `𝔰𝔩₂`
triple acting, and a generalized infinitesimal character `λ = ℓ²`.

This is `HC.RationalSetup`'s `weight` + `gic` fragment, with the descent data (`baseChange`,
`conj`) deliberately absent — see the module docstring, design decision `D-S8-1`, and census clause
`RQ-5.01-C9`.

@census    none (auxiliary; carries the hypotheses of `RQ-5.01-H1`/`RQ-5.01-H2` for the whole stage)
@source    UNLABELED-EQi-construction
@imports   none
@divergence none -/
structure QiSetup (F : Type) [Field F] [CharZero F] (ℓ : ℕ) (Mi : Type) [AddCommGroup Mi] [Module F Mi] where
  /-- `M_n := M_{ℚ[√-1]}[χ_n]` together with `H`, `X`, `Y` (census `RQ-5.01-C5`'s source). -/
  weight : WeightData F Mi
  /-- `λ = ℓ²`: the generalized infinitesimal character (census clause `RQ-5.01-H1`). -/
  gic : HasGeneralizedInfinitesimalCharacter weight ℓ


/-- The weight datum of an object of the concrete `HC_λ(𝔤,K)_{ℚ[√-1]}` (`Gelfand/Category.lean`),
as the `QiSetup` §5.1's construction consumes. -/
abbrev HCFObj.setup (A : HCFObj F ℓ) : QiSetup F ℓ A.carrier :=
  ⟨A.weight, A.gic⟩

namespace QiSetup

variable (Q : QiSetup F ℓ Mi)

/-- `M_n = M_{ℚ[√-1]}[χ_n]`. -/
abbrev comp (n : ℤ) : Submodule F Mi := Q.weight.comp n

/-- `X` acting on `M_{ℚ[√-1]}`. -/
abbrev X : Module.End F Mi := Q.weight.X

/-- `Y` acting on `M_{ℚ[√-1]}`. -/
abbrev Y : Module.End F Mi := Q.weight.Y

end QiSetup

/-! ### The normalized operators, read off the weight datum alone

`HC/Normalization.lean` defines `X⋆`, `Y⋆`, `T₊`, `T₋` on a `HC.RationalSetup`.  The four `def`s
below are the same expressions on a `QiSetup`; the four `rfl` bridges immediately after are the
evidence that no notion has been restated (`CONVENTIONS.md` §6 rung 2, `MATHLIB-DECISIONS.tsv`
row `MD-S8-01`). -/

/-- `X⋆ := γ⋆⁻¹ · X^{ℓ-1}` (`RQ-3.08-C1`). -/
noncomputable def xStar (Q : QiSetup F ℓ Mi) : Module.End F Mi :=
  (gammaStarF F ℓ)⁻¹ • Q.weight.X ^ (ℓ - 1)

/-- `Y⋆ := γ⋆⁻¹ · Y^{ℓ-1}` (`RQ-3.08-C2`). -/
noncomputable def yStar (Q : QiSetup F ℓ Mi) : Module.End F Mi :=
  (gammaStarF F ℓ)⁻¹ • Q.weight.Y ^ (ℓ - 1)

/-- `T₊ := (4^{ℓ-1}·γ⋆²)⁻¹ · ∏_{j<ℓ-1}(C − (ℓ−2−2j)²)` (`RQ-3.07-C1`) — **the prefactor
`eq:T_plus_def` prints** since the paper author's ruling of 2026-09-11 on `AN-35`.

Until that ruling the display read `γ⋆⁻²`, under which `T₊ = 4^{ℓ-1}·𝟏 + n` and every `§5` square
that multiplies through `T_±` was false for `ℓ ≥ 2`; this copy carried the correction of coordinator
ruling `R-S7-9` (finding `F-S7-G4-1`) as a disclosed reformulation, which `HC/Normalization.lean`'s
retirement note records in full.  **Repair `V-S8-10`, 2026-09-02:** this copy formerly carried the
then-displayed prefactor and its `rfl` bridge `tPlus_eq` to `HC.Tplus` broke on the merge of
`stage/S7` at `493697a` (ruling `R-S8-8`); it has carried the ruled one since, and the bridge is
`rfl` again. -/
noncomputable def tPlus (Q : QiSetup F ℓ Mi) : Module.End F Mi :=
  ((4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2)⁻¹
    • casimirFactorProd Q.weight.casimir ((ℓ : ℤ) - 2) (ℓ - 1)

/-- `T₋` (`RQ-3.07-C2`), prefactor `(4^{ℓ-1}·γ⋆²)⁻¹` — the one `eq:T_minus_def` prints since the
author's ruling of 2026-09-11; see `tPlus`. -/
noncomputable def tMinus (Q : QiSetup F ℓ Mi) : Module.End F Mi :=
  ((4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2)⁻¹
    • casimirFactorProd Q.weight.casimir ((ℓ : ℤ) - 2) (ℓ - 1)



/-! ### Weight bookkeeping -/

/-- `X : M_m → M_n` whenever `m + 2 = n`. -/
theorem x_mem {Q : QiSetup F ℓ Mi} {m n : ℤ} (h : m + 2 = n) {v : Mi} (hv : v ∈ Q.comp m) :
    Q.X v ∈ Q.comp n := by
  subst h; exact Q.weight.X_mem m v hv

/-- `Y : M_m → M_n` whenever `m - 2 = n`. -/
theorem y_mem {Q : QiSetup F ℓ Mi} {m n : ℤ} (h : m - 2 = n) {v : Mi} (hv : v ∈ Q.comp m) :
    Q.Y v ∈ Q.comp n := by
  subst h; exact Q.weight.Y_mem m v hv

/-- `X^k : M_m → M_{m + 2k}`. -/
theorem xpow_mem {Q : QiSetup F ℓ Mi} (k : ℕ) {m n : ℤ} (h : m + 2 * k = n) {v : Mi}
    (hv : v ∈ Q.comp m) : (Q.X ^ k) v ∈ Q.comp n := by
  induction k generalizing n with
  | zero => simpa [show n = m by omega] using hv
  | succ j ih =>
      have h1 : ((Q.X ^ j) v) ∈ Q.comp (m + 2 * j) := ih rfl
      have hx := x_mem (Q := Q) (m := m + 2 * j) (n := n) (by push_cast at h ⊢; omega) h1
      simpa [pow_succ', Module.End.mul_apply] using hx

/-- `Y^k : M_m → M_{m - 2k}`. -/
theorem ypow_mem {Q : QiSetup F ℓ Mi} (k : ℕ) {m n : ℤ} (h : m - 2 * k = n) {v : Mi}
    (hv : v ∈ Q.comp m) : (Q.Y ^ k) v ∈ Q.comp n := by
  induction k generalizing n with
  | zero => simpa [show n = m by omega] using hv
  | succ j ih =>
      have h1 : ((Q.Y ^ j) v) ∈ Q.comp (m - 2 * j) := ih rfl
      have hy := y_mem (Q := Q) (m := m - 2 * j) (n := n) (by push_cast at h ⊢; omega) h1
      simpa [pow_succ', Module.End.mul_apply] using hy

/-- `X⋆ : M_m → M_{m + 2(ℓ-1)}`. -/
theorem xStar_mem {Q : QiSetup F ℓ Mi} {m n : ℤ} (h : m + 2 * ((ℓ : ℤ) - 1) = n) (hℓ : 1 ≤ ℓ)
    {v : Mi} (hv : v ∈ Q.comp m) : xStar Q v ∈ Q.comp n := by
  have hk : (m : ℤ) + 2 * ((ℓ - 1 : ℕ) : ℤ) = n := by
    have : ((ℓ - 1 : ℕ) : ℤ) = (ℓ : ℤ) - 1 := by omega
    rw [this]; exact h
  exact Submodule.smul_mem _ _ (xpow_mem (Q := Q) (ℓ - 1) hk hv)

/-- `Y⋆ : M_m → M_{m - 2(ℓ-1)}`. -/
theorem yStar_mem {Q : QiSetup F ℓ Mi} {m n : ℤ} (h : m - 2 * ((ℓ : ℤ) - 1) = n) (hℓ : 1 ≤ ℓ)
    {v : Mi} (hv : v ∈ Q.comp m) : yStar Q v ∈ Q.comp n := by
  have hk : (m : ℤ) - 2 * ((ℓ - 1 : ℕ) : ℤ) = n := by
    have : ((ℓ - 1 : ℕ) : ℤ) = (ℓ : ℤ) - 1 := by omega
    rw [this]; exact h
  exact Submodule.smul_mem _ _ (ypow_mem (Q := Q) (ℓ - 1) hk hv)


/-! ### The invertibility data of census clause `RQ-5.01-H3` -/

/-- The negative powers appearing in §5.1's first two displays: two-sided inverses of `X^{ℓ-1}` and
`Y^{ℓ-1}` **on the weight components they are asserted invertible on**.

This is the faithful rendering of census clause `RQ-5.01-H3` — a *hypothesis* clause: "`X^{ℓ-1}`
and `Y^{ℓ-1}` are invertible on the relevant weight spaces (`RQ-3.06`), so the negative powers
appearing in the first diagram are defined."  `RQ-3.06` supplies it in the source; in the tree it
is the conclusion of S7's `HC.isUnit_pow_X` (stated over `ℚ[√-1]` only), and this field-generic copy
keeps the frozen original's shape of carrying it as data.  *(Corrected 2026-10-02, docstring-only,
`V1-09`: this text, copied from S8, called `HC.isUnit_pow_X` `sorry`-bodied, which it no longer
is.)*

@census    none (auxiliary; carries census clause `RQ-5.01-H3`)
@source    UNLABELED-EQi-construction
@imports   none
@divergence none -/
structure StarInverses (Q : QiSetup F ℓ Mi) where
  /-- `X^{-(ℓ-1)} : M_{ℓ-1} → M_{-(ℓ-1)}`. -/
  xInv : Module.End F Mi
  /-- `Y^{-(ℓ-1)} : M_{-(ℓ-1)} → M_{ℓ-1}`. -/
  yInv : Module.End F Mi
  xInv_mem : ∀ v ∈ Q.comp ((ℓ : ℤ) - 1), xInv v ∈ Q.comp (-((ℓ : ℤ) - 1))
  yInv_mem : ∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), yInv v ∈ Q.comp ((ℓ : ℤ) - 1)
  xInv_left : ∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), xInv ((Q.X ^ (ℓ - 1)) v) = v
  xInv_right : ∀ v ∈ Q.comp ((ℓ : ℤ) - 1), (Q.X ^ (ℓ - 1)) (xInv v) = v
  yInv_left : ∀ v ∈ Q.comp ((ℓ : ℤ) - 1), yInv ((Q.Y ^ (ℓ - 1)) v) = v
  yInv_right : ∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), (Q.Y ^ (ℓ - 1)) (yInv v) = v

namespace StarInverses

variable {Q : QiSetup F ℓ Mi}

/-- `X⋆⁻¹ = γ⋆ · X^{-(ℓ-1)} : M_{ℓ-1} → M_{-(ℓ-1)}`, the inverse of `xStar`. -/
noncomputable def xStarInv (I : StarInverses Q) : Module.End F Mi :=
  gammaStarF F ℓ • I.xInv

/-- `Y⋆⁻¹ = γ⋆ · Y^{-(ℓ-1)} : M_{-(ℓ-1)} → M_{ℓ-1}`, the inverse of `yStar`. -/
noncomputable def yStarInv (I : StarInverses Q) : Module.End F Mi :=
  gammaStarF F ℓ • I.yInv

theorem xStarInv_mem (I : StarInverses Q) {v : Mi} (hv : v ∈ Q.comp ((ℓ : ℤ) - 1)) :
    I.xStarInv v ∈ Q.comp (-((ℓ : ℤ) - 1)) :=
  Submodule.smul_mem _ _ (I.xInv_mem v hv)

theorem yStarInv_mem (I : StarInverses Q) {v : Mi} (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    I.yStarInv v ∈ Q.comp ((ℓ : ℤ) - 1) :=
  Submodule.smul_mem _ _ (I.yInv_mem v hv)

end StarInverses

/-! ### The comparison diagram `𝔼_{ℚ[√-1]}(M_{ℚ[√-1]})` -/

section EQi

variable (Q : QiSetup F ℓ Mi) (I : StarInverses Q) (hℓ : 1 ≤ ℓ)

/-- `M(-) := M_{ℚ[√-1]}[χ_{-(ℓ+1)}]` (census clause `RQ-5.01-C5`). -/
abbrev vMinus : Submodule F Mi := Q.comp (-((ℓ : ℤ) + 1))

/-- `M(⋆) := M_{ℚ[√-1]}[χ_{-(ℓ-1)}]` (census clause `RQ-5.01-C5`). -/
abbrev vStar : Submodule F Mi := Q.comp (-((ℓ : ℤ) - 1))

/-- `M(+) := M_{ℚ[√-1]}[χ_{ℓ+1}]` (census clause `RQ-5.01-C5`). -/
abbrev vPlus : Submodule F Mi := Q.comp ((ℓ : ℤ) + 1)

/-- `φ_{a₋} := X : M(-) → M(⋆)` (census clause `RQ-5.01-C6`). -/
noncomputable def phiAMinus : vMinus Q →ₗ[F] vStar Q :=
  Q.X.restrict fun _ hv => x_mem (Q := Q) (by ring) hv

/-- `φ_{b₋} := Y : M(⋆) → M(-)` (census clause `RQ-5.01-C6`). -/
noncomputable def phiBMinus : vStar Q →ₗ[F] vMinus Q :=
  Q.Y.restrict fun _ hv => y_mem (Q := Q) (by ring) hv

/-- `φ_{b₊} := X X⋆ : M(⋆) → M(+)` (census clause `RQ-5.01-C6`). -/
noncomputable def phiBPlus : vStar Q →ₗ[F] vPlus Q :=
  (Q.X.comp (xStar Q)).restrict fun _ hv =>
    x_mem (Q := Q) (m := (ℓ : ℤ) - 1) (by ring) (xStar_mem (Q := Q) (by ring) hℓ hv)

/-- `φ_{a₊} := X⋆⁻¹ Y : M(+) → M(⋆)` (census clause `RQ-5.01-C6`). -/
noncomputable def phiAPlus : vPlus Q →ₗ[F] vStar Q :=
  ((I.xStarInv).comp Q.Y).restrict fun _ hv =>
    I.xStarInv_mem (y_mem (Q := Q) (m := (ℓ : ℤ) + 1) (by ring) hv)

/-! The relation `RQ-5.01-C7` is proved here, immediately after `E_Qi`, rather than in the
`RQ-5.01` claims section below: `E_F_rep_relation` (the same identity read in the
representation) needs it and is stated earlier in the file.  Position only — the statement,
docstring and proof are unchanged (moved 2026-09-03, `s8-g4-impl`, G4). -/

/-- `φ_{a₋} ∘ φ_{b₋} = φ_{a₊} ∘ φ_{b₊}` — census clause `RQ-5.01-C7`, the identity the source says
"shows that we have indeed defined a nilpotent `ℚ[√-1]`-rational quiver representation".

**Proved at G2** (repair `V-S8-1`, ruling `R-S8-7`): the real-gate inhabitant
`gelfandFactsReal` of `Imports.ABR.GelfandFacts` (`Gelfand/Models.lean`) needs exactly this
identity for its `relation` field, and a G5 witness may not be `sorry`-bodied.  The content is
`Y X^{ℓ} = X^{ℓ} Y` on `M_{-(ℓ-1)}` (`WeightData.Y_pow_X_succ_apply` at `n = -(ℓ-1)`, `k+1 = ℓ`),
after which `X^{-(ℓ-1)}` cancels `X^{ℓ-1}` by `StarInverses.xInv_left`.

@census    none (auxiliary; discharges census clause `RQ-5.01-C7`)
@source    UNLABELED-EQi-construction
(clauses of the frozen original:)   RQ-5.01-C7
@imports   none
@divergence none
@clauses   RQ2-5.02-S-O7b -/
theorem E_F_relation :
    (phiAMinus Q).comp (phiBMinus Q) = (phiAPlus Q I).comp (phiBPlus Q hℓ) := by
  obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
  have hk : (k + 1 - 1 : ℕ) = k := by omega
  refine LinearMap.ext fun ⟨v, hv⟩ => Subtype.ext ?_
  show Q.X (Q.Y v) = I.xStarInv (Q.Y (Q.X (xStar Q v)))
  have hγ : gammaStarF F (k + 1) ≠ 0 := gammaStarF_ne_zero _
  rw [StarInverses.xStarInv, xStar, hk, LinearMap.smul_apply, LinearMap.smul_apply, map_smul,
    map_smul, map_smul, smul_smul, mul_inv_cancel₀ hγ, one_smul,
    ← Module.End.mul_apply (f := Q.X) (g := Q.X ^ k), ← pow_succ']
  have hv' : v ∈ Q.weight.comp (-(((k + 1 : ℕ) : ℤ) - 1)) := hv
  rw [Q.weight.Y_pow_X_succ_apply k _ v hv']
  have hc : (((k + 1 : ℕ) : F)
      * ((((-(((k + 1 : ℕ) : ℤ) - 1)) : ℤ) : F) + (k : F))) = 0 := by
    push_cast; ring
  rw [hc, zero_smul, sub_zero, pow_succ, Module.End.mul_apply]
  have h := I.xInv_left _ (x_mem (Q := Q) (m := (-(((k + 1 : ℕ) : ℤ) - 1)) - 2) (by ring)
    (y_mem (Q := Q) rfl hv))
  rw [hk] at h
  exact h.symm

end EQi

/-! ### The canonical inverses: `RQ-3.06` for a descent-free module

`cor:X_Y_inverses` (S7's `HC.isUnit_pow_X`, proved on the merged tree) is stated on a
`RationalSetup`, but its proof uses only the weight datum and the character.  The functor
`𝔼_{ℚ[√-1]}` must be defined on **every** object of `HC_λ(𝔤,K)_{ℚ[√-1]}` (clause `RQ-5.01-C9`),
descending or not, so the same argument is replayed here on a `QiSetup` and packaged as the
canonical `StarInverses` of every `QiSetup` at `ℓ ≥ 1` (`QiSetup.starInverses`).  The `RQ-5.01`
statements keep an explicit `I : StarInverses Q` — clause `RQ-5.01-H3` is a *hypothesis* clause —
and `starInverses_eq` records that any two agree on the components. -/

section CanonicalInverses

variable (Q : QiSetup F ℓ Mi)

/-- The named nilpotent remainder of `cor:X_Y_inverses` on a `QiSetup` (S7's `HC.normRemainder`,
descent-free).  @census none (helper) -/
noncomputable def qiRemainder : Module.End F Mi :=
  (((4 : F) ^ (ℓ - 1))⁻¹) •
    (casimirFactorProd Q.weight.casimir ((ℓ : ℤ) - 2) (ℓ - 1)
      - (nilpScalar ℓ ((ℓ : ℤ) - 2) (ℓ - 1) F) • 1)

theorem QiSetup.gic_nilpotent :
    IsNilpotent (Q.weight.casimir - (((ℓ : F)) ^ 2) • (1 : Module.End F Mi)) := by
  have h : IsNilpotent (Q.weight.casimir
      - (algebraMap ℚ F ((ℓ : ℚ) ^ 2)) • (1 : Module.End F Mi)) := Q.gic
  have he : (algebraMap ℚ F ((ℓ : ℚ) ^ 2)) = ((ℓ : F)) ^ 2 := by
    rw [map_pow, map_natCast]
  rwa [he] at h

theorem isNilpotent_qiRemainder : IsNilpotent (qiRemainder Q) :=
  (isNilpotent_casimirRemainder Q.weight ℓ ((ℓ : ℤ) - 2) (ℓ - 1) Q.gic_nilpotent).smul _

theorem qiRemainder_apply (v : Mi) :
    qiRemainder Q v = (((4 : F) ^ (ℓ - 1))⁻¹) •
      (casimirFactorProd Q.weight.casimir ((ℓ : ℤ) - 2) (ℓ - 1) v
        - (nilpScalar ℓ ((ℓ : ℤ) - 2) (ℓ - 1) F) • v) := by
  rw [qiRemainder, LinearMap.smul_apply, LinearMap.sub_apply, LinearMap.smul_apply,
    Module.End.one_apply]

theorem qiRemainder_mem_comp (n : ℤ) (v : Mi) (hv : v ∈ Q.comp n) :
    qiRemainder Q v ∈ Q.comp n := by
  rw [qiRemainder_apply]
  exact Submodule.smul_mem _ _
    (sub_mem (casimirFactorProd_mem_comp Q.weight _ _ n v hv) (Submodule.smul_mem _ _ hv))

/-- `X^{ℓ-1} Y^{ℓ-1} = γ⋆²·𝟏 + n` on `M_{ℓ-1}` — `eq:XY_inverses_rel` on a `QiSetup`.
@census none (helper) -/
theorem pow_X_pow_Y_apply (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp ((ℓ : ℤ) - 1)) :
    (Q.X ^ (ℓ - 1) * Q.Y ^ (ℓ - 1)) v = gammaStarF F ℓ ^ 2 • v + qiRemainder Q v := by
  have hsc : nilpScalar ℓ ((ℓ : ℤ) - 2) (ℓ - 1) F
      = (4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2 := by
    rw [nilpScalar_gammaStar ℓ hℓ, gammaStarF_eq]
  have h4 : (((4 : F) ^ (ℓ - 1))⁻¹ * ((4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2))
      = gammaStarF F ℓ ^ 2 := by
    rw [← mul_assoc, inv_mul_cancel₀ (four_pow_ne_zero _), one_mul]
  have hv' : v ∈ Q.weight.comp (((ℓ : ℤ) - 2) + 1) := by
    have he : ((ℓ : ℤ) - 2) + 1 = (ℓ : ℤ) - 1 := by ring
    rwa [he]
  have h := pow_X_pow_Y_eq_prod_casimir Q.weight (ℓ - 1) ((ℓ : ℤ) - 2) v hv'
  rw [LinearMap.smul_apply] at h
  rw [qiRemainder_apply, hsc, ← h, smul_sub, smul_smul, smul_smul,
    inv_mul_cancel₀ (four_pow_ne_zero (ℓ - 1)), one_smul, h4]
  abel

/-- `Y^{ℓ-1} X^{ℓ-1} = γ⋆²·𝟏 + n̄` on `M_{-(ℓ-1)}`.  @census none (helper) -/
theorem pow_Y_pow_X_apply (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    (Q.Y ^ (ℓ - 1) * Q.X ^ (ℓ - 1)) v = gammaStarF F ℓ ^ 2 • v + qiRemainder Q v := by
  have hsc : nilpScalar ℓ ((ℓ : ℤ) - 2) (ℓ - 1) F
      = (4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2 := by
    rw [nilpScalar_gammaStar ℓ hℓ, gammaStarF_eq]
  have h4 : (((4 : F) ^ (ℓ - 1))⁻¹ * ((4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2))
      = gammaStarF F ℓ ^ 2 := by
    rw [← mul_assoc, inv_mul_cancel₀ (four_pow_ne_zero _), one_mul]
  have hv' : v ∈ Q.weight.comp (-(((ℓ : ℤ) - 2) + 1)) := by
    have he : -(((ℓ : ℤ) - 2) + 1) = -((ℓ : ℤ) - 1) := by ring
    rwa [he]
  have h := pow_Y_pow_X_eq_prod_casimir Q.weight (ℓ - 1) ((ℓ : ℤ) - 2) v hv'
  rw [LinearMap.smul_apply] at h
  rw [qiRemainder_apply, hsc, ← h, smul_sub, smul_smul, smul_smul,
    inv_mul_cancel₀ (four_pow_ne_zero (ℓ - 1)), one_smul, h4]
  abel

theorem xpow_maps (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    (Q.X ^ (ℓ - 1)) v ∈ Q.comp ((ℓ : ℤ) - 1) :=
  xpow_mem (Q := Q) (ℓ - 1) (by push_cast [Nat.cast_sub hℓ]; ring) hv

theorem ypow_maps (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp ((ℓ : ℤ) - 1)) :
    (Q.Y ^ (ℓ - 1)) v ∈ Q.comp (-((ℓ : ℤ) - 1)) :=
  ypow_mem (Q := Q) (ℓ - 1) (by push_cast [Nat.cast_sub hℓ]; ring) hv

/-- **`cor:X_Y_inverses` on a `QiSetup`** — `X^{ℓ-1} : M_{-(ℓ-1)} → M_{ℓ-1}` and
`Y^{ℓ-1} : M_{ℓ-1} → M_{-(ℓ-1)}` are bijections (S7's `HC.isUnit_pow_X`, descent-free).
@census none (helper)
@clauses   RQ2-5.02-S-O7e -/
theorem bijOn_pow_X (hℓ : 1 ≤ ℓ) :
    Set.BijOn (Q.X ^ (ℓ - 1)) (Q.comp (-((ℓ : ℤ) - 1))) (Q.comp ((ℓ : ℤ) - 1)) ∧
    Set.BijOn (Q.Y ^ (ℓ - 1)) (Q.comp ((ℓ : ℤ) - 1)) (Q.comp (-((ℓ : ℤ) - 1))) := by
  have hγ2 : gammaStarF F ℓ ^ 2 ≠ 0 := pow_ne_zero _ (gammaStarF_ne_zero ℓ)
  have hbXY : Set.BijOn (fun v => (Q.X ^ (ℓ - 1) * Q.Y ^ (ℓ - 1)) v)
      ↑(Q.comp ((ℓ : ℤ) - 1)) ↑(Q.comp ((ℓ : ℤ) - 1)) :=
    bijOn_scalar_add_nilpotent _ _ hγ2 _ (isNilpotent_qiRemainder Q) (qiRemainder_mem_comp Q _)
      _ (fun v hv => pow_X_pow_Y_apply Q hℓ v hv)
  have hbYX : Set.BijOn (fun v => (Q.Y ^ (ℓ - 1) * Q.X ^ (ℓ - 1)) v)
      ↑(Q.comp (-((ℓ : ℤ) - 1))) ↑(Q.comp (-((ℓ : ℤ) - 1))) :=
    bijOn_scalar_add_nilpotent _ _ hγ2 _ (isNilpotent_qiRemainder Q) (qiRemainder_mem_comp Q _)
      _ (fun v hv => pow_Y_pow_X_apply Q hℓ v hv)
  refine ⟨⟨fun v hv => xpow_maps Q hℓ v hv, ?_, ?_⟩, ⟨fun v hv => ypow_maps Q hℓ v hv, ?_, ?_⟩⟩
  · intro a ha b hb hab
    refine hbYX.2.1 ha hb ?_
    simp only [Module.End.mul_apply]
    rw [hab]
  · intro u hu
    obtain ⟨v, hv, hvu⟩ := hbXY.2.2 hu
    exact ⟨(Q.Y ^ (ℓ - 1)) v, ypow_maps Q hℓ v hv, by rw [← Module.End.mul_apply]; exact hvu⟩
  · intro a ha b hb hab
    refine hbXY.2.1 ha hb ?_
    simp only [Module.End.mul_apply]
    rw [hab]
  · intro u hu
    obtain ⟨v, hv, hvu⟩ := hbYX.2.2 hu
    exact ⟨(Q.X ^ (ℓ - 1)) v, xpow_maps Q hℓ v hv, by rw [← Module.End.mul_apply]; exact hvu⟩

/-- The restriction of `A` to a map between two components it connects.  @census none (helper) -/
noncomputable def compRestrict (A : Module.End F Mi) (p m : ℤ)
    (hA : Set.BijOn A (Q.comp p) (Q.comp m)) : Q.comp p →ₗ[F] Q.comp m :=
  A.restrict (p := Q.comp p) (q := Q.comp m) fun _ hv => hA.mapsTo hv

theorem compRestrict_bijective (A : Module.End F Mi) (p m : ℤ)
    (hA : Set.BijOn A (Q.comp p) (Q.comp m)) : Function.Bijective (compRestrict Q A p m hA) :=
  ⟨fun a b hab => Subtype.ext (hA.injOn a.2 b.2 (congrArg Subtype.val hab)),
    fun u => by
      obtain ⟨v, hv, hvu⟩ := hA.surjOn u.2
      exact ⟨⟨v, hv⟩, Subtype.ext hvu⟩⟩

/-- The inverse of a bijection between two components, extended by the projection to a global
endomorphism.  @census none (helper) -/
noncomputable def compInv (A : Module.End F Mi) (p m : ℤ)
    (hA : Set.BijOn A (Q.comp p) (Q.comp m)) : Module.End F Mi :=
  (Q.comp p).subtype ∘ₗ
    (LinearEquiv.ofBijective (compRestrict Q A p m hA)
      (compRestrict_bijective Q A p m hA)).symm.toLinearMap ∘ₗ
    LinearMap.codRestrict (Q.comp m) (Q.weight.proj m) (Q.weight.proj_mem m)

theorem compInv_mem (A : Module.End F Mi) (p m : ℤ)
    (hA : Set.BijOn A (Q.comp p) (Q.comp m)) (v : Mi) : compInv Q A p m hA v ∈ Q.comp p :=
  Subtype.mem _

theorem compInv_left (A : Module.End F Mi) (p m : ℤ)
    (hA : Set.BijOn A (Q.comp p) (Q.comp m)) (v : Mi) (hv : v ∈ Q.comp p) :
    compInv Q A p m hA (A v) = v := by
  simp only [compInv, LinearMap.comp_apply, Submodule.subtype_apply, LinearEquiv.coe_coe]
  have h1 : LinearMap.codRestrict (Q.comp m) (Q.weight.proj m) (Q.weight.proj_mem m) (A v)
      = compRestrict Q A p m hA ⟨v, hv⟩ :=
    Subtype.ext (Q.weight.proj_of_mem_same (hA.mapsTo hv))
  rw [h1]
  exact congrArg Subtype.val
    ((LinearEquiv.ofBijective _ (compRestrict_bijective Q A p m hA)).symm_apply_apply ⟨v, hv⟩)

theorem compInv_right (A : Module.End F Mi) (p m : ℤ)
    (hA : Set.BijOn A (Q.comp p) (Q.comp m)) (v : Mi) (hv : v ∈ Q.comp m) :
    A (compInv Q A p m hA v) = v := by
  simp only [compInv, LinearMap.comp_apply, Submodule.subtype_apply, LinearEquiv.coe_coe]
  have h1 : LinearMap.codRestrict (Q.comp m) (Q.weight.proj m) (Q.weight.proj_mem m) v
      = ⟨v, hv⟩ := Subtype.ext (Q.weight.proj_of_mem_same hv)
  rw [h1]
  exact congrArg Subtype.val
    ((LinearEquiv.ofBijective _ (compRestrict_bijective Q A p m hA)).apply_symm_apply
      (⟨v, hv⟩ : Q.comp m))

/-- **The canonical `StarInverses` of every `QiSetup` at `ℓ ≥ 1`** — `cor:X_Y_inverses`
(`RQ-3.06`) supplies the data clause `RQ-5.01-H3` asks for.  This is what lets `𝔼_{ℚ[√-1]}` be
a functor on all of `HC_λ(𝔤,K)_{ℚ[√-1]}`.  @census none (helper) -/
noncomputable def QiSetup.starInverses (hℓ : 1 ≤ ℓ) : StarInverses Q where
  xInv := compInv Q (Q.X ^ (ℓ - 1)) _ _ (bijOn_pow_X Q hℓ).1
  yInv := compInv Q (Q.Y ^ (ℓ - 1)) _ _ (bijOn_pow_X Q hℓ).2
  xInv_mem := fun v _ => compInv_mem Q _ _ _ _ v
  yInv_mem := fun v _ => compInv_mem Q _ _ _ _ v
  xInv_left := fun v hv => compInv_left Q _ _ _ _ v hv
  xInv_right := fun v hv => compInv_right Q _ _ _ _ v hv
  yInv_left := fun v hv => compInv_left Q _ _ _ _ v hv
  yInv_right := fun v hv => compInv_right Q _ _ _ _ v hv

/-- Any two `StarInverses` agree on the components: the data of `RQ-5.01-H3` is a property.
@census none (helper) -/
theorem starInverses_eq (I I' : StarInverses Q) :
    (∀ v ∈ Q.comp ((ℓ : ℤ) - 1), I.xInv v = I'.xInv v) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), I.yInv v = I'.yInv v) := by
  constructor
  · intro v hv
    have h1 := I'.xInv_right v hv
    rw [← h1, I.xInv_left _ (I'.xInv_mem v hv), h1]
  · intro v hv
    have h1 := I'.yInv_right v hv
    rw [← h1, I.yInv_left _ (I'.yInv_mem v hv), h1]

end CanonicalInverses

/-! ### The algebra the three displays of §5.1 reduce to

Every square of the three diagrams is one of four facts: `γ⋆ · X⋆ = X^{ℓ-1}` (and its `Y`
twin), `X⋆⁻¹`/`Y⋆⁻¹` are one-sided inverses on the components `RQ-5.01-H3` names, `T₋ = 𝟏 + γ⋆⁻²n`
with `n` the remainder of `cor:X_Y_inverses`, and `n` commutes with `X` and `Y` because it is a
polynomial in the Casimir.  These are stated once here and used by all three. -/

section DiagramAlgebra

variable (Q : QiSetup F ℓ Mi)

/-- `γ⋆ · X⋆ = X^{ℓ-1}`.  @census none (helper) -/
theorem gammaStar_smul_xStar : gammaStarF F ℓ • xStar Q = Q.X ^ (ℓ - 1) := by
  rw [xStar, smul_smul, mul_inv_cancel₀ (gammaStarF_ne_zero ℓ), one_smul]

/-- `γ⋆ · Y⋆ = Y^{ℓ-1}`.  @census none (helper) -/
theorem gammaStar_smul_yStar : gammaStarF F ℓ • yStar Q = Q.Y ^ (ℓ - 1) := by
  rw [yStar, smul_smul, mul_inv_cancel₀ (gammaStarF_ne_zero ℓ), one_smul]

/-- The remainder `n` of `eq:XY_inverses_rel` is a polynomial in the Casimir, so it commutes with
`X`.  @census none (helper) -/
theorem commute_qiRemainder_X : Commute (qiRemainder Q) Q.X :=
  ((commute_casimirFactorProd _ _ Q.weight.casimir_commute_X _ _).sub_left
    ((Commute.one_left Q.weight.X).smul_left _)).smul_left _

/-- `n` commutes with `Y`; see `commute_qiRemainder_X`.  @census none (helper) -/
theorem commute_qiRemainder_Y : Commute (qiRemainder Q) Q.Y :=
  ((commute_casimirFactorProd _ _ Q.weight.casimir_commute_Y _ _).sub_left
    ((Commute.one_left Q.weight.Y).smul_left _)).smul_left _

/-- `T₋` commutes with `X`; `T₋` is `casimirFactorProd` up to a scalar.  @census none (helper) -/
theorem commute_tMinus_X : Commute (tMinus Q) Q.X :=
  (commute_casimirFactorProd _ _ Q.weight.casimir_commute_X _ _).smul_left _

/-- `T₋` commutes with `Y`; see `commute_tMinus_X`.  @census none (helper) -/
theorem commute_tMinus_Y : Commute (tMinus Q) Q.Y :=
  (commute_casimirFactorProd _ _ Q.weight.casimir_commute_Y _ _).smul_left _

/-- `T₋ X = X T₋`, pointwise.  @census none (helper) -/
theorem tMinus_X_apply (v : Mi) : tMinus Q (Q.X v) = Q.X (tMinus Q v) := by
  simpa only [Module.End.mul_apply] using
    congrArg (fun f : Module.End F Mi => f v) (commute_tMinus_X Q)

/-- `T₋ Y = Y T₋`, pointwise.  @census none (helper) -/
theorem tMinus_Y_apply (v : Mi) : tMinus Q (Q.Y v) = Q.Y (tMinus Q v) := by
  simpa only [Module.End.mul_apply] using
    congrArg (fun f : Module.End F Mi => f v) (commute_tMinus_Y Q)

/-- **`T₊` and `T₋` are the same operator.**  Not an accident and not a divergence: `HC.Tplus` and
`HC.Tminus` have *definitionally identical* bodies (S7's `Tplus` docstring says so — the source
gives the product two names because it applies it to `M_{ℓ+1}` and to `M_{-(ℓ+1)}`), and so do
`Gelfand.tPlus`/`tMinus`.  Stated so that the places where §5.2 needs `T₊` from a `T₋` fact cite
this rather than silently relying on the `rfl`.  @census none (helper) -/
theorem tPlus_eq_tMinus : tPlus Q = tMinus Q := rfl

/-- **`T₋ = 𝟏 + γ⋆⁻²·n`** — the corollary `cor:T_operators`'s own clause `RQ-3.07-C4`, read on a
`QiSetup` and with the `(4^{ℓ-1}·γ⋆²)⁻¹` prefactor, which is what makes it true and which the
source has printed since the author's ruling of 2026-09-11 (`AN-35`).  @census none (helper) -/
theorem tMinus_apply' (hℓ : 1 ≤ ℓ) (v : Mi) :
    tMinus Q v = v + (gammaStarF F ℓ ^ 2)⁻¹ • qiRemainder Q v := by
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero ℓ
  have hγ2 : (gammaStarF F ℓ ^ 2) ≠ 0 := pow_ne_zero _ hγ
  have h4 : ((4 : F) ^ (ℓ - 1)) ≠ 0 := four_pow_ne_zero _
  have hsc : nilpScalar ℓ ((ℓ : ℤ) - 2) (ℓ - 1) F
      = (4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2 := by
    rw [nilpScalar_gammaStar ℓ hℓ, gammaStarF_eq]
  have e1 : (gammaStarF F ℓ ^ 2)⁻¹ * ((4 : F) ^ (ℓ - 1))⁻¹
      = ((4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2)⁻¹ := by
    field_simp
  have e2 : (gammaStarF F ℓ ^ 2)⁻¹
      * (((4 : F) ^ (ℓ - 1))⁻¹ * ((4 : F) ^ (ℓ - 1) * gammaStarF F ℓ ^ 2))
      = 1 := by field_simp
  simp only [qiRemainder_apply, hsc, smul_sub, smul_smul, e1, e2, one_smul, tMinus,
    LinearMap.smul_apply]
  abel

/-- **`Y⋆ X⋆ = T₋` on `M_{-(ℓ-1)}`** — the renormalization identity behind the back-left square of
all three displays.  @census none (helper) -/
theorem yStar_xStar_apply (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    yStar Q (xStar Q v) = tMinus Q v := by
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero ℓ
  have hγ2 : (gammaStarF F ℓ ^ 2) ≠ 0 := pow_ne_zero _ hγ
  have hmul : gammaStarF F ℓ ^ 2 • yStar Q (xStar Q v) = (Q.Y ^ (ℓ - 1) * Q.X ^ (ℓ - 1)) v := by
    rw [← gammaStar_smul_yStar Q, ← gammaStar_smul_xStar Q]
    simp only [LinearMap.smul_apply, map_smul, Module.End.mul_apply, smul_smul]
    congr 1
    ring
  have hrhs : gammaStarF F ℓ ^ 2 • tMinus Q v = (Q.Y ^ (ℓ - 1) * Q.X ^ (ℓ - 1)) v := by
    rw [pow_Y_pow_X_apply Q hℓ v hv, tMinus_apply' Q hℓ v, smul_add, smul_smul,
      mul_inv_cancel₀ hγ2, one_smul]
  exact smul_right_injective Mi hγ2 (hmul.trans hrhs.symm)

/-- **`X⋆ Y⋆ = T₋` on `M_{ℓ-1}`**; see `yStar_xStar_apply`.  @census none (helper) -/
theorem xStar_yStar_apply (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp ((ℓ : ℤ) - 1)) :
    xStar Q (yStar Q v) = tMinus Q v := by
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero ℓ
  have hγ2 : (gammaStarF F ℓ ^ 2) ≠ 0 := pow_ne_zero _ hγ
  have hmul : gammaStarF F ℓ ^ 2 • xStar Q (yStar Q v) = (Q.X ^ (ℓ - 1) * Q.Y ^ (ℓ - 1)) v := by
    rw [← gammaStar_smul_xStar Q, ← gammaStar_smul_yStar Q]
    simp only [LinearMap.smul_apply, map_smul, Module.End.mul_apply, smul_smul]
    congr 1
    ring
  have hrhs : gammaStarF F ℓ ^ 2 • tMinus Q v = (Q.X ^ (ℓ - 1) * Q.Y ^ (ℓ - 1)) v := by
    rw [pow_X_pow_Y_apply Q hℓ v hv, tMinus_apply' Q hℓ v, smul_add, smul_smul,
      mul_inv_cancel₀ hγ2, one_smul]
  exact smul_right_injective Mi hγ2 (hmul.trans hrhs.symm)

variable (I : StarInverses Q)

/-- `X⋆ ∘ X⋆⁻¹ = 𝟏` on `M_{ℓ-1}`.  @census none (helper) -/
theorem xStar_xStarInv (v : Mi) (hv : v ∈ Q.comp ((ℓ : ℤ) - 1)) :
    xStar Q (I.xStarInv v) = v := by
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero ℓ
  show ((gammaStarF F ℓ)⁻¹ • Q.weight.X ^ (ℓ - 1)) ((gammaStarF F ℓ • I.xInv) v) = v
  simp only [LinearMap.smul_apply, map_smul, smul_smul, mul_inv_cancel₀ hγ,
    inv_mul_cancel₀ hγ, one_smul]
  exact I.xInv_right v hv

/-- `Y⋆ ∘ Y⋆⁻¹ = 𝟏` on `M_{-(ℓ-1)}`.  @census none (helper) -/
theorem yStar_yStarInv (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    yStar Q (I.yStarInv v) = v := by
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero ℓ
  show ((gammaStarF F ℓ)⁻¹ • Q.weight.Y ^ (ℓ - 1)) ((gammaStarF F ℓ • I.yInv) v) = v
  simp only [LinearMap.smul_apply, map_smul, smul_smul, mul_inv_cancel₀ hγ,
    inv_mul_cancel₀ hγ, one_smul]
  exact I.yInv_right v hv

/-- `Y⋆⁻¹ ∘ Y⋆ = 𝟏` on `M_{ℓ-1}`.  @census none (helper) -/
theorem yStarInv_yStar (v : Mi) (hv : v ∈ Q.comp ((ℓ : ℤ) - 1)) :
    I.yStarInv (yStar Q v) = v := by
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero ℓ
  show (gammaStarF F ℓ • I.yInv) (((gammaStarF F ℓ)⁻¹ • Q.weight.Y ^ (ℓ - 1)) v) = v
  simp only [LinearMap.smul_apply, map_smul, smul_smul, mul_inv_cancel₀ hγ,
    inv_mul_cancel₀ hγ, one_smul]
  exact I.yInv_left v hv

/-- `X⋆⁻¹ ∘ X⋆ = 𝟏` on `M_{-(ℓ-1)}`.  @census none (helper) -/
theorem xStarInv_xStar (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    I.xStarInv (xStar Q v) = v := by
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero ℓ
  show (gammaStarF F ℓ • I.xInv) (((gammaStarF F ℓ)⁻¹ • Q.weight.X ^ (ℓ - 1)) v) = v
  simp only [LinearMap.smul_apply, map_smul, smul_smul, mul_inv_cancel₀ hγ,
    inv_mul_cancel₀ hγ, one_smul]
  exact I.xInv_left v hv

/-- **`4·XY = C − (n−1)²·𝟏` on `M_n`** — the pointwise form of `prop:XY_C_relation` (S7's
`RQ-3.04`) in the shape §5.1's nilpotency clause needs.

Written for the successor of this shift (`stages/S8/DESIGN-NOTES.md` §7.4(b)): at **all three**
vertices of `𝔼_{ℚ[√-1]}(M)` the length-two loop is the *same* operator `¼(C − ℓ²·𝟏)`, which is
nilpotent by `Q.gic_nilpotent`. Indeed `(n−1)² = ℓ²` at `n = -(ℓ-1)` (vertex `⋆`) and at
`n = ℓ+1` (vertex `+`), and at `n = -(ℓ+1)` (vertex `−`) the loop is `YX`, for which
`4·YX = 4·XY − 4·H = C − (n−1)² − 4n = C − ℓ²` as well.  @census none (helper) -/
theorem four_X_Y_apply (n : ℤ) (v : Mi) (hv : v ∈ Q.comp n) :
    (4 : F) • Q.X (Q.Y v)
      = Q.weight.casimir v - (((n : F) - 1) ^ 2) • v := by
  have hH : Q.weight.H v = ((n : F)) • v := Q.weight.H_apply n v hv
  have hsq : ((n : F) - 1) ^ 2
      = (n : F) ^ 2 - 2 * (n : F) + 1 := by ring
  rw [Q.weight.casimir_apply v, hH, map_smul, hH, smul_smul, ← sq, hsq]
  module

/-- **`D := C − ℓ²·𝟏` preserves every weight component.**  Needed to restrict `Q.gic_nilpotent`'s
global nilpotency to a single weight component (`E_F_isNilpotent`).  @census none (helper) -/
theorem casimir_sub_sq_mem (n : ℤ) {v : Mi} (hv : v ∈ Q.comp n) :
    Q.weight.casimir v - ((ℓ : F) ^ 2) • v ∈ Q.comp n :=
  sub_mem (Q.weight.casimir_mem_comp n v hv) (Submodule.smul_mem _ _ hv)

/-- **`4·X(Yv) = Dv` on `M(⋆) = M_{-(ℓ-1)}`** — `four_X_Y_apply` specialized to the vertex `⋆`,
where `(n-1)² = ℓ²`.  @census none (helper) -/
theorem four_smul_XY_star_apply (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    (4 : F) • Q.X (Q.Y v)
      = Q.weight.casimir v - ((ℓ : F) ^ 2) • v := by
  have h := four_X_Y_apply Q (-((ℓ : ℤ) - 1)) v hv
  have hc : (((-((ℓ : ℤ) - 1) : ℤ) : F) - 1) ^ 2 = ((ℓ : F)) ^ 2 := by
    push_cast; ring
  rwa [hc] at h

/-! #### The three non-trivial squares, shared by all three displays

`eq:normalizedcomparison` and its two un-normalized predecessors have the *same* four squares up to
the scalars `γ⋆`, `γ⋆²` on the verticals, so each square is proved once here, in the normalized
form, and the three theorems below scale it.  The front-right square is
`X ∘ X⋆ = (X ∘ X⋆)` — definitionally true in every normalization — and needs no lemma. -/

/-- **Front-left square**, on `M_{-(ℓ+1)}`: `X⋆ ∘ X = Y⋆⁻¹ ∘ X ∘ T₋`.  @census none (helper) -/
theorem sq_front_left (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) + 1))) :
    xStar Q (Q.X v) = I.yStarInv (Q.X (tMinus Q v)) := by
  have hw : Q.X v ∈ Q.comp (-((ℓ : ℤ) - 1)) :=
    x_mem (Q := Q) (m := -((ℓ : ℤ) + 1)) (by ring) hv
  have hxw : xStar Q (Q.X v) ∈ Q.comp ((ℓ : ℤ) - 1) :=
    xStar_mem (Q := Q) (m := -((ℓ : ℤ) - 1)) (by ring) hℓ hw
  rw [← tMinus_X_apply, ← yStar_xStar_apply Q hℓ _ hw, yStarInv_yStar Q I _ hxw]

/-- **Back-left square**, on `M_{-(ℓ-1)}`: `T₋ ∘ Y = Y ∘ Y⋆ ∘ X⋆`.  @census none (helper) -/
theorem sq_back_left (hℓ : 1 ≤ ℓ) (v : Mi) (hv : v ∈ Q.comp (-((ℓ : ℤ) - 1))) :
    tMinus Q (Q.Y v) = Q.Y (yStar Q (xStar Q v)) := by
  rw [yStar_xStar_apply Q hℓ v hv, tMinus_Y_apply]

/-- **Back-right square**, on `M_{ℓ+1}`: `X⋆ ∘ X⋆⁻¹ ∘ Y = Y`.  @census none (helper) -/
theorem sq_back_right (v : Mi) (hv : v ∈ Q.comp ((ℓ : ℤ) + 1)) :
    xStar Q (I.xStarInv (Q.Y v)) = Q.Y v :=
  xStar_xStarInv Q I _ (y_mem (Q := Q) (m := (ℓ : ℤ) + 1) (by ring) hv)

end DiagramAlgebra

/-! ### The three commutative diagrams of §5.1

Each of the three displays of §5.1 is a ladder of two rows with three vertical maps, and its
commutativity is the conjunction of **four** squares: the two "in the front" with right-facing
horizontal arrows, and the two "in the back" with the left-facing arrows (census clause
`RQ-5.01-C1`'s own note: "the commutativity claim is for ALL FOUR squares").  Each square is stated
as the agreement of two composites on the weight component its top-left corner names. -/

section Diagrams

variable (Q : QiSetup F ℓ Mi) (I : StarInverses Q)

/-- **§5.1, first display** — `RQ-5.01-C1`.

Top row `M_{-(ℓ+1)} ⇄ M_{-(ℓ-1)} ⇄ M_{ℓ+1}` with `X`, `Y`, `X X^{ℓ-1}`, `X^{-(ℓ-1)} Y`;
bottom row `M_{-(ℓ+1)} ⇄ M_{ℓ-1} ⇄ M_{ℓ+1}` with `Y^{-(ℓ-1)} X`, `Y Y^{ℓ-1}`, `X`, `Y`;
verticals `γ⋆² T₋`, `γ⋆ X⋆`, `𝟏_{M_{ℓ+1}}`.  All four squares commute.

@census    none (auxiliary; discharges census clause `RQ-5.01-C1`)
@source    UNLABELED-EQi-construction
(clauses of the frozen original:)   RQ-5.01-C1
@imports   none
@divergence none -/
theorem first_diagram_commutes (hℓ : 1 ≤ ℓ) :
    -- front-left square, on `M_{-(ℓ+1)}`
    (∀ v ∈ Q.comp (-((ℓ : ℤ) + 1)),
        (gammaStarF F ℓ • xStar Q) (Q.X v)
          = (I.yInv (Q.X ((gammaStarF F ℓ ^ 2 • tMinus Q) v)))) ∧
    -- front-right square, on `M_{-(ℓ-1)}`
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)),
        Q.X ((Q.X ^ (ℓ - 1)) v) = Q.X ((gammaStarF F ℓ • xStar Q) v)) ∧
    -- back-left square, on `M_{-(ℓ-1)}`
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)),
        (gammaStarF F ℓ ^ 2 • tMinus Q) (Q.Y v)
          = Q.Y ((Q.Y ^ (ℓ - 1)) ((gammaStarF F ℓ • xStar Q) v))) ∧
    -- back-right square, on `M_{ℓ+1}`
    (∀ v ∈ Q.comp ((ℓ : ℤ) + 1),
        (gammaStarF F ℓ • xStar Q) (I.xInv (Q.Y v)) = Q.Y v) := by
  refine ⟨fun v hv => ?_, fun v hv => ?_, fun v hv => ?_, fun v hv => ?_⟩
  · -- `γ⋆X⋆ ∘ X = Y^{-(ℓ-1)} ∘ X ∘ γ⋆²T₋` is the normalized square scaled by `γ⋆`
    have hx : xStar Q (Q.X v) = I.yStarInv (Q.X (tMinus Q v)) := sq_front_left Q I hℓ v hv
    show gammaStarF F ℓ • xStar Q (Q.X v) = I.yInv (Q.X (gammaStarF F ℓ ^ 2 • tMinus Q v))
    rw [hx]
    show gammaStarF F ℓ • (gammaStarF F ℓ • I.yInv (Q.X (tMinus Q v)))
      = I.yInv (Q.X (gammaStarF F ℓ ^ 2 • tMinus Q v))
    rw [map_smul, map_smul, smul_smul, sq]
  · -- `X ∘ X^{ℓ-1} = X ∘ γ⋆X⋆`
    rw [show (gammaStarF F ℓ • xStar Q) = Q.X ^ (ℓ - 1) from gammaStar_smul_xStar Q]
  · -- `γ⋆²T₋ ∘ Y = Y ∘ Y^{ℓ-1} ∘ γ⋆X⋆`
    show gammaStarF F ℓ ^ 2 • tMinus Q (Q.Y v)
      = Q.Y ((Q.Y ^ (ℓ - 1)) (gammaStarF F ℓ • xStar Q v))
    rw [← gammaStar_smul_yStar Q]
    simp only [LinearMap.smul_apply, map_smul, smul_smul, sq]
    rw [yStar_xStar_apply Q hℓ v hv, tMinus_Y_apply]
  · -- `γ⋆X⋆ ∘ X^{-(ℓ-1)} ∘ Y = Y`
    rw [gammaStar_smul_xStar Q]
    exact I.xInv_right _ (y_mem (Q := Q) (m := (ℓ : ℤ) + 1) (by ring) hv)

/-- **§5.1, second display** — `RQ-5.01-C3`: renormalizing the first display by `X⋆` replaces the
top right-hand arrows by `X X⋆` and `X⋆⁻¹ Y` and the verticals by `γ⋆ T₋`, `X⋆`, `𝟏`.

@census    none (auxiliary; discharges census clause `RQ-5.01-C3`)
@source    UNLABELED-EQi-construction
(clauses of the frozen original:)   RQ-5.01-C3
@imports   none
@divergence none -/
theorem second_diagram_commutes (hℓ : 1 ≤ ℓ) :
    (∀ v ∈ Q.comp (-((ℓ : ℤ) + 1)),
        xStar Q (Q.X v) = I.yInv (Q.X ((gammaStarF F ℓ • tMinus Q) v))) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), Q.X (xStar Q v) = (Q.X.comp (xStar Q)) v) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)),
        (gammaStarF F ℓ • tMinus Q) (Q.Y v) = Q.Y ((Q.Y ^ (ℓ - 1)) (xStar Q v))) ∧
    (∀ v ∈ Q.comp ((ℓ : ℤ) + 1), xStar Q (I.xStarInv (Q.Y v)) = Q.Y v) := by
  refine ⟨fun v hv => ?_, fun v _ => rfl, fun v hv => ?_, fun v hv => sq_back_right Q I v hv⟩
  · show xStar Q (Q.X v) = I.yInv (Q.X (gammaStarF F ℓ • tMinus Q v))
    rw [sq_front_left Q I hℓ v hv, map_smul, map_smul]
    rfl
  · show gammaStarF F ℓ • tMinus Q (Q.Y v) = Q.Y ((Q.Y ^ (ℓ - 1)) (xStar Q v))
    rw [← gammaStar_smul_yStar Q]
    simp only [LinearMap.smul_apply, map_smul]
    rw [yStar_xStar_apply Q hℓ v hv, tMinus_Y_apply]

/-- **`eq:normalizedcomparison`** — `RQ-5.01-C4`: renormalizing the second display by `Y⋆` replaces
the bottom right-hand arrows by `Y⋆⁻¹ X` and `Y Y⋆` and the verticals by `T₋`, `X⋆`, `𝟏`.  This is
the diagram the whole of §5.1 and §5.2 is written against.

@census    none (auxiliary; discharges census clause `RQ-5.01-C4`)
@source    eq:normalizedcomparison
(clauses of the frozen original:)   RQ-5.01-C4
@imports   none
@divergence none
@clauses   RQ2-5.02-S-O7a -/
theorem normalized_diagram_commutes (hℓ : 1 ≤ ℓ) :
    (∀ v ∈ Q.comp (-((ℓ : ℤ) + 1)), xStar Q (Q.X v) = I.yStarInv (Q.X (tMinus Q v))) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), Q.X (xStar Q v) = (Q.X.comp (xStar Q)) v) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), tMinus Q (Q.Y v) = Q.Y (yStar Q (xStar Q v))) ∧
    (∀ v ∈ Q.comp ((ℓ : ℤ) + 1), xStar Q (I.xStarInv (Q.Y v)) = Q.Y v) := by
  exact ⟨fun v hv => sq_front_left Q I hℓ v hv, fun v _ => rfl,
    fun v hv => sq_back_left Q hℓ v hv, fun v hv => sq_back_right Q I v hv⟩

end Diagrams


/-! ### The split Gelfand quiver `Γ_E` over a field that is its own base, with its relation

`RQ-5.01`'s target is "the Gelfand quiver over `ℚ[√-1]`", i.e. the `E`-rational Gelfand quiver for
`E = ℚ[√-1]` — the quiver `ex:gelfand` with the **trivial** `Gal(E/E)`-action.  `RQ-5.05`'s target
is the genuinely `ℚ`-rational one, `RationalQuiver.gelfandOfCardTwo ℚ ℚ[√-1]`, where the action is
the non-trivial involution; the two are related by base change (`RQ-1.11`).

**The relation is part of the target** (repair round): `ex:gelfand` is a quiver *with* the relation
`a₋b₋ = a₊b₊` (census `RQ-1.19`, `RQ-2.16`), and a "representation of the Gelfand quiver"
satisfies it — this is what clause `RQ-5.01-C7` establishes for `𝔼_{ℚ[√-1]}(M)`.  The tree's
`Rep`/`RepNil` know nothing of relations, and S5's `gelfandNilTwist` is a **nilpotent** rational
representation violating it, so an equivalence onto `Rep^nil` of the bare quiver would be false;
the target of `RQ-5.02`/`RQ-5.05`/`RQ-5.07`'s Gelfand rows is therefore the full subcategory
`RepNilRel` of nilpotent representations **satisfying the relation**. -/


/-! ### `𝔼_{ℚ[√-1]}(M)` as a representation of the split Gelfand quiver -/

section EQiRep

variable (Q : QiSetup F ℓ Mi) (I : StarInverses Q) (hℓ : 1 ≤ ℓ)



/-- The vertex family of `𝔼_{ℚ[√-1]}(M)`: `M(−)`, `M(⋆)`, `M(+)` at the vertices `0, 1, 2` — the
weight components `M_{vtxIdx v}`, uniformly in `v` (so that the semi-linear structure maps of
`RQ-5.05` can be written without any transport of types).  @census none (helper) -/
abbrev V3 (v : Fin 3) : Type := ↥(Q.comp (vtxIdx ℓ v))

/-- The four edge maps of `𝔼_{ℚ[√-1]}(M)`, by edge index: `a₋ ↦ φ_{a₋}`, `b₋ ↦ φ_{b₋}`,
`a₊ ↦ φ_{a₊}`, `b₊ ↦ φ_{b₊}`.  @census none (helper) -/
noncomputable def E_F_edge :
    ∀ e : Fin 4, V3 Q (RQuiver.gelfand.source e) →ₗ[F] V3 Q (RQuiver.gelfand.target e)
  | 0 => phiAMinus Q
  | 1 => phiBMinus Q
  | 2 => phiAPlus Q I
  | 3 => phiBPlus Q hℓ

/-- **`𝔼_{ℚ[√-1]}(M)` as a rational representation of the split Gelfand quiver**: the vertex
spaces `M(−), M(⋆), M(+)` (`RQ-5.01-C5`), the four edge maps (`RQ-5.01-C6`), and the trivial
`Gal(ℚ[√-1]/ℚ[√-1])`-structure.  This is the object whose nilpotency clause `RQ-5.01-C8` asserts
and whose relation clause `RQ-5.01-C7` asserts — pinned to the construction on the nose.

@census    none (auxiliary; the representation of `RQ-5.01-C8`)
@source    UNLABELED-EQi-construction
@imports   none
@divergence none
@clauses   RQ2-5.02-S-O7b -/
noncomputable def E_F_rep : RationalQuiver.Rep (gelfandSplit F) :=
  RationalQuiver.Rep.ofFiniteDimensional (Γ := gelfandSplit F) (V3 Q)
    (fun _ _ => AddEquiv.refl _)
    (fun σ v a m => by rw [galSelf_apply]; rfl)
    (fun _ _ _ _ => rfl)
    (fun e => E_F_edge Q I hℓ e)
    (fun _ _ _ _ h => by
      cases h
      rfl)

@[simp] theorem E_F_rep_M_minus : (E_F_rep Q I hℓ).M (vtxMinus _) = vMinus Q := rfl
@[simp] theorem E_F_rep_M_star : (E_F_rep Q I hℓ).M (vtxStar _) = vStar Q := rfl
@[simp] theorem E_F_rep_M_plus : (E_F_rep Q I hℓ).M (vtxPlus _) = vPlus Q := rfl
theorem E_F_rep_edge (e : Fin 4) : (E_F_rep Q I hℓ).φEdge e = E_F_edge Q I hℓ e := rfl

/-! #### Nilpotency (`RQ-5.01-C8`), `stages/S8/DESIGN-NOTES.md` §8.3

The length-two loop at `⋆` through either leaf is `φ_{a₋}φ_{b₋}` (`= φ_{a₊}φ_{b₊}`,
`E_F_relation`), and `4` times it is the restriction to `M(⋆)` of `D := C − ℓ²·𝟏`
(`four_smul_qiLoopStar`), nilpotent by `Q.gic_nilpotent`. Every edge of `ex:gelfand` touches `⋆`
(`RQuiver.gelfand`'s own `source`/`target` arrays), so every path alternates `⋆, leaf, ⋆, leaf, …`;
peeling one leading edge if necessary lands at `⋆`, after which the path decomposes into
consecutive `⋆`-based length-two windows, each `φ_{a₋}φ_{b₋}`, and the nilpotency of that one
operator kills the whole composite once enough windows accumulate. -/

/-- The `MapsTo` witness restricting `D := C − ℓ²·𝟏` to `M(⋆)`.  @census none (helper) -/
theorem casimir_sub_sq_mapsTo :
    ∀ v ∈ vStar Q, (Q.weight.casimir - ((ℓ : F) ^ 2) •
        (1 : Module.End F Mi)) v ∈ vStar Q :=
  fun v hv => casimir_sub_sq_mem Q _ hv

/-- **`4·(φ_{a₋}φ_{b₋}) = D` on `M(⋆)`**, `D` the restriction of `C − ℓ²·𝟏` to `vStar Q`.
@census none (helper) -/
theorem four_smul_qiLoopStar :
    (4 : F) • ((phiAMinus Q).comp (phiBMinus Q))
      = (Q.weight.casimir - ((ℓ : F) ^ 2) • (1 : Module.End F Mi)).restrict
          (casimir_sub_sq_mapsTo Q) := by
  refine LinearMap.ext fun ⟨v, hv⟩ => Subtype.ext ?_
  show (4 : F) • Q.X (Q.Y v) = Q.weight.casimir v - ((ℓ : F) ^ 2) • v
  exact four_smul_XY_star_apply Q v hv

/-- **`φ_{a₋}φ_{b₋}` is nilpotent as an endomorphism of `M(⋆)`** — census clause `RQ-5.01-C8`'s
mathematical content.  @census none (helper) -/
theorem qiLoopStar_pow_eq_zero :
    ∃ m : ℕ, ((phiAMinus Q).comp (phiBMinus Q)) ^ m = 0 := by
  obtain ⟨m, hm⟩ := Module.End.isNilpotent.restrict (casimir_sub_sq_mapsTo Q) Q.gic_nilpotent
  refine ⟨m, ?_⟩
  have h4 : ((4 : F) ^ m) ≠ 0 := pow_ne_zero _ (by norm_num)
  have heq : (4 : F) ^ m • (((phiAMinus Q).comp (phiBMinus Q))) ^ m
      = (4 : F) ^ m • (0 : Module.End F (vStar Q)) := by
    rw [smul_zero, ← smul_pow, four_smul_qiLoopStar]
    exact hm
  exact smul_right_injective _ h4 heq

/-- **Every edge of `ex:gelfand` touches `⋆`**: an edge landing away from `⋆` starts at `⋆`.
Purely combinatorial (`RQuiver.gelfand.source = ![0,1,2,1]`, `.target = ![1,0,1,2]`); no `Q`, `I`
or `ℓ` needed.  @census none (helper) -/
theorem qi_edge_dichotomy {x y : (gelfandSplit F).V} (g : x ⟶ y)
    (hy : y ≠ vtxStar F) : x = vtxStar F := by
  obtain ⟨k, hs, ht⟩ :=
    (g : {e : Fin 4 // RQuiver.gelfand.source e = x ∧ RQuiver.gelfand.target e = y})
  obtain ⟨kv, hkv⟩ := k
  interval_cases kv <;> first
    | exact absurd ht.symm hy
    | exact hs.symm

/-- **No self-loop at `⋆`**: an edge landing at `⋆` starts elsewhere.  @census none (helper) -/
theorem qi_no_star_selfloop {x : (gelfandSplit F).V} (g : x ⟶ (vtxStar F)) :
    x ≠ vtxStar F := by
  obtain ⟨k, hs, ht⟩ :=
    (g : {e : Fin 4 // RQuiver.gelfand.source e = x ∧
      RQuiver.gelfand.target e = vtxStar F})
  have hkey : ∀ e : Fin 4, RQuiver.gelfand.target e = vtxStar F →
      RQuiver.gelfand.source e ≠ vtxStar F := by
    show ∀ e : Fin 4, RQuiver.gelfand.target e = (1 : Fin 3) → RQuiver.gelfand.source e ≠ (1 : Fin 3)
    decide
  rw [← hs]
  exact hkey k ht

/-- **A length-two window based at `⋆` is `φ_{a₋}φ_{b₋}`, whichever leaf it passes through**
(`E_F_relation` unifies the `+`-leaf case with the `−`-leaf one).  @census none (helper) -/
theorem qiLoop_arrowMap_comp {w : (gelfandSplit F).V}
    (g1 : (vtxStar F) ⟶ w) (g2 : w ⟶ (vtxStar F)) :
    (E_F_rep Q I hℓ).arrowMap g2 ∘ₗ (E_F_rep Q I hℓ).arrowMap g1
      = (phiAMinus Q).comp (phiBMinus Q) := by
  obtain ⟨k1, hs1, ht1⟩ :=
    (g1 : {e : Fin 4 // RQuiver.gelfand.source e = vtxStar F ∧
      RQuiver.gelfand.target e = w})
  obtain ⟨k2, hs2, ht2⟩ :=
    (g2 : {e : Fin 4 // RQuiver.gelfand.source e = w ∧
      RQuiver.gelfand.target e = vtxStar F})
  have hkey : ∀ e1 e2 : Fin 4, RQuiver.gelfand.source e1 = vtxStar F →
      RQuiver.gelfand.target e2 = vtxStar F →
      RQuiver.gelfand.target e1 = RQuiver.gelfand.source e2 →
      (e1 = 1 ∧ e2 = 0) ∨ (e1 = 3 ∧ e2 = 2) := by (try unfold vtxStar); decide
  rcases hkey k1 k2 hs1 ht2 (ht1.trans hs2.symm) with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> subst ht1
  · rfl
  · first
      | exact E_F_relation Q I hℓ
      | exact (E_F_relation Q I hℓ).symm

/-- **Peeling `2k` `⋆`-based windows off the end of a path landing at `⋆`.**  Each window is
`φ_{a₋}φ_{b₋}` (`qiLoop_arrowMap_comp`), so the whole path composite is that operator, iterated
`k` times, composed with the composite of what remains.  @census none (helper) -/
theorem qiLoop_pathMap_peel :
    ∀ (k : ℕ) (a : (gelfandSplit F).V) (p : Quiver.Path a (vtxStar F)),
      2 * k ≤ p.length →
      ∃ q : Quiver.Path a (vtxStar F), q.length = p.length - 2 * k ∧
        ∀ v, (E_F_rep Q I hℓ).pathMap p v
          = (((phiAMinus Q).comp (phiBMinus Q)) ^ k) ((E_F_rep Q I hℓ).pathMap q v) := by
  intro k
  induction k with
  | zero => intro a p _; exact ⟨p, by simp, fun v => by simp⟩
  | succ k ih =>
    intro a p hp
    cases p with
    | nil => simp [Quiver.Path.length] at hp
    | cons q1 g_last =>
      rename_i X
      have hXne : X ≠ vtxStar F := qi_no_star_selfloop g_last
      have hp1 : 2 * k + 1 ≤ q1.length := by
        simp only [Quiver.Path.length] at hp; omega
      cases q1 with
      | nil => simp at hp1
      | cons q2 g_prev =>
        rename_i Y
        have hY : Y = vtxStar F := qi_edge_dichotomy g_prev hXne
        subst hY
        have hp2 : 2 * k ≤ q2.length := by
          simp only [Quiver.Path.length] at hp1; omega
        obtain ⟨q, hqlen, hqeq⟩ := ih _ q2 hp2
        refine ⟨q, by simp only [Quiver.Path.length] at hqlen ⊢; omega, fun v => ?_⟩
        have hloop := qiLoop_arrowMap_comp Q I hℓ g_prev g_last
        have hloop_apply : ∀ u : vStar Q, (E_F_rep Q I hℓ).arrowMap g_last
              ((E_F_rep Q I hℓ).arrowMap g_prev u)
            = ((phiAMinus Q).comp (phiBMinus Q)) u := fun u => by
          have h := LinearMap.congr_fun hloop u
          rwa [LinearMap.comp_apply] at h
        have step1 : (E_F_rep Q I hℓ).pathMap ((q2.cons g_prev).cons g_last) v
            = (E_F_rep Q I hℓ).arrowMap g_last
                ((E_F_rep Q I hℓ).arrowMap g_prev ((E_F_rep Q I hℓ).pathMap q2 v)) := by
          rw [RationalQuiver.Rep.pathMap_cons, RationalQuiver.Rep.pathMap_cons,
            LinearMap.comp_apply, LinearMap.comp_apply]
        have hpow_apply : ∀ z : vStar Q,
            ((((phiAMinus Q).comp (phiBMinus Q)) ^ (k + 1)) z : vStar Q)
              = ((phiAMinus Q).comp (phiBMinus Q))
                  ((((phiAMinus Q).comp (phiBMinus Q)) ^ k) z) := by
          intro z
          rw [pow_succ', Module.End.mul_apply]
        rw [step1, hqeq, hloop_apply]
        exact (hpow_apply ((E_F_rep Q I hℓ).pathMap q v)).symm

/-- `𝔼_{ℚ[√-1]}(M)` is a **nilpotent** representation of the split Gelfand quiver over `ℚ[√-1]` —
census clause `RQ-5.01-C8`, stated of the constructed representation itself (repair `V-S8-7`:
the former statement pinned only the vertex *types* and was satisfied by the zero edge maps).
The content is that `XY` on `M(⋆)`, `YX` on `M(−)` and `XY` on `M(+)` are `4⁻¹(C − ℓ²)`, nilpotent
by the generalized infinitesimal character (`prop:XY_C_relation`).

@census    none (auxiliary; discharges census clause `RQ-5.01-C8`)
@source    UNLABELED-EQi-construction
(clauses of the frozen original:)   RQ-5.01-C8
@imports   none
@divergence none
@clauses   RQ2-5.02-S-O7c -/
theorem E_F_isNilpotent : (E_F_rep Q I hℓ).IsNilpotent := by
  obtain ⟨m, hm⟩ := qiLoopStar_pow_eq_zero Q
  refine ⟨2 * m + 1, fun a b p hp => LinearMap.ext fun v => ?_⟩
  show (E_F_rep Q I hℓ).pathMap p v = 0
  by_cases hb : b = vtxStar F
  · subst hb
    obtain ⟨q, _, hq⟩ := qiLoop_pathMap_peel Q I hℓ m _ p (by omega)
    have hzero : ∀ z : vStar Q, (0 : vStar Q →ₗ[F] vStar Q) z = 0 := fun _ => rfl
    rw [hq, hm]
    exact hzero _
  · cases p with
    | nil => simp [Quiver.Path.length] at hp
    | cons q1 g_last =>
      rename_i c
      have hc : c = vtxStar F := qi_edge_dichotomy g_last hb
      subst hc
      have hp1 : 2 * m ≤ q1.length := by
        simp only [Quiver.Path.length] at hp; omega
      obtain ⟨q, _, hq⟩ := qiLoop_pathMap_peel Q I hℓ m _ q1 hp1
      have hzero : ∀ z : vStar Q, (0 : vStar Q →ₗ[F] vStar Q) z = 0 := fun _ => rfl
      have hmapzero : (E_F_rep Q I hℓ).arrowMap g_last (0 : vStar Q) = 0 :=
        (E_F_rep Q I hℓ).arrowMap g_last |>.map_zero
      rw [RationalQuiver.Rep.pathMap_cons, LinearMap.comp_apply, hq, hm, hzero]
      exact hmapzero

/-- `𝔼_{ℚ[√-1]}(M)` satisfies the relation of `ex:gelfand`, read in the representation: the
`Rep`-level form of `RQ-5.01-C7`.  @census none (helper) -/
theorem E_F_rep_relation : SatisfiesGelfandRelationSplit F (E_F_rep Q I hℓ) := by
  -- The mathematics is `E_F_relation` (proved above, at the level of the `GelfandDiagram`).
  -- Transferring it to the `Rep` level is pure plumbing, and the plumbing has one trap, recorded
  -- in `stages/S8/DESIGN-NOTES.md` §7.4(a): `Rep.pathMap_nil`/`pathMap_cons` are **not** `rfl`
  -- (`pathCompose`'s matcher does not reduce definitionally — its own `nil`/`cons` lemmas are
  -- proved by `simp`, not by `rfl`), and they do not fire under `simp`/`rw` either, because
  -- `RQuiver.pathMinus` is built at the explicitly-named instance `RQuiver.instQuiverV gelfand`
  -- while the goal's paths live at `instQuiverV (gelfandSplit ℚ[√-1]).toRQuiver`; `gelfandSplit`
  -- is a plain `def`, so the two are equal but not *reducibly* equal and syntactic matching fails.
  -- Applying the two equation lemmas by `exact`, with the endpoints pinned to `vtxMinus`/`vtxStar`/
  -- `vtxPlus`, elaborates at the right instance and closes the gap. `arrowMap` **is** `rfl`.
  have hnil : (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxStar F)
      Quiver.Path.nil = LinearMap.id := RationalQuiver.Rep.pathMap_nil _ _
  have hbm : (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxMinus F)
      (Quiver.Path.nil.cons RQuiver.bMinus)
      = (E_F_rep Q I hℓ).arrowMap (a := vtxStar F) (b := vtxMinus F)
          RQuiver.bMinus
        ∘ₗ (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxStar F)
          Quiver.Path.nil := RationalQuiver.Rep.pathMap_cons _ _ _
  have hpm : (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxStar F)
      RQuiver.pathMinus
      = (E_F_rep Q I hℓ).arrowMap (a := vtxMinus F) (b := vtxStar F)
          RQuiver.aMinus
        ∘ₗ (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxMinus F)
          (Quiver.Path.nil.cons RQuiver.bMinus) := RationalQuiver.Rep.pathMap_cons _ _ _
  have hbp : (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxPlus F)
      (Quiver.Path.nil.cons RQuiver.bPlus)
      = (E_F_rep Q I hℓ).arrowMap (a := vtxStar F) (b := vtxPlus F)
          RQuiver.bPlus
        ∘ₗ (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxStar F)
          Quiver.Path.nil := RationalQuiver.Rep.pathMap_cons _ _ _
  have hpp : (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxStar F)
      RQuiver.pathPlus
      = (E_F_rep Q I hℓ).arrowMap (a := vtxPlus F) (b := vtxStar F)
          RQuiver.aPlus
        ∘ₗ (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxPlus F)
          (Quiver.Path.nil.cons RQuiver.bPlus) := RationalQuiver.Rep.pathMap_cons _ _ _
  have ham : (E_F_rep Q I hℓ).arrowMap (a := vtxMinus F) (b := vtxStar F)
      RQuiver.aMinus = phiAMinus Q := rfl
  have hbmv : (E_F_rep Q I hℓ).arrowMap (a := vtxStar F) (b := vtxMinus F)
      RQuiver.bMinus = phiBMinus Q := rfl
  have hap : (E_F_rep Q I hℓ).arrowMap (a := vtxPlus F) (b := vtxStar F)
      RQuiver.aPlus = phiAPlus Q I := rfl
  have hbpv : (E_F_rep Q I hℓ).arrowMap (a := vtxStar F) (b := vtxPlus F)
      RQuiver.bPlus = phiBPlus Q hℓ := rfl
  show (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxStar F)
      RQuiver.pathMinus
    = (E_F_rep Q I hℓ).pathMap (a := vtxStar F) (b := vtxStar F)
      RQuiver.pathPlus
  rw [hpm, hpp, hbm, hbp, hnil, ham, hbmv, hap, hbpv]
  simp only [LinearMap.comp_id]
  have h : (phiAMinus Q).comp (phiBMinus Q) = (phiAPlus Q I).comp (phiBPlus Q hℓ) :=
    E_F_relation Q I hℓ
  exact h

end EQiRep

/-! ### `RQ-5.01` — the construction -/

section Claims

variable (Q : QiSetup F ℓ Mi) (I : StarInverses Q) (hℓ : 1 ≤ ℓ)




/-- **`def:EEsplit` — the construction of `𝔼_F`** (tex §5.1, Steps O-7a…O-7c).  For `ℓ ≥ 1` and an
**arbitrary** `(𝔤,K)`-module `M_F` over a field `F` of characteristic `0` with generalized infinitesimal
character `λ = ℓ²` (a `QiSetup`: not necessarily a base change) whose `X^{ℓ-1}`, `Y^{ℓ-1}` are
invertible on the relevant weight components (`I : StarInverses Q`): the Gelfand relation holds in the
first comparison diagram, `XY = X^{-(ℓ-1)} Y X X^{ℓ-1}` on `M(⋆)` (`C2`), the three displays
commute — the first with verticals `γ⋆²T₋, γ⋆X⋆, 𝟏` (`C1`), the second with `γ⋆T₋, X⋆, 𝟏` (`C3`) and
`eq:normalizedcomparison` with `T₋, X⋆, 𝟏` (`C4`, Step O-7a) — and `𝔼_F(M)` is a **nilpotent**
representation of the split Gelfand quiver (`C8`).  The remaining clauses are discharged by the
declarations named at the point of use: the vertex
spaces and maps `C5`, `C6` (`vMinus`, `vStar`, `vPlus`, `phiAMinus`, `phiBMinus`, `phiAPlus`,
`phiBPlus`, assembled in `E_F_rep`), the relation `C7` (`E_F_relation`, `E_F_rep_relation`), and the
independence of descent `C9` (the statement quantifies over every `QiSetup`).

@census    RQ2-5.01
@source    def:EEsplit
@clauses   RQ2-5.01-H1, RQ2-5.01-H2, RQ2-5.01-H3, RQ2-5.01-C1, RQ2-5.01-C2, RQ2-5.01-C3,
           RQ2-5.01-C4, RQ2-5.01-C5, RQ2-5.01-C6, RQ2-5.01-C7, RQ2-5.01-C8, RQ2-5.01-C9
@imports   none
@divergence JUSTIFIED_REFORMULATION (presentation), two items.  (1) The field is any `F` of
characteristic `0`; the tex's `L_E = E(√-1)` is an instance, and `√-1 ∈ F` is not used by the
construction (it is used by the identification of `HC_λ(𝔤,K)_F` with the concrete category `HCF F ℓ`,
`hcLambdaFEquiv`).  (2) v1 presented `𝔼_{ℚ[√-1]}(M)` additionally as a record of the archived
`Imports.ABR.GelfandDiagram` (D-10); v2 states the relation `C7` directly on the four maps
(`E_F_relation`), which is the same identity.  Carried from v1 `GF.E_Qi_construction` (WP-8c), itself the
field-generic copy of the S8 claimant of `RQ-5.01`.
-/
theorem E_F_construction :
    -- `C1`: the first display commutes (four squares)
    ((∀ v ∈ Q.comp (-((ℓ : ℤ) + 1)),
        (gammaStarF F ℓ • xStar Q) (Q.X v)
          = (I.yInv (Q.X ((gammaStarF F ℓ ^ 2 • tMinus Q) v)))) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)),
        Q.X ((Q.X ^ (ℓ - 1)) v) = Q.X ((gammaStarF F ℓ • xStar Q) v)) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)),
        (gammaStarF F ℓ ^ 2 • tMinus Q) (Q.Y v)
          = Q.Y ((Q.Y ^ (ℓ - 1)) ((gammaStarF F ℓ • xStar Q) v))) ∧
    (∀ v ∈ Q.comp ((ℓ : ℤ) + 1),
        (gammaStarF F ℓ • xStar Q) (I.xInv (Q.Y v)) = Q.Y v)) ∧
    -- `C3`: the second display commutes
    ((∀ v ∈ Q.comp (-((ℓ : ℤ) + 1)),
        xStar Q (Q.X v) = I.yInv (Q.X ((gammaStarF F ℓ • tMinus Q) v))) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), Q.X (xStar Q v) = (Q.X.comp (xStar Q)) v) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)),
        (gammaStarF F ℓ • tMinus Q) (Q.Y v) = Q.Y ((Q.Y ^ (ℓ - 1)) (xStar Q v))) ∧
    (∀ v ∈ Q.comp ((ℓ : ℤ) + 1), xStar Q (I.xStarInv (Q.Y v)) = Q.Y v)) ∧
    -- `C4`: `eq:normalizedcomparison` commutes
    ((∀ v ∈ Q.comp (-((ℓ : ℤ) + 1)), xStar Q (Q.X v) = I.yStarInv (Q.X (tMinus Q v))) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), Q.X (xStar Q v) = (Q.X.comp (xStar Q)) v) ∧
    (∀ v ∈ Q.comp (-((ℓ : ℤ) - 1)), tMinus Q (Q.Y v) = Q.Y (yStar Q (xStar Q v))) ∧
    (∀ v ∈ Q.comp ((ℓ : ℤ) + 1), xStar Q (I.xStarInv (Q.Y v)) = Q.Y v)) ∧
    -- `C2`: the Gelfand relation in the first diagram
    (∀ v ∈ vStar Q, Q.X (Q.Y v) = I.xInv (Q.Y (Q.X ((Q.X ^ (ℓ - 1)) v)))) ∧
    -- `C8`: `𝔼_F(M)` is nilpotent
      (E_F_rep Q I hℓ).IsNilpotent := by
  refine ⟨first_diagram_commutes Q I hℓ, second_diagram_commutes Q I hℓ,
    normalized_diagram_commutes Q I hℓ, fun v hv => ?_, E_F_isNilpotent Q I hℓ⟩
  have hγ : gammaStarF F ℓ ≠ 0 := gammaStarF_ne_zero _
  have h : Q.X (Q.Y v) = I.xStarInv (Q.Y (Q.X (xStar Q v))) :=
    congrArg Subtype.val (LinearMap.congr_fun (E_F_relation Q I hℓ) (⟨v, hv⟩ : vStar Q))
  rw [h, StarInverses.xStarInv, xStar, LinearMap.smul_apply, LinearMap.smul_apply,
    map_smul, map_smul, map_smul, smul_smul, mul_inv_cancel₀ hγ, one_smul]

end Claims

/-! ### `RQ-5.02` — `𝔼_{ℚ[√-1]}` is a functor, and an equivalence

**Restated on the concrete category** (ruling `R-S8-6`, repair `V-S8-8`): the source category is
`HC_λ(𝔤,K)_{ℚ[√-1]}` itself (`Gelfand/Category.lean`'s `HCF F ℓ`), on whose objects
`𝔼_{ℚ[√-1]}` is *defined* — `E_F` — and whose morphisms it carries to morphisms of
representations.  The `Realization` hypothesis and the opaque interface are gone from this row. -/

section Functor

open CategoryTheory

variable (ℓ) (hℓ : 1 ≤ ℓ)

/-- `𝔼_{ℚ[√-1]}` on an object of `HC_λ(𝔤,K)_{ℚ[√-1]}`: the representation `E_F_rep` at the
object's weight datum and its canonical inverses, finite-dimensional by admissibility.
@census none (helper) -/
theorem V3_finiteDimensional (A : HCFObj F ℓ) :
    ∀ v : Fin 3, FiniteDimensional F (V3 A.setup v)
  | 0 => A.admissible _
  | 1 => A.admissible _
  | 2 => A.admissible _

noncomputable def E_F_obj (A : HCFObj F ℓ) : RationalQuiver.FDRep (gelfandSplit F) where
  toRep := E_F_rep A.setup (A.setup.starInverses hℓ) hℓ
  finiteDimensional v := V3_finiteDimensional ℓ A v

/-- The vertex components of `𝔼_{ℚ[√-1]}(f)`: the restrictions of a morphism to the three weight
components, uniformly in the vertex.  @census none (helper) -/
noncomputable def E_F_map_ψ {A B : HCFObj F ℓ} (f : A ⟶ B) (v : Fin 3) :
    V3 A.setup v →ₗ[F] V3 B.setup v :=
  f.toLinearMap.restrict fun _ hv => f.map_comp _ _ hv

@[simp] theorem E_F_map_ψ_val {A B : HCFObj F ℓ} (f : A ⟶ B) (v : Fin 3) (m : V3 A.setup v) :
    ((E_F_map_ψ ℓ f v m : V3 B.setup v) : B.carrier) = f.toLinearMap m := rfl

/-- A morphism commutes with the powers of `X`.  @census none (helper) -/
theorem map_pow_X {A B : HCFObj F ℓ} (f : A ⟶ B) (k : ℕ) (v : A.carrier) :
    f.toLinearMap ((A.weight.X ^ k) v) = (B.weight.X ^ k) (f.toLinearMap v) := by
  induction k generalizing v with
  | zero => rfl
  | succ k ih =>
    rw [pow_succ, pow_succ, Module.End.mul_apply, Module.End.mul_apply, ih (A.weight.X v),
      f.map_X]

/-- A morphism of Harish-Chandra modules commutes with `X⋆⁻¹` on `M_{ℓ-1}` — the one edge
compatibility that is not immediate from `map_X`/`map_Y`.  @census none (helper) -/
theorem map_xStarInv {A B : HCFObj F ℓ} (f : A ⟶ B) (v : A.carrier)
    (hv : v ∈ A.setup.comp ((ℓ : ℤ) - 1)) :
    f.toLinearMap ((A.setup.starInverses hℓ).xStarInv v)
      = (B.setup.starInverses hℓ).xStarInv (f.toLinearMap v) := by
  set IA := A.setup.starInverses hℓ with hIA
  set IB := B.setup.starInverses hℓ with hIB
  have hw : IA.xInv v ∈ A.setup.comp (-((ℓ : ℤ) - 1)) := IA.xInv_mem v hv
  have hXw : (A.setup.X ^ (ℓ - 1)) (IA.xInv v) = v := IA.xInv_right v hv
  have hfw : f.toLinearMap (IA.xInv v) ∈ B.setup.comp (-((ℓ : ℤ) - 1)) := f.map_comp _ _ hw
  have hfv : f.toLinearMap v = (B.setup.X ^ (ℓ - 1)) (f.toLinearMap (IA.xInv v)) := by
    rw [← map_pow_X ℓ f, hXw]
  have key : IB.xInv (f.toLinearMap v) = f.toLinearMap (IA.xInv v) := by
    rw [hfv]
    exact IB.xInv_left _ hfw
  show f.toLinearMap (gammaStarF F ℓ • IA.xInv v) = gammaStarF F ℓ • IB.xInv (f.toLinearMap v)
  rw [map_smul, key]

/-- The edge compatibility of `𝔼_{ℚ[√-1]}(f)`, edge by edge.  @census none (helper) -/
theorem E_F_map_edge {A B : HCFObj F ℓ} (f : A ⟶ B) :
    ∀ (e : Fin 4) (m : V3 A.setup (RQuiver.gelfand.source e)),
      E_F_map_ψ ℓ f (RQuiver.gelfand.target e) (E_F_edge A.setup (A.setup.starInverses hℓ) hℓ e m)
        = E_F_edge B.setup (B.setup.starInverses hℓ) hℓ e
            (E_F_map_ψ ℓ f (RQuiver.gelfand.source e) m)
  | 0, m => Subtype.ext (f.map_X _)
  | 1, m => Subtype.ext (f.map_Y _)
  | 2, m => by
    obtain ⟨v, hv⟩ := m
    refine Subtype.ext ?_
    show f.toLinearMap ((A.setup.starInverses hℓ).xStarInv (A.weight.Y v))
      = (B.setup.starInverses hℓ).xStarInv (B.weight.Y (f.toLinearMap v))
    rw [map_xStarInv ℓ hℓ f _ (y_mem (Q := A.setup) (m := (ℓ : ℤ) + 1) (by ring) hv), f.map_Y]
  | 3, m => by
    obtain ⟨v, hv⟩ := m
    refine Subtype.ext ?_
    show f.toLinearMap (A.weight.X (xStar A.setup v))
      = B.weight.X (xStar B.setup (f.toLinearMap v))
    rw [f.map_X]
    congr 1
    show f.toLinearMap ((gammaStarF F ℓ)⁻¹ • (A.weight.X ^ (ℓ - 1)) v)
      = (gammaStarF F ℓ)⁻¹ • (B.weight.X ^ (ℓ - 1)) (f.toLinearMap v)
    rw [map_smul, map_pow_X]

/-- `𝔼_{ℚ[√-1]}(f)`, a morphism of representations.  @census none (helper)
@clauses   RQ2-5.02-S-O7d -/
noncomputable def E_F_map {A B : HCFObj F ℓ} (f : A ⟶ B) :
    RationalQuiver.Rep.Hom (E_F_obj ℓ hℓ A).toRep (E_F_obj ℓ hℓ B).toRep where
  ψ v := E_F_map_ψ ℓ f v
  edge e m := E_F_map_edge ℓ hℓ f e m
  rational _ _ _ := rfl

theorem E_F_map_ψ_id (A : HCFObj F ℓ) (v : Fin 3) : E_F_map_ψ ℓ (𝟙 A) v = LinearMap.id := rfl

theorem E_F_map_ψ_comp {A B C : HCFObj F ℓ} (f : A ⟶ B) (g : B ⟶ C) (v : Fin 3) :
    E_F_map_ψ ℓ (f ≫ g) v = (E_F_map_ψ ℓ g v).comp (E_F_map_ψ ℓ f v) := rfl

/-- **`𝔼_{ℚ[√-1]}` as a functor** `HC_λ(𝔤,K)_{ℚ[√-1]} → Rep(Γ_{ℚ[√-1]})` — clause `RQ-5.02-C1`
("the assignment is functorial") as a definition.  Its image lies in `Rep^nil` with the relation
(`E_F_isNilpotent`, `E_F_rep_relation`), which is what `E_F_equivalence` records.

@census    none (auxiliary; discharges census clause `RQ-5.02-C1`)
@source    UNLABELED-EQi-equivalence
(clauses of the frozen original:)   RQ-5.02-C1
@imports   none
@divergence none -/
noncomputable def E_F : HCF F ℓ ⥤ RationalQuiver.FDRep (gelfandSplit F) where
  obj := E_F_obj ℓ hℓ
  map f := E_F_map ℓ hℓ f
  map_id A := by
    refine RationalQuiver.Rep.Hom.ext (funext fun v => ?_)
    exact (E_F_map_ψ_id ℓ A v)
  map_comp f g := by
    refine RationalQuiver.Rep.Hom.ext (funext fun v => ?_)
    exact (E_F_map_ψ_comp ℓ f g v)

end Functor

/-! ### Generic helpers on representations of the split quivers (v2 WP-9)

Three lemmas about representations of a split rational quiver (`Gal(F/F) = 1`), used by
`Split/EssSurj` (`isoPoly`) and `Split/Cyclic`; carried from v1 (where they sat next to the deleted
engine `E11`) with their v1 names. -/

section SplitRepHelpers

variable {F : Type} [Field F] [CharZero F]

/-- The Galois group of `ℚ[√-1]/ℚ[√-1]` is trivial: an `E`-algebra automorphism of `E` fixes `E`
pointwise.  @census none (helper) -/
theorem galSelf_eq_one (σ : Gal(F/F)) : σ = 1 :=
  AlgEquiv.ext fun a => galSelf_apply F σ a

/-- `Rep.Hom`'s `rational` field, read at a NAMED target vertex, for the split quiver.
@census none (helper) -/
theorem sp_rational_of_phi' {M N : RationalQuiver.Rep (gelfandSplit F)}
    (psi : ∀ v : (gelfandSplit F).V, M.M v →ₗ[F] N.M v)
    {σ : Gal(F/F)} {v w : (gelfandSplit F).V} (hvw : σ • v = w)
    (m : M.M v) (H : psi w (M.φ' σ hvw m) = N.φ' σ hvw (psi v m)) :
    psi (σ • v) (M.φ σ v m) = N.φ σ v (psi v m) := by
  subst hvw; exact H

/-- A `Rep.Hom` with invertible vertex components has an inverse, for the split quiver.
@census none (helper) -/
def spRepHomInv {M N : RationalQuiver.Rep (gelfandSplit F)}
    (f : RationalQuiver.Rep.Hom M N)
    (g : ∀ v : (gelfandSplit F).V, N.M v →ₗ[F] M.M v)
    (hgf : ∀ v x, g v (f.ψ v x) = x) (hfg : ∀ v y, f.ψ v (g v y) = y) :
    RationalQuiver.Rep.Hom N M where
  ψ := g
  edge e m := by
    have h := f.edge e (g _ m)
    rw [hfg] at h
    rw [← h, hgf]
  rational σ v m := by
    have h := f.rational σ v (g v m)
    rw [hfg] at h
    rw [← h, hgf]

end SplitRepHelpers


end RationalQuivers.Gelfand.Split
