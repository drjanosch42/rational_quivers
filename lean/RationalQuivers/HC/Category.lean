module

public import RationalQuivers.HC.Classical
public import RationalQuivers.HC.ImagUnit
public import RationalQuivers.Unipotent.Twist
public import Mathlib.CategoryTheory.Preadditive.Basic
public import Mathlib.CategoryTheory.Linear.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Tower

@[expose] public section

/-!
# `HC_λ(𝔤,K)_E` over every field `E` of characteristic `0` (`def:HClambdaE`)


## Contents, in order

1. **`HCObjOver ℓ F`** (moved here unchanged from the v1 module `HC/IntendedModel.lean`): a graded `𝔰𝔩₂`-module over a field `F` of characteristic `0` with generalized
   infinitesimal character `λ = ℓ²`, finitely generated and admissible — the split-torus reading of a
   Harish-Chandra module over `F`, with its category, `Preadditive` and `F`-linear structure, and the
   G5.2 witness `stdHCObjOver` (`F_2 = ℂ²` at `ℓ = 2`).
2. **`parity`, `HCLambda ℓ F`** (moved here from `Gelfand/GeneralBaseCategory.lean`, namespace
   `Gelfand` → `HC`): the central-character cut `M_n = ⊥` for `n ≢ ℓ − 1 (mod 2)`; `HCLambda ℓ F` is
   `HC_λ(𝔤,K)_F` for a field `F ∋ √-1` (split torus), the category of tex §5.1.
3. **`HC ℓ E D`** for `D : ImagUnit E` — `def:HClambdaE` in the **descent presentation** (`EX-HC`):
   an `E`-vector space `M_E`, its base change `M_{L_E} = L_E ⊗_E M_E` with the weight data, and the
   `G_E`-compatibility of the induced semilinear action `σ ⊗ 1` as a **property** over all
   `σ ∈ G_E`; morphisms are the `L_E`-linear maps commuting with `H, X, Y`, the grading and every
   `σ`, i.e. the base changes of the `E`-linear maps of the forms.
4. The base-change functor `HC ℓ E D ⥤ HCLambda ℓ L_E` (`M_E ↦ M_{L_E}`) and the **`|G_E| = 1`
   identification** `HC ℓ E D ≌ HCLambda ℓ L_E` when `√-1 ∈ E`.
-/

universe u

namespace RationalQuivers.HC

open CategoryTheory
open scoped TensorProduct

section ObjOver

/-! ## The `(𝔤,K)`-span over a general base field -/

variable {E : Type u} [Field E] {V : Type u} [AddCommGroup V] [Module E V]

/-- The **`(𝔤,K)`-submodule generated by `S`** over a general characteristic-zero base field: the
smallest `E`-submodule containing `S` that is stable under the triple (`WeightData.OpStable`) and
homogeneous for the grading (`WeightData.IsHomog`).

This is `HC/Classical.lean`'s `gkSpan` with the ℂ-only `SO(2,ℝ)`-action replaced by the grading it
induces — over `ℂ` the two agree in substance (`HarishChandraModule.exists_homogeneous_generators`
is exactly the passage from one to the other), and over a general `E` the grading is all the
`K`-structure there is.

@census none
-/
def gkSpanOver (W : WeightData E V) (S : Set V) : Submodule E V :=
  sInf {N | S ⊆ (N : Set V) ∧ W.OpStable N ∧ W.IsHomog N}

/-- If `S` already spans `V` as an `E`-vector space then it generates it as a `(𝔤,K)`-module.
The direction the G5 witness needs; the converse is false and is not claimed.

@census none
-/
theorem gkSpanOver_eq_top_of_span_eq_top (W : WeightData E V) {S : Set V}
    (hS : Submodule.span E S = ⊤) : gkSpanOver W S = ⊤ := by
  refine le_antisymm le_top (le_sInf ?_)
  rintro N ⟨hSN, -, -⟩
  have : Submodule.span E S ≤ N := Submodule.span_le.mpr hSN
  rw [hS] at this
  exact this

/-! ## The category `HC(𝔤,K)_E` -/

/-- **An object of `HC_λ(𝔤,K)_E`** (`§3.3` over a general characteristic-zero base field, in
Januszewski18's `(𝔞_k,B_k)` formalism): an `E`-vector space with the `𝔰𝔩₂`-weight decomposition of
`RQ2-3.11` (clauses `H1`, `C2`, `C3`), **finitely generated** as a `(𝔤,K)`-module (clause `C1`),
**admissible** (clause `C2`), and **sliced to the generalized infinitesimal character `λ = ℓ²`**
(`RQ2-3.03-C5`, `RQ2-3.02`) — the `λ` of `HC_λ`.

It is *not* a restatement of `RQ2-3.11`'s `HarishChandraModule`, which is the source's own ℂ-only
definition and stays untouched: this is the `E`-generic carrier by which the archived
`HC.intendedModel` (`Archive/HC/IntendedModel.lean`) interprets the archived imported category
`HCInterface.cat E`; that module's docstring says why `HCObj` cannot be (2026-10-21, O-V2-6: the
earlier "see the module docstring" pointed at v1's `HC/IntendedModel.lean`).  The
`K`-structure is the grading, which is what the `K`-action amounts to over ℂ and all that survives
over a general `E`.

**The `λ`-slice.**  This structure carries the generalized infinitesimal character (`gic`) but not
the central character: that is the parity cut `HC.parity` below (`-1₂` acts on `M_n` by
`χ_n(-1₂) = (-1)^n`, so "`-1₂` acts by `(-1)^{ℓ-1}`" is `M_n = ⊥` for `n ≢ ℓ - 1 (mod 2)`), and
`HCLambda ℓ E` is the full subcategory it cuts out.

@census none
-/
structure HCObjOver (ℓ : ℕ) (E : Type u) [Field E] [CharZero E] : Type (u + 1) where
  /-- the underlying `E`-vector space -/
  carrier : Type u
  [addCommGroup : AddCommGroup carrier]
  [module : Module E carrier]
  /-- the weight decomposition `M = ⨁_n M_n` with the triple acting (`RQ2-3.11-H1`, `C2`, `C3`) -/
  weight : WeightData E carrier
  /-- `RQ2-3.03-C5`: the generalized infinitesimal character is `λ = ℓ²` — the `λ` of `HC_λ(𝔤,K)_E`.
  This is the index the archived imported category's own docstring
  (`Archive/Imports/Januszewski18.lean`) calls "sliced to a fixed generalized infinitesimal
  character `λ`". -/
  gic : HasGeneralizedInfinitesimalCharacter weight ℓ
  /-- `RQ2-3.11-C1`: finitely generated as a `(𝔤,K)`-module -/
  fg : ∃ S : Finset carrier, gkSpanOver weight (↑S : Set carrier) = ⊤
  /-- `RQ2-3.11-C2`: admissible — every isotypic component is finite-dimensional -/
  admissible : ∀ n : ℤ, FiniteDimensional E (weight.comp n)

attribute [instance] HCObjOver.addCommGroup HCObjOver.module

variable [CharZero E] {ℓ : ℕ}

/-- Projection of `HCObjOver.gic` (`rqaudit liveness`); it is also the statement that the model's
objects really are `HC_λ`'s and not `HC`'s.

@census none
-/
theorem HCObjOver.gic' (A : HCObjOver.{u} ℓ E) :
    HasGeneralizedInfinitesimalCharacter A.weight ℓ := A.gic

/-- Projection of `HCObjOver.fg`, so the clause it carries is projected by a named declaration
(`rqaudit liveness`).

@census none
-/
theorem HCObjOver.fg' (A : HCObjOver.{u} ℓ E) :
    ∃ S : Finset A.carrier, gkSpanOver A.weight (↑S : Set A.carrier) = ⊤ := A.fg

/-- Projection of `HCObjOver.admissible` (`rqaudit liveness`).

@census none
-/
theorem HCObjOver.admissible' (A : HCObjOver.{u} ℓ E) (n : ℤ) :
    FiniteDimensional E (A.weight.comp n) := A.admissible n

/-- **A morphism of `HC(𝔤,K)_E`**: an `E`-linear map commuting with `H`, `X` and `Y`.

No grading-preservation is imposed: in characteristic zero it is *entailed*, because `H` acts on
`M_n` by the scalar `n` and the integers are pairwise distinct in `E`.  Nor is `K`-equivariance,
which over a general `E` is not expressible and over `ℂ` is the same condition again.

@census none
-/
structure HCHomOver (A B : HCObjOver.{u} ℓ E) where
  /-- the underlying `E`-linear map -/
  toLinearMap : A.carrier →ₗ[E] B.carrier
  /-- it commutes with `H` -/
  map_H : ∀ v, toLinearMap (A.weight.H v) = B.weight.H (toLinearMap v)
  /-- it commutes with `X` -/
  map_X : ∀ v, toLinearMap (A.weight.X v) = B.weight.X (toLinearMap v)
  /-- it commutes with `Y` -/
  map_Y : ∀ v, toLinearMap (A.weight.Y v) = B.weight.Y (toLinearMap v)

namespace HCHomOver

variable {A B : HCObjOver.{u} ℓ E}

@[ext] theorem hom_ext {f g : HCHomOver A B} (h : f.toLinearMap = g.toLinearMap) : f = g := by
  cases f; cases g; simp_all

theorem toLinearMap_injective : Function.Injective (HCHomOver.toLinearMap : HCHomOver A B → _) :=
  fun _ _ h => hom_ext h

end HCHomOver

/-- `HC(𝔤,K)_E` is a category.

@census none
-/
instance instCategoryHCObjOver : CategoryTheory.Category (HCObjOver.{u} ℓ E) where
  Hom A B := HCHomOver A B
  id A := ⟨LinearMap.id, fun _ => rfl, fun _ => rfl, fun _ => rfl⟩
  comp f g :=
    ⟨g.toLinearMap.comp f.toLinearMap,
      fun v => by simp [f.map_H, g.map_H],
      fun v => by simp [f.map_X, g.map_X],
      fun v => by simp [f.map_Y, g.map_Y]⟩
  id_comp _ := by apply HCHomOver.hom_ext; rfl
  comp_id _ := by apply HCHomOver.hom_ext; rfl
  assoc _ _ _ := by apply HCHomOver.hom_ext; rfl

namespace HCHomOver

variable {A B : HCObjOver.{u} ℓ E}

instance : Zero (HCHomOver A B) :=
  ⟨⟨0, fun _ => by simp, fun _ => by simp, fun _ => by simp⟩⟩

instance : Add (HCHomOver A B) :=
  ⟨fun f g => ⟨f.toLinearMap + g.toLinearMap,
    fun v => by simp [f.map_H, g.map_H],
    fun v => by simp [f.map_X, g.map_X],
    fun v => by simp [f.map_Y, g.map_Y]⟩⟩

instance : Neg (HCHomOver A B) :=
  ⟨fun f => ⟨-f.toLinearMap,
    fun v => by simp [f.map_H],
    fun v => by simp [f.map_X],
    fun v => by simp [f.map_Y]⟩⟩

instance : Sub (HCHomOver A B) :=
  ⟨fun f g => ⟨f.toLinearMap - g.toLinearMap,
    fun v => by simp [f.map_H, g.map_H],
    fun v => by simp [f.map_X, g.map_X],
    fun v => by simp [f.map_Y, g.map_Y]⟩⟩

instance : SMul ℕ (HCHomOver A B) :=
  ⟨fun n f => ⟨n • f.toLinearMap,
    fun v => by simp [f.map_H],
    fun v => by simp [f.map_X],
    fun v => by simp [f.map_Y]⟩⟩

instance : SMul ℤ (HCHomOver A B) :=
  ⟨fun n f => ⟨n • f.toLinearMap,
    fun v => by simp [f.map_H],
    fun v => by simp [f.map_X],
    fun v => by simp [f.map_Y]⟩⟩

instance : SMul E (HCHomOver A B) :=
  ⟨fun c f => ⟨c • f.toLinearMap,
    fun v => by simp [f.map_H, map_smul],
    fun v => by simp [f.map_X, map_smul],
    fun v => by simp [f.map_Y, map_smul]⟩⟩

instance instAddCommGroup : AddCommGroup (HCHomOver A B) :=
  Function.Injective.addCommGroup HCHomOver.toLinearMap toLinearMap_injective rfl
    (fun _ _ => rfl) (fun _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)

/-- `toLinearMap`, bundled as an additive map — the bridge `Function.Injective.module` needs.

@census none
-/
def toLinearMapAddHom : HCHomOver A B →+ (A.carrier →ₗ[E] B.carrier) where
  toFun := HCHomOver.toLinearMap
  map_zero' := rfl
  map_add' _ _ := rfl

instance instModule : Module E (HCHomOver A B) :=
  Function.Injective.module E toLinearMapAddHom toLinearMap_injective (fun _ _ => rfl)

@[simp] theorem smul_toLinearMap (c : E) (f : HCHomOver A B) :
    (c • f).toLinearMap = c • f.toLinearMap := rfl

@[simp] theorem comp_toLinearMap {C : HCObjOver.{u} ℓ E} (f : A ⟶ B) (g : B ⟶ C) :
    (f ≫ g).toLinearMap = g.toLinearMap.comp f.toLinearMap := rfl

end HCHomOver

/-- `HC(𝔤,K)_E` is **preadditive**.

@census none
-/
instance instPreadditiveHCObjOver : CategoryTheory.Preadditive (HCObjOver.{u} ℓ E) where
  homGroup A B := (inferInstance : AddCommGroup (HCHomOver A B))
  add_comp _ _ _ _ _ _ := by apply HCHomOver.hom_ext; exact LinearMap.comp_add _ _ _
  comp_add _ _ _ _ _ _ := by apply HCHomOver.hom_ext; exact LinearMap.add_comp _ _ _

/-- `HC(𝔤,K)_E` is **`E`-linear** — the archived `HCInterface` bundle's `isLinear`, CONSTRUCTED
(in `Archive/HC/IntendedModel.lean`).

@census none
-/
instance instLinearHCObjOver : CategoryTheory.Linear E (HCObjOver.{u} ℓ E) where
  homModule A B := (inferInstance : Module E (HCHomOver A B))
  smul_comp _ _ _ r f g := by
    apply HCHomOver.hom_ext
    ext v
    exact map_smul g.toLinearMap r (f.toLinearMap v)
  comp_smul _ _ _ _ _ _ := by
    apply HCHomOver.hom_ext
    ext _
    rfl

/-! ## `stdHC` as an object of `HC(𝔤,K)_ℂ` — the G5.2 non-degeneracy witness -/

/-- **G5.2 witness.** `RQ2-3.11`'s non-degenerate Harish-Chandra module — the standard representation
`F_2 = ℂ²` at `ℓ = 2`, with `M_1 = ℂ × 0`, `M_{-1} = 0 × ℂ` and `X ≠ 0 ≠ Y` — carried into
`HC(𝔤,K)_ℂ`.  Its weight data is `stdHC`'s, unchanged; the `K`-action `stdHC.rep` is exactly what
the passage to the `E`-generic formalism forgets, and it is determined by the grading.

@census none
-/
noncomputable def stdHCObjOver : HCObjOver.{0} 2 ℂ where
  carrier := ℂ × ℂ
  weight := stdWeight
  gic := stdWeight_gic
  fg := by
    refine ⟨{((1 : ℂ), (0 : ℂ)), ((0 : ℂ), (1 : ℂ))}, ?_⟩
    refine gkSpanOver_eq_top_of_span_eq_top _ ?_
    refine le_antisymm le_top ?_
    rintro ⟨a, b⟩ -
    have h1 : ((1 : ℂ), (0 : ℂ)) ∈ Submodule.span ℂ
        (↑({((1 : ℂ), (0 : ℂ)), ((0 : ℂ), (1 : ℂ))} : Finset (ℂ × ℂ)) : Set (ℂ × ℂ)) := by
      apply Submodule.subset_span; simp
    have h2 : ((0 : ℂ), (1 : ℂ)) ∈ Submodule.span ℂ
        (↑({((1 : ℂ), (0 : ℂ)), ((0 : ℂ), (1 : ℂ))} : Finset (ℂ × ℂ)) : Set (ℂ × ℂ)) := by
      apply Submodule.subset_span; simp
    have := add_mem (Submodule.smul_mem _ a h1) (Submodule.smul_mem _ b h2)
    simpa using this
  admissible _ := inferInstance

/-- **G5.1 inhabitant of `HCHomOver`**: the identity of the G5.2 witness.

@census none
-/
noncomputable def stdHCHomOver : HCHomOver stdHCObjOver stdHCObjOver := 𝟙 stdHCObjOver


end ObjOver

/-! ## (iv) The `C3` parity cut: `HC_λ(𝔤,K)_E` inside `HCObjOver ℓ E` -/

/-- `RQ2-3.03-C6` over a general `E`: `-1₂` acts on `M_n` by `χ_n(-1₂) = (-1)^n`, so
"acts by `(-1)^{ℓ-1}`" is "`M_n = ⊥` unless `n ≡ ℓ - 1 (mod 2)`".

@census none (helper) -/
def parity (ℓ : ℕ) (E : Type u) [Field E] [CharZero E] : ObjectProperty (HCObjOver.{u} ℓ E) :=
  fun A => ∀ n : ℤ, (n - ((ℓ : ℤ) - 1)) % 2 ≠ 0 → A.weight.comp n = ⊥

/-- **`HC_λ(𝔤,K)_E` for `√-1 ∈ E`** — the full subcategory of `HCObjOver ℓ E` cut out by the
central-character (parity) condition.

@census none (helper) -/
abbrev HCLambda (ℓ : ℕ) (E : Type u) [Field E] [CharZero E] : Type (u + 1) :=
  (parity ℓ E).FullSubcategory

example (ℓ : ℕ) (E : Type u) [Field E] [CharZero E] : CategoryTheory.Category (HCLambda.{u} ℓ E) := inferInstance
example (ℓ : ℕ) (E : Type u) [Field E] [CharZero E] : Preadditive (HCLambda.{u} ℓ E) :=
  inferInstance
example (ℓ : ℕ) (E : Type u) [Field E] [CharZero E] : Linear E (HCLambda.{u} ℓ E) := inferInstance

/-- The G5.2 witness of `HCObjOver` survives the parity cut (probe `P7`).  @census none (helper) -/
theorem stdHCObjOver_parity : parity 2 ℂ stdHCObjOver := by
  intro n hn
  have h1 : n ≠ 1 := by rintro rfl; simp at hn
  have h2 : n ≠ -1 := by rintro rfl; norm_num at hn
  show stdWeight.comp n = ⊥
  rw [stdWeight_comp, stdComp_of_ne h1 h2]

/-- **G5 inhabitant of `HCLambda`**: `RQ2-3.11`'s `F_2 = ℂ²` at `ℓ = 2`.  @census none (helper) -/
noncomputable def stdHCLambda : HCLambda.{0} 2 ℂ := ⟨stdHCObjOver, stdHCObjOver_parity⟩

/-! ## Grading preservation is entailed in characteristic zero

`HCHomOver` does not impose grading preservation: in characteristic zero it is entailed, because
`H` acts on `M_n` by the scalar `n` and distinct integers are distinct scalars
(`WeightData.map_comp_of_map_H`). -/

/-- `H` preserves the grading: it acts on `M_n` by the scalar `n`.

@census none (helper) -/
theorem WeightData.H_graded {E : Type u} [Field E] {M : Type u} [AddCommGroup M] [Module E M]
    (W : WeightData E M) (n : ℤ) (v : M) (hv : v ∈ W.comp n) : W.H v ∈ W.comp n := by
  rw [W.H_apply n v hv]
  exact Submodule.smul_mem _ _ hv

/-- **Grading preservation is entailed.**  An
`E`-linear map between graded `𝔰𝔩₂`-modules that commutes with `H` automatically **preserves the
grading**, in characteristic zero: `H` acts on `M_n` by `n`, and distinct integers are distinct
scalars, so no component can move.

So `HCHomOver` (no grading condition) and the categories that impose it have the same morphisms.

@census none (helper) -/
theorem WeightData.map_comp_of_map_H {E : Type u} [Field E] [CharZero E]
    {M N : Type u} [AddCommGroup M] [Module E M] [AddCommGroup N] [Module E N]
    (W : WeightData E M) (V : WeightData E N) (f : M →ₗ[E] N)
    (hf : ∀ v, f (W.H v) = V.H (f v)) (n : ℤ) (v : M) (hv : v ∈ W.comp n) :
    f v ∈ V.comp n := by
  classical
  have hHfv : V.H (f v) = (n : E) • f v := by
    rw [← hf v, W.H_apply n v hv, map_smul]
  have hzero : ∀ m : ℤ, m ≠ n → V.proj m (f v) = 0 := by
    intro m hm
    have h1 : V.H (V.proj m (f v)) = (m : E) • V.proj m (f v) :=
      V.H_apply m _ (V.proj_mem m (f v))
    have h2 : V.H (V.proj m (f v)) = (n : E) • V.proj m (f v) := by
      rw [← V.proj_comm_of_graded V.H (WeightData.H_graded V) m (f v), hHfv, map_smul]
    have h3 : ((m : E) - (n : E)) • V.proj m (f v) = 0 := by
      rw [sub_smul, ← h1, ← h2, sub_self]
    have hne : ((m : E) - (n : E)) ≠ 0 := by
      intro h
      exact hm (by exact_mod_cast sub_eq_zero.mp h)
    exact (smul_eq_zero.mp h3).resolve_left hne
  obtain ⟨s, hs, hsum⟩ := V.exists_sum_proj (f v)
  have hfv : f v = V.proj n (f v) := by
    conv_lhs => rw [← hsum]
    by_cases hn : n ∈ s
    · exact Finset.sum_eq_single n (fun m _ hmn => hzero m hmn) (fun h => absurd hn h)
    · rw [Finset.sum_congr rfl (fun m hm => hzero m (fun h => hn (h ▸ hm))), Finset.sum_const_zero,
        hs n hn]
  rw [hfv]
  exact V.proj_mem n (f v)

/-! ## `HC_λ(𝔤,K)_E` over `D : ImagUnit E` — the descent presentation (`def:HClambdaE`, `EX-HC`) -/

section Descent

open RationalQuivers.Unipotent

set_option linter.dupNamespace false

variable {E : Type} [Field E] (D : ImagUnit E)

section GalAct

variable {Mq : Type} [AddCommGroup Mq] [Module E Mq] {Mi : Type} [AddCommGroup Mi] [Module D.L Mi]

/-- The `σ`-semilinear action on `M_{L_E}` **induced by the form**: `σ ⊗ 1` on `L_E ⊗_E M_E`,
transported along the base change `b : L_E ⊗_E M_E ≃ M_{L_E}`.  @census none (helper) -/
noncomputable def galActOf (b : (D.L ⊗[E] Mq) ≃ₗ[D.L] Mi) (σ : D.L ≃ₐ[E] D.L) : Mi ≃+ Mi :=
  (b.symm.toAddEquiv.trans (galoisTwistEquiv σ)).trans b.toAddEquiv

variable {D}

theorem galActOf_apply (b : (D.L ⊗[E] Mq) ≃ₗ[D.L] Mi) (σ : D.L ≃ₐ[E] D.L) (v : Mi) :
    galActOf D b σ v = b (galoisTwist σ (b.symm v)) := rfl

/-- `σ ⊗ 1` is `σ`-semilinear.  @census none (helper) -/
theorem galActOf_smul (b : (D.L ⊗[E] Mq) ≃ₗ[D.L] Mi) (σ : D.L ≃ₐ[E] D.L) (a : D.L) (v : Mi) :
    galActOf D b σ (a • v) = σ a • galActOf D b σ v := by
  simp only [galActOf_apply, map_smul, galoisTwist_smul]

theorem galActOf_one (b : (D.L ⊗[E] Mq) ≃ₗ[D.L] Mi) (v : Mi) : galActOf D b 1 v = v := by
  simp [galActOf_apply]

/-- `G_E` **acts**: `(στ) ⊗ 1 = (σ ⊗ 1)(τ ⊗ 1)`.  @census none (helper) -/
theorem galActOf_mul (b : (D.L ⊗[E] Mq) ≃ₗ[D.L] Mi) (σ τ : D.L ≃ₐ[E] D.L) (v : Mi) :
    galActOf D b (σ * τ) v = galActOf D b σ (galActOf D b τ v) := by
  simp only [galActOf_apply, galoisTwist_mul, LinearMap.comp_apply, LinearEquiv.symm_apply_apply]

/-- `M_E` is fixed: `(σ ⊗ 1)(1 ⊗ v) = 1 ⊗ v`.  @census none (helper) -/
theorem galActOf_tmul (b : (D.L ⊗[E] Mq) ≃ₗ[D.L] Mi) (σ : D.L ≃ₐ[E] D.L) (v : Mq) :
    galActOf D b σ (b ((1 : D.L) ⊗ₜ[E] v)) = b ((1 : D.L) ⊗ₜ[E] v) := by
  simp [galActOf_apply]

/-- `σ ⊗ 1` fixes `E`-scalars: `σ(a • v) = a • σ v` for `a ∈ E`.  @census none (helper) -/
theorem galActOf_algebraMap_smul (b : (D.L ⊗[E] Mq) ≃ₗ[D.L] Mi) (σ : D.L ≃ₐ[E] D.L) (a : E)
    (v : Mi) : galActOf D b σ (algebraMap E D.L a • v) = algebraMap E D.L a • galActOf D b σ v := by
  rw [galActOf_smul, AlgEquiv.commutes]

end GalAct

/-- **`G_E`-compatibility of one `σ ∈ G_E`**, with sign `s = χ_E(σ)` (plan §3.3): `σ M_n = M_{s n}`,
`σ H = s H σ`; `σ X = X σ`, `σ Y = Y σ` if `s = 1`, and `σ X = Y σ`, `σ Y = X σ` if `s = -1`
(`RQ2-3.10-C3`: `cH = -H`, `cX = Y`, `cY = X`).  @census none (helper)
@clauses   RQ2-5.12-S-O1 -/
structure GalCompat {Mi : Type} [AddCommGroup Mi] [Module D.L Mi] (W : WeightData D.L Mi)
    (g : Mi ≃+ Mi) (s : ℤˣ) : Prop where
  comp : ∀ (n : ℤ) (v : Mi), v ∈ W.comp n → g v ∈ W.comp ((s : ℤ) * n)
  H : ∀ v, g (W.H v) = (s : ℤ) • W.H (g v)
  X_one : s = 1 → ∀ v, g (W.X v) = W.X (g v)
  Y_one : s = 1 → ∀ v, g (W.Y v) = W.Y (g v)
  X_neg : s = -1 → ∀ v, g (W.X v) = W.Y (g v)
  Y_neg : s = -1 → ∀ v, g (W.Y v) = W.X (g v)

variable [CharZero E]

/-- **Definition** (`def:HClambdaE`).  Let `E` be a field of characteristic `0`, `ℓ ≥ 0`,
`λ = ℓ²`, and `D : ImagUnit E` the datum `L_E = E(√-1)`.  An object of `HC_λ(𝔤,K)_E` is, in the
**descent presentation**: an `E`-vector space `M_E` (`form`); its base change
`M_{L_E} = L_E ⊗_E M_E` (`carrier`, `baseChange`) with the isotypic decomposition
`M_{L_E} = ⨁_n M_{L_E}[χ_n]` and the action of `H, X, Y` (`weight`); such that
`M_{L_E}` has generalized infinitesimal character `λ` (`gic`), every `M_{L_E}[χ_n]` is
finite-dimensional (`admissible`), `-1₂ ∈ K_E(E)` acts by `(-1)^{ℓ-1}`, i.e. `M_n = 0` unless
`n ≡ ℓ - 1 (mod 2)` (`centralCharacter`), `M_{L_E}` is finitely generated as a `(𝔤,K)`-module
(`fg`); and the `𝔤`- and `K`-actions are **defined over `E`**: for every `σ ∈ G_E` the
semilinear `σ ⊗ 1` satisfies `GalCompat` with sign `χ_E(σ)` (`galCompat`).  Morphisms
(`HC.Hom`): all `L_E`-linear maps commuting with `H, X, Y`, the grading and every `σ ⊗ 1`, i.e.
the base changes of the `E`-linear `(𝔤_E,K_E)`-maps of the forms — so the category is **full**.

@census    RQ2-3.03
@source    def:HClambdaE
@clauses   RQ2-3.03-H1, RQ2-3.03-H2, RQ2-3.03-C1, RQ2-3.03-C2, RQ2-3.03-C3, RQ2-3.03-C4,
  RQ2-3.03-C5, RQ2-3.03-C6,
  RQ2-5.12-S-O2
@imports   none
@divergence JUSTIFIED_REFORMULATION (the descent presentation, `EX-HC`).  The tex defines a Harish-Chandra module over `E` as a `(𝔤_E,K_E)`-module in the sense of
`def:rationalpairs` (clause `C1`); Lean presents it through its base change to `L_E`, where `K_E`
splits and its action is the grading, together with the descent datum that the actions are
defined over `E` (`σ ⊗ 1` intertwines them according to `χ_E(σ)`).  The intrinsic
`(𝔤_E,K_E)`-module reading is not formalized (`EX-HC`; `def:rationalpairs` is `OUT`, `EX-J18`).
Clause `C2` (finite generation) and `C5` (generalized infinitesimal character) are imposed on
`M_{L_E}`; for `M_E` they are equivalent (`L_E/E` is faithfully flat, and `C` lies in `U(𝔤_E)`),
the equivalence is not stated.  Clause `C3` (admissibility) is literal: the tex defines it through
`(L_E ⊗_E M)[χ_n]`.  Clause `C6` is the parity rendering of the central character,
`χ_n(-1₂) = (-1)^n`; its equivalence with the `ℂ`-side `HarishChandraModule.centralCharacter` is
part of `rmk:HClambdaC` (`RQ2-3.15`, not stated here).  **`WEAKENED_OR_PARTIAL` on `C4`**: there is
no ambient Lean category of all Harish-Chandra modules over `E`; what is stated is that `HC.Hom`
consists of all `L_E`-linear maps compatible with the presented structure and the descent datum,
and, for `√-1 ∈ E`, that base change identifies `HC ℓ E D` with the full subcategory `HCLambda ℓ D.L`
of `HCObjOver ℓ D.L` (`toLambda`, `toLambda_full`, `lambdaEquiv`), the split-torus reading of tex §5.1;
here `L_E` is the field `D.L`, which `algebraMap E D.L` identifies with `E` when `√-1 ∈ E`
(`ImagUnit.algebraMap_bijective_of_sqrt`).  `E` and
`M_E` live in `Type` (universe `0`).
-/
structure HC (ℓ : ℕ) (E : Type) [Field E] [CharZero E] (D : ImagUnit E) where
  /-- `M_E` -/
  form : Type
  [formAddCommGroup : AddCommGroup form]
  [formModule : Module E form]
  /-- `M_{L_E}` -/
  carrier : Type
  [addCommGroup : AddCommGroup carrier]
  [module : Module D.L carrier]
  /-- `M_{L_E} = L_E ⊗_E M_E` -/
  baseChange : (D.L ⊗[E] form) ≃ₗ[D.L] carrier
  /-- `M_{L_E}[χ_n]`, `H`, `X`, `Y` -/
  weight : WeightData D.L carrier
  /-- generalized infinitesimal character `λ = ℓ²` -/
  gic : HasGeneralizedInfinitesimalCharacter weight ℓ
  /-- the actions are defined over `E`: `G_E`-compatibility over **all** `σ ∈ G_E` -/
  galCompat : ∀ σ : D.L ≃ₐ[E] D.L, GalCompat D weight (galActOf D baseChange σ) (D.chi σ)
  /-- admissibility -/
  admissible : ∀ n : ℤ, FiniteDimensional D.L (weight.comp n)
  /-- the central character: `-1₂` acts by `(-1)^{ℓ-1}` -/
  centralCharacter : ∀ n : ℤ, (n - ((ℓ : ℤ) - 1)) % 2 ≠ 0 → weight.comp n = ⊥
  /-- finite generation as a `(𝔤,K)`-module -/
  fg : ∃ S : Finset carrier, gkSpanOver weight (↑S : Set carrier) = ⊤

attribute [instance] HC.formAddCommGroup HC.formModule HC.addCommGroup HC.module

namespace HC

variable {D} {ℓ : ℕ}

/-- The Galois action of `σ ∈ G_E` on `M_{L_E}`.  @census none (helper) -/
noncomputable abbrev galAct (A : HC ℓ E D) (σ : D.L ≃ₐ[E] D.L) : A.carrier ≃+ A.carrier :=
  galActOf D A.baseChange σ

/-- Projection of `galCompat` (`rqaudit liveness`).  @census none (helper) -/
theorem galCompat' (A : HC ℓ E D) (σ : D.L ≃ₐ[E] D.L) :
    GalCompat D A.weight (A.galAct σ) (D.chi σ) := A.galCompat σ

theorem gic' (A : HC ℓ E D) : HasGeneralizedInfinitesimalCharacter A.weight ℓ := A.gic

theorem admissible' (A : HC ℓ E D) (n : ℤ) : FiniteDimensional D.L (A.weight.comp n) :=
  A.admissible n

theorem centralCharacter' (A : HC ℓ E D) (n : ℤ) (hn : (n - ((ℓ : ℤ) - 1)) % 2 ≠ 0) :
    A.weight.comp n = ⊥ := A.centralCharacter n hn

theorem fg' (A : HC ℓ E D) :
    ∃ S : Finset A.carrier, gkSpanOver A.weight (↑S : Set A.carrier) = ⊤ := A.fg

/-- **`χ_E(σ) = 1` acts trivially** (the `|G_E| = 1` part).  @census none (helper) -/
theorem galAct_of_chi_one (A : HC ℓ E D) {σ : D.L ≃ₐ[E] D.L} (hσ : D.chi σ = 1) (v : A.carrier) :
    A.galAct σ v = v := by
  rw [D.eq_one_of_chi_one hσ]; exact galActOf_one _ v

/-- The `χ_E(σ) = -1` clauses, unpacked: `σ M_n = M_{-n}`, `σ X = Y σ`, `σ Y = X σ`,
`σ H = -H σ`.  @census none (helper) -/
theorem compat_neg (A : HC ℓ E D) {σ : D.L ≃ₐ[E] D.L} (hσ : D.chi σ = -1) :
    (∀ (n : ℤ) (v : A.carrier), v ∈ A.weight.comp n → A.galAct σ v ∈ A.weight.comp (-n)) ∧
    (∀ v, A.galAct σ (A.weight.X v) = A.weight.Y (A.galAct σ v)) ∧
    (∀ v, A.galAct σ (A.weight.Y v) = A.weight.X (A.galAct σ v)) ∧
    (∀ v, A.galAct σ (A.weight.H v) = -A.weight.H (A.galAct σ v)) := by
  have hc := A.galCompat σ
  refine ⟨fun n v hv => ?_, hc.X_neg hσ, hc.Y_neg hσ, fun v => ?_⟩
  · have := hc.comp n v hv; rwa [hσ, Units.val_neg, Units.val_one, neg_one_mul] at this
  · rw [hc.H v, hσ, Units.val_neg, Units.val_one, neg_one_zsmul]

/-- The `χ_E(σ) = 1` clauses, unpacked: `σ M_n = M_n`, `σ X = X σ`, `σ Y = Y σ`, `σ H = H σ`.
@census none (helper) -/
theorem compat_pos (A : HC ℓ E D) {σ : D.L ≃ₐ[E] D.L} (hσ : D.chi σ = 1) :
    (∀ (n : ℤ) (v : A.carrier), v ∈ A.weight.comp n → A.galAct σ v ∈ A.weight.comp n) ∧
    (∀ v, A.galAct σ (A.weight.X v) = A.weight.X (A.galAct σ v)) ∧
    (∀ v, A.galAct σ (A.weight.Y v) = A.weight.Y (A.galAct σ v)) ∧
    (∀ v, A.galAct σ (A.weight.H v) = A.weight.H (A.galAct σ v)) := by
  have hc := A.galCompat σ
  refine ⟨fun n v hv => ?_, hc.X_one hσ, hc.Y_one hσ, fun v => ?_⟩
  · have := hc.comp n v hv; rwa [hσ, Units.val_one, one_mul] at this
  · rw [hc.H v, hσ, Units.val_one, one_zsmul]

/-- **A morphism of `HC_λ(𝔤,K)_E`**: `L_E`-linear, commuting with `H`, `X`, `Y`, the grading and
**every** `σ ∈ G_E` (so it is the base change of a map of the forms).  @census none (helper) -/
structure Hom (A B : HC ℓ E D) where
  toLinearMap : A.carrier →ₗ[D.L] B.carrier
  map_H : ∀ v, toLinearMap (A.weight.H v) = B.weight.H (toLinearMap v)
  map_X : ∀ v, toLinearMap (A.weight.X v) = B.weight.X (toLinearMap v)
  map_Y : ∀ v, toLinearMap (A.weight.Y v) = B.weight.Y (toLinearMap v)
  map_comp : ∀ (n : ℤ) (v : A.carrier), v ∈ A.weight.comp n → toLinearMap v ∈ B.weight.comp n
  map_gal : ∀ σ v, toLinearMap (A.galAct σ v) = B.galAct σ (toLinearMap v)

@[ext] theorem Hom.ext' {A B : HC ℓ E D} {f g : Hom A B} (h : f.toLinearMap = g.toLinearMap) :
    f = g := by cases f; cases g; simp_all

/-- `HC_λ(𝔤,K)_E` is a category.  @census none (helper) -/
noncomputable instance instCategory : CategoryTheory.Category (HC ℓ E D) where
  Hom A B := Hom A B
  id A := ⟨LinearMap.id, fun _ => rfl, fun _ => rfl, fun _ => rfl, fun _ _ h => h,
    fun _ _ => rfl⟩
  comp f g :=
    ⟨g.toLinearMap.comp f.toLinearMap,
      fun v => by simp [f.map_H, g.map_H],
      fun v => by simp [f.map_X, g.map_X],
      fun v => by simp [f.map_Y, g.map_Y],
      fun n v hv => g.map_comp n _ (f.map_comp n v hv),
      fun σ v => by simp [f.map_gal, g.map_gal]⟩
  id_comp _ := by apply Hom.ext'; rfl
  comp_id _ := by apply Hom.ext'; rfl
  assoc _ _ _ := by apply Hom.ext'; rfl

@[simp] theorem id_toLinearMap (A : HC ℓ E D) : (𝟙 A : Hom A A).toLinearMap = LinearMap.id := rfl

@[simp] theorem comp_toLinearMap {A B C : HC ℓ E D} (f : A ⟶ B) (g : B ⟶ C) :
    (f ≫ g : Hom A C).toLinearMap = (g : Hom B C).toLinearMap.comp (f : Hom A B).toLinearMap :=
  rfl

/-! ### `E`-linear structure on the hom-spaces -/

namespace Hom

variable {A B : HC ℓ E D}

noncomputable instance : Zero (Hom A B) :=
  ⟨⟨0, fun _ => by simp, fun _ => by simp, fun _ => by simp, fun _ _ _ => Submodule.zero_mem _,
    fun _ _ => by simp⟩⟩

noncomputable instance : Add (Hom A B) :=
  ⟨fun f g => ⟨f.toLinearMap + g.toLinearMap,
    fun v => by simp [f.map_H, g.map_H], fun v => by simp [f.map_X, g.map_X],
    fun v => by simp [f.map_Y, g.map_Y],
    fun n v hv => Submodule.add_mem _ (f.map_comp n v hv) (g.map_comp n v hv),
    fun σ v => by simp [f.map_gal, g.map_gal]⟩⟩

noncomputable instance : Neg (Hom A B) :=
  ⟨fun f => ⟨-f.toLinearMap, fun v => by simp [f.map_H], fun v => by simp [f.map_X],
    fun v => by simp [f.map_Y], fun n v hv => Submodule.neg_mem _ (f.map_comp n v hv),
    fun σ v => by simp [f.map_gal]⟩⟩

noncomputable instance : Sub (Hom A B) :=
  ⟨fun f g => ⟨f.toLinearMap - g.toLinearMap,
    fun v => by simp [f.map_H, g.map_H], fun v => by simp [f.map_X, g.map_X],
    fun v => by simp [f.map_Y, g.map_Y],
    fun n v hv => Submodule.sub_mem _ (f.map_comp n v hv) (g.map_comp n v hv),
    fun σ v => by simp [f.map_gal, g.map_gal]⟩⟩

noncomputable instance : SMul ℕ (Hom A B) :=
  ⟨fun k f => ⟨k • f.toLinearMap, fun v => by simp [f.map_H], fun v => by simp [f.map_X],
    fun v => by simp [f.map_Y], fun n v hv => Submodule.smul_of_tower_mem _ k (f.map_comp n v hv),
    fun σ v => by simp [f.map_gal]⟩⟩

noncomputable instance : SMul ℤ (Hom A B) :=
  ⟨fun k f => ⟨k • f.toLinearMap, fun v => by simp [f.map_H], fun v => by simp [f.map_X],
    fun v => by simp [f.map_Y], fun n v hv => Submodule.smul_of_tower_mem _ k (f.map_comp n v hv),
    fun σ v => by simp [f.map_gal]⟩⟩

/-- `E` (not `L_E`) acts on the hom-spaces: `E`-scalars commute with every `σ ⊗ 1`.
@census none (helper) -/
noncomputable instance : SMul E (Hom A B) :=
  ⟨fun a f => ⟨algebraMap E D.L a • f.toLinearMap, fun v => by simp [f.map_H],
    fun v => by simp [f.map_X], fun v => by simp [f.map_Y],
    fun n v hv => Submodule.smul_mem _ _ (f.map_comp n v hv),
    fun σ v => by
      simp only [LinearMap.smul_apply, f.map_gal]
      exact (galActOf_algebraMap_smul _ σ a _).symm⟩⟩

@[simp] theorem zero_toLinearMap : (0 : Hom A B).toLinearMap = 0 := rfl
@[simp] theorem add_toLinearMap (f g : Hom A B) :
    (f + g).toLinearMap = f.toLinearMap + g.toLinearMap := rfl
@[simp] theorem neg_toLinearMap (f : Hom A B) : (-f).toLinearMap = -f.toLinearMap := rfl
@[simp] theorem sub_toLinearMap (f g : Hom A B) :
    (f - g).toLinearMap = f.toLinearMap - g.toLinearMap := rfl
@[simp] theorem nsmul_toLinearMap (k : ℕ) (f : Hom A B) : (k • f).toLinearMap = k • f.toLinearMap :=
  rfl
@[simp] theorem zsmul_toLinearMap (k : ℤ) (f : Hom A B) : (k • f).toLinearMap = k • f.toLinearMap :=
  rfl
@[simp] theorem smul_toLinearMap (a : E) (f : Hom A B) :
    (a • f).toLinearMap = algebraMap E D.L a • f.toLinearMap := rfl

theorem toLinearMap_injective : Function.Injective (Hom.toLinearMap : Hom A B → _) :=
  fun _ _ h => Hom.ext' h

noncomputable instance instAddCommGroup : AddCommGroup (Hom A B) :=
  toLinearMap_injective.addCommGroup _ rfl (fun _ _ => rfl) (fun _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl)

noncomputable instance instModule : Module E (Hom A B) where
  smul_add a f g := Hom.ext' (smul_add _ _ _)
  add_smul a b f := Hom.ext' (by simp [add_smul])
  mul_smul a b f := Hom.ext' (by simp [mul_smul])
  one_smul f := Hom.ext' (by simp)
  zero_smul f := Hom.ext' (by simp)
  smul_zero a := Hom.ext' (by simp)

end Hom

/-- `HC_λ(𝔤,K)_E` is **preadditive**.  @census none (helper) -/
noncomputable instance instPreadditive : Preadditive (HC ℓ E D) where
  homGroup A B := (inferInstance : AddCommGroup (Hom A B))
  add_comp _ _ _ _ _ _ := by apply Hom.ext'; exact LinearMap.comp_add _ _ _
  comp_add _ _ _ _ _ _ := by apply Hom.ext'; exact LinearMap.add_comp _ _ _

/-- `HC_λ(𝔤,K)_E` is **`E`-linear** (over `E`, not `L_E`: an `L_E`-scalar commutes with every `σ ⊗ 1`
only if it lies in `E`).
@census none (helper) -/
noncomputable instance instLinear : Linear E (HC ℓ E D) where
  homModule A B := (inferInstance : Module E (Hom A B))
  smul_comp _ _ _ r f g := by
    apply Hom.ext'; ext v
    exact map_smul (g : Hom _ _).toLinearMap (algebraMap E D.L r) ((f : Hom _ _).toLinearMap v)
  comp_smul _ _ _ _ _ _ := by apply Hom.ext'; ext _; rfl

/-! ### Base change to `L_E`, and the `|G_E| = 1` identification -/

variable (ℓ D) in
/-- **Base change** `HC_λ(𝔤,K)_E ⥤ HC_λ(𝔤,K)_{L_E}`, `M_E ↦ M_{L_E}`: forget the descent datum.
@census none (helper) -/
noncomputable def toLambda : HC ℓ E D ⥤ HCLambda.{0} ℓ D.L where
  obj A := ⟨⟨A.carrier, A.weight, A.gic, A.fg, A.admissible⟩, A.centralCharacter⟩
  map f := ObjectProperty.homMk ⟨(f : Hom _ _).toLinearMap, (f : Hom _ _).map_H,
    (f : Hom _ _).map_X, (f : Hom _ _).map_Y⟩
  map_id _ := rfl
  map_comp _ _ := rfl

theorem toLambda_faithful : (toLambda D ℓ).Faithful where
  map_injective {A B} f g h :=
    Hom.ext' (f := (f : Hom A B)) (g := (g : Hom A B)) (congrArg (fun k => k.hom.toLinearMap) h)

/-- For `√-1 ∈ E` the base change is **full**: `G_E = 1`, so every map of the base changes commutes
with the (trivial) Galois action.  @census none (helper) -/
theorem toLambda_full (h : ∃ a : E, a * a = -1) : (toLambda D ℓ).Full where
  map_surjective {A B} g := by
    refine ⟨(⟨g.hom.toLinearMap, g.hom.map_H, g.hom.map_X, g.hom.map_Y,
      fun n v hv => WeightData.map_comp_of_map_H _ _ g.hom.toLinearMap g.hom.map_H n v hv,
      fun σ v => ?_⟩ : Hom A B), rfl⟩
    rw [D.eq_one_of_sqrt h σ]
    show g.hom.toLinearMap (galActOf D A.baseChange 1 v) = galActOf D B.baseChange 1 _
    rw [galActOf_one, galActOf_one]
    rfl

section Split

/-- For `√-1 ∈ E` (`L_E = E`): an object of `HCLambda ℓ L_E` with its `E`-form = itself.
@census none (helper) -/
noncomputable def ofLambda (h : ∃ a : E, a * a = -1) (B : HCLambda.{0} ℓ D.L) : HC ℓ E D :=
  letI : Module E B.obj.carrier := Module.compHom B.obj.carrier (algebraMap E D.L)
  haveI : IsScalarTower E D.L B.obj.carrier :=
    ⟨fun a b v => by
      show (a • b) • v = algebraMap E D.L a • (b • v)
      rw [Algebra.smul_def, mul_smul]⟩
  let φ : (D.L ⊗[E] B.obj.carrier) →ₗ[D.L] B.obj.carrier := LinearMap.liftBaseChange D.L LinearMap.id
  have hφ : ∀ (a : D.L) (v : B.obj.carrier), φ (a ⊗ₜ[E] v) = a • v := fun a v => by
    simp [φ, LinearMap.liftBaseChange_tmul]
  have hone : ∀ x : D.L ⊗[E] B.obj.carrier, x = (1 : D.L) ⊗ₜ[E] φ x := by
    intro x
    induction x with
    | tmul a v =>
        obtain ⟨e, rfl⟩ := (D.algebraMap_bijective_of_sqrt h).2 a
        rw [hφ, show (algebraMap E D.L e • v) = e • v from rfl, TensorProduct.tmul_smul,
          TensorProduct.smul_tmul', Algebra.algebraMap_eq_smul_one]
    | add x y hx hy => rw [map_add, TensorProduct.tmul_add, ← hx, ← hy]
  { form := B.obj.carrier
    carrier := B.obj.carrier
    baseChange := LinearEquiv.ofBijective φ ⟨fun x y hxy => by rw [hone x, hone y, hxy],
      fun v => ⟨(1 : D.L) ⊗ₜ[E] v, by rw [hφ, one_smul]⟩⟩
    weight := B.obj.weight
    gic := B.obj.gic
    galCompat := fun σ => by
      rw [D.eq_one_of_sqrt h σ, D.chi_one]
      refine ⟨fun n v hv => ?_, fun v => ?_, fun _ v => ?_, fun _ v => ?_, fun h' => ?_,
        fun h' => ?_⟩
      · rw [galActOf_one]; simpa using hv
      · rw [galActOf_one, galActOf_one]; simp
      · rw [galActOf_one, galActOf_one]
      · rw [galActOf_one, galActOf_one]
      · exact absurd h' (by decide)
      · exact absurd h' (by decide)
    admissible := B.obj.admissible
    centralCharacter := B.property
    fg := B.obj.fg }

theorem toLambda_essSurj (h : ∃ a : E, a * a = -1) : (toLambda D ℓ).EssSurj where
  mem_essImage B := ⟨ofLambda h B, ⟨Iso.refl _⟩⟩

/-- **The `|G_E| = 1` identification**: for `√-1 ∈ E`, base change to `L_E = E` is
an equivalence `HC_λ(𝔤,K)_E ≌ HCLambda ℓ L_E`, the split-torus category of tex §5.1.
@census none (helper; the `√-1 ∈ E` case of `def:HClambdaE`, `RQ2-3.13-C3`) -/
noncomputable def lambdaEquiv (h : ∃ a : E, a * a = -1) : HC ℓ E D ≌ HCLambda.{0} ℓ D.L :=
  haveI := toLambda_faithful (ℓ := ℓ) (D := D)
  haveI := toLambda_full (ℓ := ℓ) (D := D) h
  haveI := toLambda_essSurj (D := D) (ℓ := ℓ) h
  haveI : (toLambda D ℓ).IsEquivalence := { }
  (toLambda D ℓ).asEquivalence

theorem lambdaEquiv_functor (h : ∃ a : E, a * a = -1) :
    (lambdaEquiv (D := D) (ℓ := ℓ) h).functor = toLambda D ℓ := rfl

end Split

end HC

/-! ### G5: a non-degenerate inhabitant over every `D` -/

/-- **G5 inhabitant of `HC`**: the `E`-form `E` of the one-dimensional module `L_E` in degree `0`,
an object of `HC_λ(𝔤,K)_E` at `ℓ = 1` for **every** `D : ImagUnit E` (both `√-1 ∈ E` and
`√-1 ∉ E`).  Non-degenerate: `M_E = E ≠ 0`, and its `σ`-action is `σ` itself, so for `√-1 ∉ E` the
compatibility is not vacuous.  @census none (G5 inhabitant) -/
noncomputable def HC.trivialHC : HC 1 E D where
  form := E
  carrier := D.L
  baseChange := TensorProduct.AlgebraTensorModule.rid E D.L D.L
  weight := trivialWeightData D.L D.L
  gic := ⟨1, by rw [pow_one, trivialWeightData_casimir]; simp⟩
  galCompat σ := by
    refine ⟨fun n v hv => ?_, fun v => ?_, fun _ v => ?_, fun _ v => ?_, fun _ v => ?_,
      fun _ v => ?_⟩
    · by_cases hn : n = 0
      · subst hn; rw [mul_zero]; exact mem_topAtZero_zero _
      · have hv' : v ∈ topAtZero D.L D.L n := hv
        rw [topAtZero_ne_zero hn, Submodule.mem_bot] at hv'
        subst hv'; rw [map_zero]; exact Submodule.zero_mem _
    all_goals
      show _ = _
      simp [trivialWeightData]
  admissible _ := inferInstance
  centralCharacter n hn := by
    have h0 : n ≠ 0 := by rintro rfl; simp at hn
    exact topAtZero_ne_zero h0
  fg := ⟨{1}, gkSpanOver_eq_top_of_span_eq_top _ (by
    rw [Finset.coe_singleton, eq_top_iff]; intro v _
    have : v = v • (1 : D.L) := by simp
    rw [this]; exact Submodule.smul_mem _ v (Submodule.subset_span rfl))⟩

/-- **G5 inhabitant of `HC.Hom`**: the identity of `trivialHC`.  @census none (G5 inhabitant) -/
noncomputable def HC.trivialHCHom : HC.Hom (HC.trivialHC D) (HC.trivialHC D) :=
  (𝟙 (HC.trivialHC D) : HC.trivialHC D ⟶ HC.trivialHC D)

theorem HC.trivialHC_form_nontrivial : Nontrivial (HC.trivialHC D).form :=
  inferInstanceAs (Nontrivial E)

/-- The **`σ`-action on `trivialHC`** is `σ` itself.  @census none (helper) -/
theorem HC.trivialHC_galAct (σ : D.L ≃ₐ[E] D.L) (v : D.L) :
    (HC.trivialHC D).galAct σ v = σ v := by
  show TensorProduct.AlgebraTensorModule.rid E D.L D.L
      (galoisTwist σ ((TensorProduct.AlgebraTensorModule.rid E D.L D.L).symm v)) = σ v
  have : (TensorProduct.AlgebraTensorModule.rid E D.L D.L).symm v = v ⊗ₜ[E] (1 : E) := rfl
  rw [this, galoisTwist_tmul, TensorProduct.AlgebraTensorModule.rid_tmul, one_smul]

end Descent

end RationalQuivers.HC
