module

public import RationalQuivers.HC.Graded
public import Mathlib.FieldTheory.Minpoly.Field
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.Algebra.Polynomial.Roots
public import Mathlib.Data.Int.Interval

@[expose] public section

/-!
# Finite generation of the submodules of a finitely generated admissible weight module

The mathematical content of clause `RQ-3.11-C4` (`HC(𝔤,K)` is abelian, `HC/Module.lean`, renamed
`HC/Classical.lean` at v2 WP-8, `d2a2a47`, which also holds `RQ-3.11-C4`'s
`harishChandraCatAbelian`; 2026-10-21 note, O-V2-6 round 2): the kernel of a morphism of
Harish-Chandra modules must again be **finitely generated**, i.e. a `(𝔤,K)`-submodule of a finitely
generated admissible module is finitely generated.  For a general reductive `𝔤` that is
Noetherianity of `U(𝔤)`, whose proof is PBW; mathlib has no PBW theorem at the `G0` pin (ledger
`MD-S7-08`), so the argument here is the `𝔰𝔩₂`-specific one, and it uses only what `§3.3`/`§3.4`
already supply.

Everything is stated on `WeightData` (`HC/Sl2.lean`) alone — no `SO(2)`-action — because a
homogeneous submodule is automatically stable under the `K`-action (`rep g` is the scalar `χ_n(g)`
on `M_n`), so the whole finiteness argument is about the `𝔤`-action and the grading.

## Main results

* `RationalQuivers.HC.WeightData.exists_annihilating_poly` — a finitely generated admissible
  weight module is `Z(𝔤)`-finite: `p(C) = 0` for some non-zero `p ∈ E[T]`.
* `RationalQuivers.HC.WeightData.exists_bound_of_annihilating` — the *bad set*
  `{m | p((m+1)²) = 0}` is bounded above and below.
* `RationalQuivers.HC.WeightData.exists_X_preimage` / `exists_Y_preimage` — off the bad set,
  `X : N_m → N_{m+2}` and `Y : N_{m+2} → N_m` are surjective for **every** homogeneous stable `N`.
* `RationalQuivers.HC.WeightData.exists_finite_generating_set` — the theorem: a homogeneous
  `H`/`X`/`Y`-stable submodule of a finitely generated admissible weight module is generated by a
  finite subset of itself.

## Implementation notes

**Where this departs from the hand-over memo** (`workflow/stages/S7/DESIGN-NOTES.md` §9.2, whose
programme is superseded by `PLAN.md` §7's dated block).  The memo proposed a generalized
`C`-eigenspace decomposition `M = ⊕_λ M^λ` followed by a filtration by `ker(C − λ)^i`, so that on
each subquotient `C` acts by the *scalar* `λ` and `4XY = C − k²` becomes the scalar `λ − k²`.
None of that is needed: what the wall analysis uses is only that `C − (m+1)²·1` is **injective**
on the finite-dimensional `M_m`, and injectivity fails exactly when `(m+1)²` is an eigenvalue of
`C` there, hence only for finitely many `m`.  Injective + finite-dimensional gives surjective on
every stable subspace, which is what turns `4XY = C − (m+1)²` into "`X` is onto `N_{m+2}`".
-/

universe u v

namespace RationalQuivers.HC

open Polynomial

variable {E : Type u} [Field E] {M : Type v} [AddCommGroup M] [Module E M]

namespace WeightData

/-! ## Polynomials in an operator: restriction, commutation, and the grading -/

/-- Evaluating a polynomial at the restriction of `f` to an invariant submodule is the restriction
of the evaluation.

@census none
-/
theorem aeval_restrict_coe {N : Submodule E M} (f : Module.End E M) (hf : ∀ x ∈ N, f x ∈ N)
    (p : Polynomial E) (x : N) :
    (((aeval (f.restrict hf)) p) x : M) = (aeval f) p (x : M) := by
  have hpow : ∀ (k : ℕ) (y : N), (((f.restrict hf) ^ k) y : M) = (f ^ k) (y : M) := by
    intro k y
    rw [Module.End.pow_restrict k hf, LinearMap.coe_restrict_apply]
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp only [map_add, LinearMap.add_apply, Submodule.coe_add, hp, hq]
  | monomial k c =>
      rw [aeval_monomial, aeval_monomial]
      simp only [Module.End.mul_apply, Module.algebraMap_end_apply, SetLike.val_smul, hpow]

/-- A polynomial in `A` commutes with everything `A` commutes with.

@census none
-/
theorem commute_aeval_left {A B : Module.End E M} (h : Commute A B) (p : Polynomial E) :
    Commute ((aeval A) p) B := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add]; exact hp.add_left hq
  | monomial k c =>
      rw [aeval_monomial]
      exact (Algebra.commute_algebraMap_left c B).mul_left (h.pow_left k)

/-- A polynomial in the Casimir preserves every homogeneous component.

@census none
-/
theorem aeval_casimir_mem_comp (W : WeightData E M) (p : Polynomial E) (n : ℤ) (v : M)
    (hv : v ∈ W.comp n) : ((aeval W.casimir) p) v ∈ W.comp n := by
  have hpow : ∀ k : ℕ, (W.casimir ^ k) v ∈ W.comp n := by
    intro k
    induction k with
    | zero => simpa using hv
    | succ k ih => rw [pow_succ']; exact W.casimir_mem_comp n _ ih
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add, LinearMap.add_apply]; exact add_mem hp hq
  | monomial k c =>
      rw [aeval_monomial]
      simp only [Module.End.mul_apply, Module.algebraMap_end_apply]
      exact Submodule.smul_mem _ _ (hpow k)

/-- The kernel of a polynomial in the Casimir is a homogeneous, `H`/`X`/`Y`-stable submodule.

@census none
-/
theorem opStable_ker_aeval_casimir (W : WeightData E M) (p : Polynomial E) :
    W.OpStable (LinearMap.ker ((aeval W.casimir) p)) := by
  have key : ∀ B : Module.End E M, Commute W.casimir B →
      ∀ v ∈ LinearMap.ker ((aeval W.casimir) p), B v ∈ LinearMap.ker ((aeval W.casimir) p) := by
    intro B hB v hv
    have h := congrArg (fun t : Module.End E M => t v) (commute_aeval_left hB p).eq
    simp only [Module.End.mul_apply] at h
    rw [LinearMap.mem_ker] at hv ⊢
    rw [h, hv, map_zero]
  exact ⟨key W.H W.casimir_commute_H, key W.X W.casimir_commute_X, key W.Y W.casimir_commute_Y⟩

theorem isHomog_ker_aeval_casimir (W : WeightData E M) (p : Polynomial E) :
    W.IsHomog (LinearMap.ker ((aeval W.casimir) p)) :=
  W.isHomog_ker_of_graded _ (fun n v hv => W.aeval_casimir_mem_comp p n v hv)

/-! ## `Z(𝔤)`-finiteness: a non-zero polynomial annihilates the Casimir -/

/-- A weight vector in a finite-dimensional component is annihilated by a non-zero polynomial in
the Casimir: `C` preserves `M_n`, and `Module.End E M_n` is a finite-dimensional `E`-algebra.

@census none
-/
theorem exists_annihilating_poly_of_mem_comp (W : WeightData E M) (n : ℤ)
    (hfd : FiniteDimensional E (W.comp n)) (v : M) (hv : v ∈ W.comp n) :
    ∃ q : Polynomial E, q ≠ 0 ∧ ((aeval W.casimir) q) v = 0 := by
  haveI := hfd
  set Cn : Module.End E (W.comp n) :=
    W.casimir.restrict (fun x hx => W.casimir_mem_comp n x hx) with hCn
  have hint : IsIntegral E Cn := IsIntegral.of_finite E Cn
  refine ⟨minpoly E Cn, minpoly.ne_zero hint, ?_⟩
  have h0 : (aeval Cn) (minpoly E Cn) = 0 := minpoly.aeval E Cn
  have hbr := aeval_restrict_coe (N := W.comp n) W.casimir
    (fun x hx => W.casimir_mem_comp n x hx) (minpoly E Cn) ⟨v, hv⟩
  rw [← hbr, ← hCn, h0]
  rfl

/-- **`p(C) = 0`.**  A weight module generated by finitely many weight vectors, all of whose
components are finite-dimensional, is `Z(𝔤)`-finite.

@census none
-/
theorem exists_annihilating_poly (W : WeightData E M)
    (hadm : ∀ n : ℤ, FiniteDimensional E (W.comp n))
    (T : Finset M) (hTw : ∀ v ∈ T, ∃ n : ℤ, v ∈ W.comp n)
    (hTgen : ∀ P : Submodule E M, (↑T : Set M) ⊆ (P : Set M) → W.OpStable P → W.IsHomog P →
      P = ⊤) :
    ∃ p : Polynomial E, p ≠ 0 ∧ ∀ v : M, ((aeval W.casimir) p) v = 0 := by
  classical
  have hq : ∀ t : M, ∃ q : Polynomial E, q ≠ 0 ∧ (t ∈ T → ((aeval W.casimir) q) t = 0) := by
    intro t
    by_cases ht : t ∈ T
    · obtain ⟨n, hn⟩ := hTw t ht
      obtain ⟨q, hq0, hq1⟩ := exists_annihilating_poly_of_mem_comp W n (hadm n) t hn
      exact ⟨q, hq0, fun _ => hq1⟩
    · exact ⟨1, one_ne_zero, fun h => absurd h ht⟩
  choose q hq0 hq1 using hq
  refine ⟨∏ t ∈ T, q t, Finset.prod_ne_zero_iff.mpr (fun t _ => hq0 t), ?_⟩
  have hker : (↑T : Set M) ⊆ ((LinearMap.ker ((aeval W.casimir) (∏ t ∈ T, q t))) : Set M) := by
    intro t ht
    simp only [Finset.mem_coe] at ht
    rw [SetLike.mem_coe, LinearMap.mem_ker, ← Finset.prod_erase_mul T q ht, map_mul]
    simp only [Module.End.mul_apply]
    rw [hq1 t ht, map_zero]
  have htop := hTgen _ hker (W.opStable_ker_aeval_casimir _) (W.isHomog_ker_aeval_casimir _)
  intro v
  have hv : v ∈ LinearMap.ker ((aeval W.casimir) (∏ t ∈ T, q t)) := by rw [htop]; trivial
  exact hv

/-! ## The bad set of degrees is bounded -/

/-- On an eigenvector, a polynomial in the operator is the scalar `p(c)`.

@census none
-/
theorem aeval_apply_of_eigen (A : Module.End E M) (c : E) (v : M) (h : A v = c • v)
    (p : Polynomial E) : ((aeval A) p) v = (p.eval c) • v := by
  have hpow : ∀ k : ℕ, (A ^ k) v = (c ^ k) • v := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => rw [pow_succ', Module.End.mul_apply, ih, map_smul, h, smul_smul, ← pow_succ]
  induction p using Polynomial.induction_on' with
  | add p r hp hr => rw [map_add, LinearMap.add_apply, hp, hr, eval_add, add_smul]
  | monomial k a =>
      rw [aeval_monomial, eval_monomial]
      simp only [Module.End.mul_apply, Module.algebraMap_end_apply, hpow, smul_smul]

section CharZero

variable [CharZero E]

/-- The degrees `m` at which `(m+1)²` is a root of `p` form a bounded set of integers: they are the
preimage of the (finite) root set of `p ∘ T²` under the injective `m ↦ (m+1 : E)`.

@census none
-/
theorem exists_bound_of_ne_zero (p : Polynomial E) (hp : p ≠ 0) :
    ∃ a b : ℤ, ∀ m : ℤ, p.eval ((((m + 1 : ℤ)) : E) ^ 2) = 0 → a ≤ m ∧ m ≤ b := by
  classical
  set q : Polynomial E := p.comp ((Polynomial.X : Polynomial E) ^ 2) with hqdef
  have hq : q ≠ 0 := by
    have hdeg : ((Polynomial.X : Polynomial E) ^ 2).natDegree ≠ 0 := by
      rw [natDegree_pow, natDegree_X]; norm_num
    have hlc : q.leadingCoeff = p.leadingCoeff := by
      rw [hqdef, leadingCoeff_comp hdeg, leadingCoeff_pow, leadingCoeff_X]
      simp
    intro h
    rw [h] at hlc
    exact hp (leadingCoeff_eq_zero.mp (by simpa using hlc.symm))
  have hfin : {x : E | q.IsRoot x}.Finite := Polynomial.finite_setOf_isRoot hq
  set f : ℤ → E := fun m => (((m + 1 : ℤ)) : E) with hf
  have hinj : Function.Injective f := by
    intro m₁ m₂ h
    have : ((m₁ + 1 : ℤ) : E) = ((m₂ + 1 : ℤ) : E) := h
    have := (Int.cast_injective (α := E)) this
    omega
  have hpre : (f ⁻¹' {x : E | q.IsRoot x}).Finite :=
    Set.Finite.preimage (Set.injOn_of_injective hinj) hfin
  have hsub : {m : ℤ | p.eval ((((m + 1 : ℤ)) : E) ^ 2) = 0} ⊆ f ⁻¹' {x : E | q.IsRoot x} := by
    intro m hm
    show q.IsRoot (f m)
    rw [IsRoot, hqdef, eval_comp]
    simpa [hf, eval_pow, eval_X] using hm
  have hbfin : {m : ℤ | p.eval ((((m + 1 : ℤ)) : E) ^ 2) = 0}.Finite := hpre.subset hsub
  obtain ⟨b, hb⟩ := hbfin.bddAbove
  obtain ⟨a, ha⟩ := hbfin.bddBelow
  exact ⟨a, b, fun m hm => ⟨ha hm, hb hm⟩⟩

end CharZero

/-! ## Off the bad set, `X` and `Y` are onto between consecutive slices -/

theorem OpStable.casimir_mem {W : WeightData E M} {N : Submodule E M} (hst : W.OpStable N)
    (v : M) (hv : v ∈ N) : W.casimir v ∈ N := by
  rw [W.casimir_apply v]
  exact add_mem (add_mem (sub_mem (hst.1 _ (hst.1 v hv)) (Submodule.smul_mem _ _ (hst.1 v hv)))
    (Submodule.smul_mem _ _ (hst.2.1 _ (hst.2.2 v hv)))) hv

/-- If a non-zero `p` annihilates `C` and `p(c) ≠ 0`, then `C − c` is injective.

@census none
-/
theorem eq_zero_of_casimir_eq_smul (W : WeightData E M) (p : Polynomial E)
    (hp0 : ∀ v : M, ((aeval W.casimir) p) v = 0) (c : E) (hc : p.eval c ≠ 0) (v : M)
    (h : W.casimir v = c • v) : v = 0 := by
  have hev := aeval_apply_of_eigen W.casimir c v h p
  rw [hp0 v] at hev
  exact (smul_eq_zero.mp hev.symm).resolve_left hc

/-- **The one finiteness step.**  If `C − c` is injective on `M_k` then, on the
finite-dimensional `N ⊓ M_k`, it is onto: every `w ∈ N ⊓ M_k` is `C x − c·x` for some
`x ∈ N ⊓ M_k`.

@census none
-/
theorem exists_casimir_sub_preimage (W : WeightData E M) {k : ℤ}
    (hfd : FiniteDimensional E (W.comp k)) {N : Submodule E M} (hst : W.OpStable N) (c : E)
    (hinj : ∀ v : M, v ∈ W.comp k → W.casimir v = c • v → v = 0)
    (w : M) (hwN : w ∈ N) (hwc : w ∈ W.comp k) :
    ∃ x : M, x ∈ N ∧ x ∈ W.comp k ∧ W.casimir x - c • x = w := by
  haveI := hfd
  set V : Submodule E M := W.comp k ⊓ N with hV
  haveI : FiniteDimensional E V := Submodule.finiteDimensional_inf_left _ _
  set D : Module.End E M := W.casimir - c • (1 : Module.End E M) with hD
  have hDapply : ∀ y : M, D y = W.casimir y - c • y := by
    intro y
    simp [hD]
  have hDV : ∀ x ∈ V, D x ∈ V := by
    intro x hx
    rw [hDapply]
    exact ⟨sub_mem (W.casimir_mem_comp _ _ hx.1) (Submodule.smul_mem _ _ hx.1),
      sub_mem (hst.casimir_mem _ hx.2) (Submodule.smul_mem _ _ hx.2)⟩
  have hDrinj : Function.Injective (D.restrict hDV) := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx0
    have h1 : D (x : M) = 0 := by
      have h2 := LinearMap.mem_ker.mp hx0
      have h3 := congrArg (fun z : V => (z : M)) h2
      simpa [LinearMap.coe_restrict_apply] using h3
    rw [hDapply, sub_eq_zero] at h1
    exact Subtype.ext (hinj (x : M) x.2.1 h1)
  obtain ⟨x, hx⟩ := (LinearMap.injective_iff_surjective).mp hDrinj ⟨w, hwc, hwN⟩
  refine ⟨(x : M), x.2.2, x.2.1, ?_⟩
  have h4 := congrArg (fun z : V => (z : M)) hx
  simpa [LinearMap.coe_restrict_apply, hDapply] using h4

/-- Off the bad set, `X : N ⊓ M_m → N ⊓ M_{m+2}` is onto: `4XY = C − (m+1)²` on `M_{m+2}`.

@census none
-/
theorem exists_X_preimage (W : WeightData E M) (hadm : ∀ n : ℤ, FiniteDimensional E (W.comp n))
    {N : Submodule E M} (hst : W.OpStable N) (m : ℤ) (c : E) (hcv : c = ((m + 1 : ℤ) : E) ^ 2)
    (hinj : ∀ v : M, v ∈ W.comp (m + 2) → W.casimir v = c • v → v = 0)
    (w : M) (hwN : w ∈ N) (hwc : w ∈ W.comp (m + 2)) :
    ∃ u : M, u ∈ N ∧ u ∈ W.comp m ∧ W.X u = w := by
  obtain ⟨x, hxN, hxc, hxD⟩ :=
    exists_casimir_sub_preimage W (hadm (m + 2)) hst c hinj w hwN hwc
  have hxc' : x ∈ W.comp ((m + 1) + 1) := by rwa [show (m + 1) + 1 = m + 2 by ring]
  have hfour := W.four_X_Y_apply (m + 1) x hxc'
  refine ⟨(4 : E) • W.Y x, Submodule.smul_mem _ _ (hst.2.2 x hxN), ?_, ?_⟩
  · have hy := W.Y_mem (m + 2) x hxc
    rw [show m + 2 - 2 = m by ring] at hy
    exact Submodule.smul_mem _ _ hy
  · rw [map_smul, hfour, ← hcv, hxD]

/-- Off the bad set, `Y : N ⊓ M_{m+2} → N ⊓ M_m` is onto: `4YX = C − (m+1)²` on `M_m`.

@census none
-/
theorem exists_Y_preimage (W : WeightData E M) (hadm : ∀ n : ℤ, FiniteDimensional E (W.comp n))
    {N : Submodule E M} (hst : W.OpStable N) (m : ℤ) (c : E) (hcv : c = ((m + 1 : ℤ) : E) ^ 2)
    (hinj : ∀ v : M, v ∈ W.comp m → W.casimir v = c • v → v = 0)
    (w : M) (hwN : w ∈ N) (hwc : w ∈ W.comp m) :
    ∃ u : M, u ∈ N ∧ u ∈ W.comp (m + 2) ∧ W.Y u = w := by
  obtain ⟨x, hxN, hxc, hxD⟩ := exists_casimir_sub_preimage W (hadm m) hst c hinj w hwN hwc
  have hxc' : x ∈ W.comp (-((-m - 1) + 1)) := by rwa [show -((-m - 1) + 1) = m by ring]
  have hfour := W.four_Y_X_apply (-m - 1) x hxc'
  have hcast : (((-m - 1 : ℤ)) : E) ^ 2 = c := by rw [hcv]; push_cast; ring
  rw [hcast] at hfour
  refine ⟨(4 : E) • W.X x, Submodule.smul_mem _ _ (hst.2.1 x hxN), ?_, ?_⟩
  · exact Submodule.smul_mem _ _ (W.X_mem m x hxc)
  · rw [map_smul, hfour, hxD]

/-! ## The theorem: a homogeneous stable submodule is finitely generated -/

/-- **Every homogeneous, `H`/`X`/`Y`-stable submodule `N` of a finitely generated admissible
weight module is finitely generated**: there is a finite `S ⊆ N` such that every stable submodule
containing `S` contains `N`.

This is the finiteness that clause `RQ-3.11-C4` needs for kernels (`HC/Module.lean`, since v2
WP-8 `HC/Classical.lean`), and the
place where "no PBW at the pin" (`MD-S7-08`) is paid for by an `𝔰𝔩₂`-specific argument: `p(C) = 0`
bounds the degrees at which `C − (m+1)²` can fail to be injective, and off those degrees `X` and
`Y` move `N`'s slices onto one another, so the finitely many slices in the resulting window
generate.

@census none
-/
theorem exists_finite_generating_set [CharZero E] (W : WeightData E M)
    (hadm : ∀ n : ℤ, FiniteDimensional E (W.comp n))
    (T : Finset M) (hTw : ∀ v ∈ T, ∃ n : ℤ, v ∈ W.comp n)
    (hTgen : ∀ P : Submodule E M, (↑T : Set M) ⊆ (P : Set M) → W.OpStable P → W.IsHomog P →
      P = ⊤)
    (N : Submodule E M) (hst : W.OpStable N) (hhom : W.IsHomog N) :
    ∃ S : Finset M, (↑S : Set M) ⊆ (N : Set M) ∧
      ∀ P : Submodule E M, (↑S : Set M) ⊆ (P : Set M) → W.OpStable P → N ≤ P := by
  classical
  obtain ⟨p, hp, hp0⟩ := exists_annihilating_poly W hadm T hTw hTgen
  obtain ⟨a, b, hab⟩ := exists_bound_of_ne_zero p hp
  set a' : ℤ := min a (b + 1) with ha'
  have hgood : ∀ m : ℤ, (m < a' ∨ b < m) → p.eval (((m + 1 : ℤ) : E) ^ 2) ≠ 0 := by
    intro m hm h
    obtain ⟨h1, h2⟩ := hab m h
    rcases hm with hm | hm <;> omega
  have hinj : ∀ m : ℤ, (m < a' ∨ b < m) → ∀ v : M,
      W.casimir v = (((m + 1 : ℤ) : E) ^ 2) • v → v = 0 :=
    fun m hm v h => eq_zero_of_casimir_eq_smul W p hp0 _ (hgood m hm) v h
  -- a finite spanning set for each slice `M_n ⊓ N`
  have hFG : ∀ n : ℤ, ∃ Sn : Finset M, (↑Sn : Set M) ⊆ ((W.comp n ⊓ N : Submodule E M) : Set M) ∧
      W.comp n ⊓ N ≤ Submodule.span E (↑Sn : Set M) := by
    intro n
    haveI := hadm n
    haveI : FiniteDimensional E (W.comp n ⊓ N : Submodule E M) :=
      Submodule.finiteDimensional_inf_left _ _
    obtain ⟨Sn, hSn⟩ := (Module.Finite.iff_fg (N := W.comp n ⊓ N)).mp inferInstance
    exact ⟨Sn, by rw [← hSn]; exact Submodule.subset_span, by rw [hSn]⟩
  choose Sn hSn1 hSn2 using hFG
  refine ⟨(Finset.Icc a' (b + 2)).biUnion Sn, ?_, ?_⟩
  · intro x hx
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe] at hx
    obtain ⟨n, -, hxn⟩ := hx
    have hxm := hSn1 n hxn
    rw [SetLike.mem_coe, Submodule.mem_inf] at hxm
    exact hxm.2
  intro P hSP hP
  have hwin : ∀ n : ℤ, n ∈ Finset.Icc a' (b + 2) → W.comp n ⊓ N ≤ P := by
    intro n hn
    refine le_trans (hSn2 n) (Submodule.span_le.mpr fun x hx => ?_)
    refine hSP ?_
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe]
    exact ⟨n, hn, hx⟩
  -- upwards from the window, by `X`
  have hup : ∀ j : ℕ, ∀ n : ℤ, a' ≤ n → n ≤ b + 2 + j → W.comp n ⊓ N ≤ P := by
    intro j
    induction j using Nat.strong_induction_on with
    | _ j ih =>
      intro n hn1 hn2
      by_cases hw : n ≤ b + 2
      · exact hwin n (Finset.mem_Icc.mpr ⟨hn1, hw⟩)
      · rw [not_le] at hw
        have hj : 1 ≤ j := by omega
        have hprev : W.comp (n - 2) ⊓ N ≤ P :=
          ih (j - 1) (by omega) (n - 2) (by omega) (by omega)
        intro w hwmem
        rw [Submodule.mem_inf] at hwmem
        have hwc : w ∈ W.comp ((n - 2) + 2) := by
          rw [show n - 2 + 2 = n by ring]; exact hwmem.1
        obtain ⟨u, huN, huc, huX⟩ :=
          exists_X_preimage W hadm hst (n - 2) _ rfl
            (fun v _ h => hinj (n - 2) (Or.inr (by omega)) v h) w hwmem.2 hwc
        rw [← huX]
        exact hP.2.1 u (hprev ⟨huc, huN⟩)
  -- downwards from the window, by `Y`
  have hdown : ∀ j : ℕ, ∀ n : ℤ, n ≤ b + 2 → a' - j ≤ n → W.comp n ⊓ N ≤ P := by
    intro j
    induction j using Nat.strong_induction_on with
    | _ j ih =>
      intro n hn1 hn2
      by_cases hw : a' ≤ n
      · exact hwin n (Finset.mem_Icc.mpr ⟨hw, hn1⟩)
      · rw [not_le] at hw
        have hj : 1 ≤ j := by omega
        have hnext : W.comp (n + 2) ⊓ N ≤ P :=
          ih (j - 1) (by omega) (n + 2) (by omega) (by omega)
        intro w hwmem
        rw [Submodule.mem_inf] at hwmem
        obtain ⟨u, huN, huc, huY⟩ :=
          exists_Y_preimage W hadm hst n _ rfl
            (fun v _ h => hinj n (Or.inl (by omega)) v h) w hwmem.2 hwmem.1
        rw [← huY]
        exact hP.2.2 u (hnext ⟨huc, huN⟩)
  refine hhom.le_of_inf_comp_le fun n => ?_
  by_cases hn : a' ≤ n
  · exact hup (n - (b + 2)).toNat n hn (by omega)
  · rw [not_le] at hn
    have hle : n ≤ b + 2 := by omega
    exact hdown (a' - n).toNat n hle (by omega)

end WeightData

end RationalQuivers.HC
